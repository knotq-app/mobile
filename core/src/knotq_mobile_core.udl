namespace knotq_mobile_core {};

[Error]
interface MobileError {
  Core(string reason);
};

dictionary MobileSnapshot {
  MobileNode root;
  sequence<MobileScheme> schemes;
  sequence<MobileScheme> archived_schemes;
  sequence<MobileNode> archived_nodes;
  sequence<MobileDailyEntry> daily;
  MobileCalendar calendar;
  MobileSettings settings;
  string workspace_path;
};

dictionary MobileNode {
  string kind;
  string id;
  string name;
  i32? color_index;
  boolean is_daily_queue;
  boolean is_read_only;
  sequence<MobileNode> children;
};

dictionary MobileScheme {
  string id;
  string name;
  string display_name;
  i32 color_index;
  boolean is_daily_queue;
  boolean is_read_only;
  string? date;
  sequence<MobileItem> items;
};

dictionary MobileItem {
  string id;
  string text;
  string marker;
  i32 indent;
  string kind;
  boolean done;
  string? start;
  string? end;
  i32? notification_offset_secs;
  string? repeat_rule;
  sequence<MobileItemMedia> media;
  sequence<MobileTable> tables;
  // Ordered inline content for the line (text/image/table in document order).
  // Source of truth for editor rendering; the flat `text`/`media`/`tables`
  // fields above remain for non-editor consumers (widgets/timeline).
  sequence<MobileInline> content;
};

// One piece of a line's content, in document order. Mirrors the Rust
// `knotq_model::Inline` enum.
[Enum]
interface MobileInline {
  Text(string text);
  Image(MobileItemMedia media);
  Table(MobileTable table);
};

dictionary MobileItemMedia {
  string kind;
  string? path;
  string format;
  i32? width;
  i32? height;
};

dictionary MobileTable {
  sequence<MobileTableColumn> columns;
  sequence<MobileTableRow> rows;
};

dictionary MobileTableColumn {
  string id;
  string name;
};

dictionary MobileTableRow {
  string id;
  sequence<MobileTableCell> cells;
};

// A table cell is a sub-document of line items. `lines` carries each line for
// inline per-cell rendering & editing; `text` is a flat one-line summary kept
// for read-only consumers.
dictionary MobileTableCell {
  string text;
  sequence<MobileCellLine> lines;
};

// A single line within a table cell. Flat / non-recursive on purpose (no
// MobileItem/MobileInline) to avoid UniFFI recursive-record issues. Carries the
// subset of fields the cell renderer shows: text + marker + done + date range,
// plus any inline images on the line.
dictionary MobileCellLine {
  string id;
  string text;
  string marker;
  boolean done;
  string? start;
  string? end;
  sequence<MobileItemMedia> media;
};

dictionary MobileItemEdit {
  string? id;
  string text;
  string marker;
  i32 indent;
  boolean done;
  string? start;
  string? end;
  i32? notification_offset_secs;
  string? repeat_rule;
  sequence<MobileItemMedia> media;
};

dictionary MobileDailyEntry {
  string date;
  MobileScheme scheme;
};

dictionary MobileCalendar {
  string start_date;
  string end_date;
  sequence<MobileCalendarDay> days;
  sequence<MobileOccurrence> upcoming;
  sequence<MobileOccurrence> overdue;
};

dictionary MobileCalendarDay {
  string date;
  sequence<MobileOccurrence> occurrences;
};

dictionary MobileOccurrence {
  string scheme_id;
  string item_id;
  string occurrence_json;
  i32 occurrence_index;
  boolean is_recurring;
  boolean can_delete_future;
  string scheme_name;
  i32 color_index;
  boolean is_read_only;
  string title;
  string kind;
  boolean done;
  string? start;
  string? end;
  i32? notification_offset_secs;
  string? local_date;
  string? repeat_rule;
};

dictionary MobileGoogleAccount {
  string id;
  string title;
  string detail;
};

dictionary MobileSettings {
  string theme_mode;
  string time_format;
  i32 event_notification_offset_secs;
  i32 assignment_notification_offset_secs;
  i32 google_account_count;
  sequence<MobileGoogleAccount> google_accounts;
};

dictionary MobileGoogleAuthRequest {
  string auth_url;
  string state;
  string code_verifier;
  string redirect_uri;
  string scope;
  string client_id;
};

dictionary MobileGoogleSyncResult {
  i32 imported_count;
  i32 synced_count;
  i32 failure_count;
  string message;
};

dictionary MobileNotificationRequest {
  string id;
  string notification_key;
  string fire_at;
  string? expires_at;
  string title;
  string body;
  string kind;
  string scheme_id;
  string item_id;
  string occurrence_json;
  string trigger_at;
};

dictionary MobileSearchHit {
  string target_kind;
  string? scheme_id;
  string? item_id;
  string scheme_name;
  i32? color_index;
  string title;
  string detail;
  string status;
};

interface MobileCore {
  [Throws=MobileError]
  constructor(string app_dir);

  [Throws=MobileError]
  MobileSnapshot snapshot(string? today, i32 week_offset);

  [Throws=MobileError]
  MobileSnapshot snapshot_with_daily_history(string? today, i32 week_offset, i32 daily_history_days);

  [Throws=MobileError]
  sequence<MobileCalendarDay> month_days(i32 year, u32 month);

  [Throws=MobileError]
  sequence<MobileSearchHit> search(string query);

  [Throws=MobileError]
  void create_folder(string? parent_id, string name, i32? position);

  [Throws=MobileError]
  void rename_folder(string folder_id, string name);

  [Throws=MobileError]
  void delete_folder(string folder_id);

  [Throws=MobileError]
  void create_scheme(string? folder_id, string name, i32? color_index, i32? position);

  [Throws=MobileError]
  void rename_scheme(string scheme_id, string name);

  [Throws=MobileError]
  void set_scheme_color(string scheme_id, i32 color_index);

  [Throws=MobileError]
  void delete_scheme(string scheme_id);

  [Throws=MobileError]
  void restore_scheme(string scheme_id);

  [Throws=MobileError]
  void permanently_delete_scheme(string scheme_id);

  [Throws=MobileError]
  void restore_folder(string folder_id);

  [Throws=MobileError]
  void permanently_delete_folder(string folder_id);

  [Throws=MobileError]
  void empty_archive();

  [Throws=MobileError]
  void move_node(string kind, string id, string folder_id, i32 position);

  [Throws=MobileError]
  void ensure_daily_queue(string? date);

  [Throws=MobileError]
  MobileGoogleAuthRequest google_auth_request(string client_id, string redirect_uri);

  [Throws=MobileError]
  MobileGoogleSyncResult complete_google_calendar_import(string client_id, string redirect_uri, string state, string code_verifier, string callback_url, string? parent_id);

  [Throws=MobileError]
  MobileGoogleSyncResult sync_google_calendars();

  [Throws=MobileError]
  void unlink_google_account(string account_id);

  [Throws=MobileError]
  void add_item(string scheme_id, string text, string? marker, i32? position, i32? indent);

  [Throws=MobileError]
  void add_today_daily_item(string today, string text, string? marker, i32? indent);

  [Throws=MobileError]
  void add_calendar_item(string? scheme_id, string? date, string text, string kind, string? start, string? end);

  [Throws=MobileError]
  void update_item_text(string scheme_id, string item_id, string text);

  [Throws=MobileError]
  void insert_table(string scheme_id, string? after_item_id);

  [Throws=MobileError]
  void set_table_cell_text(string scheme_id, string item_id, i32 row, i32 column, string text);

  [Throws=MobileError]
  void set_table_cell_line_text(string scheme_id, string item_id, i32 row, i32 column, i32 line_index, string text);

  [Throws=MobileError]
  void add_table_cell_line(string scheme_id, string item_id, i32 row, i32 column, i32 line_index, string text);

  [Throws=MobileError]
  void remove_table_cell_line(string scheme_id, string item_id, i32 row, i32 column, i32 line_index);

  [Throws=MobileError]
  void insert_table_row(string scheme_id, string item_id, i32 row);

  [Throws=MobileError]
  void delete_table_row(string scheme_id, string item_id, i32 row);

  [Throws=MobileError]
  void insert_table_column(string scheme_id, string item_id, i32 column);

  [Throws=MobileError]
  void delete_table_column(string scheme_id, string item_id, i32 column);

  [Throws=MobileError]
  void set_item_marker(string scheme_id, string item_id, string marker);

  [Throws=MobileError]
  void set_item_indent(string scheme_id, string item_id, i32 indent);

  [Throws=MobileError]
  void set_item_date(string scheme_id, string item_id, string kind, string? date);

  [Throws=MobileError]
  void set_item_recurrence(string scheme_id, string item_id, string? rrule);

  [Throws=MobileError]
  void set_occurrence_notification_offset(string scheme_id, string item_id, string? occurrence_json, i32? offset_secs);

  [Throws=MobileError]
  void commit_event_edit(string scheme_id, string item_id, string occurrence_json, i32 occurrence_index, string title, string? occurrence_start, string? occurrence_end, string? start, string? end, string? rrule, i32? notification_offset_secs, boolean notification_dirty, boolean done, string scope);

  // Same operation with one JSON argument. Android's JNA bridge corrupts the
  // trailing scalar args of the 14-argument form (libffi struct-by-value spill
  // bug), so the Kotlin side calls this variant instead.
  [Throws=MobileError]
  void commit_event_edit_payload(string payload);

  [Throws=MobileError]
  void toggle_item(string scheme_id, string item_id);

  [Throws=MobileError]
  void toggle_occurrence(string scheme_id, string item_id, string occurrence_json);

  [Throws=MobileError]
  void delete_item(string scheme_id, string item_id);

  [Throws=MobileError]
  void move_item_to_scheme(string source_scheme_id, string target_scheme_id, string item_id);

  [Throws=MobileError]
  void delete_event_occurrence(string scheme_id, string item_id, string occurrence_json, i32 occurrence_index, string scope);

  [Throws=MobileError]
  void reorder_item(string scheme_id, i32 from, i32 to);

  [Throws=MobileError]
  void replace_scheme_items(string scheme_id, sequence<MobileItemEdit> items);

  [Throws=MobileError]
  void set_theme_mode(string theme_mode);

  [Throws=MobileError]
  void set_time_format(string time_format);

  [Throws=MobileError]
  void set_notification_defaults(i32 event_offset_secs, i32 assignment_offset_secs);

  [Throws=MobileError]
  void reset_workspace();

  [Throws=MobileError]
  sequence<MobileNotificationRequest> pending_notifications(string? now, i32 horizon_days);

  [Throws=MobileError]
  boolean apply_notification_action(string action_id, string scheme_id, string item_id, string occurrence_json, string trigger_at);

  [Throws=MobileError]
  boolean sync_once(string api_base, string bearer_token);

  [Throws=MobileError]
  string? take_sync_notice();

  [Throws=MobileError]
  void set_push_registration(string token, string environment);

  [Throws=MobileError]
  void seed_editor_image_fixture();
};
