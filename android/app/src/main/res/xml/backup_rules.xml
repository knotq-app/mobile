<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy Auto Backup rules for Android 11 and below (API <= 30). Excludes the
  "knotq" SharedPreferences file, which holds sync auth/refresh tokens and Google
  Calendar OAuth tokens in plaintext, from cloud backup. The Android 12+ equivalent
  lives in data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="knotq.xml" />
</full-backup-content>
