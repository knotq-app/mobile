<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#0F1117</item>
        <item name="android:navigationBarColor">#0F1117</item>
        <item name="android:colorAccent">#42A5F5</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- OS splash screen (Android 12+, back-ported by core-splashscreen on
         older versions). Matches UiTheme.light.bgApp (0xfafbf9), the app's own
         default theme, so the system splash reads as the SAME screen as the
         "Loading workspace..." shell it hands off to rather than a visibly
         different one flashing first. See values-night for the dark match.
         MainActivity holds this splash on screen (setKeepOnScreenCondition)
         until the workspace is ready, so the custom loading shell underneath
         is only ever seen on an unusually slow cold start. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FAFBF9</item>
        <item name="windowSplashScreenAnimationDuration">1</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

    <!-- Compact wheel (spinner) widget styles so time/date pickers feel like the
         iOS inline wheels rather than the multi-tap clock/calendar dialogs. -->
    <style name="KnotQSpinnerTimePicker" parent="@android:style/Widget.Material.TimePicker">
        <item name="android:timePickerMode">spinner</item>
    </style>
    <style name="KnotQSpinnerDatePicker" parent="@android:style/Widget.Material.DatePicker">
        <item name="android:datePickerMode">spinner</item>
    </style>

    <!-- Dialog themes for TimePickerDialog (wheel mode), tinted per app theme. -->
    <style name="KnotQTimeDialogDark" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:timePickerStyle">@style/KnotQSpinnerTimePicker</item>
        <item name="android:colorAccent">#7AA0FF</item>
    </style>
    <style name="KnotQTimeDialogLight" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:timePickerStyle">@style/KnotQSpinnerTimePicker</item>
        <item name="android:colorAccent">#C04510</item>
    </style>

    <!-- Dialog themes for DatePickerDialog (graphical calendar, like iOS), tinted. -->
    <style name="KnotQDateDialogDark" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#7AA0FF</item>
    </style>
    <style name="KnotQDateDialogLight" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#C04510</item>
    </style>

    <!-- AlertDialog themes for custom-view dialogs, tinted per app theme so the
         dialog chrome matches the in-app light/dark theme instead of always using
         the dark AppTheme. Without this, light-theme body text (a dark color) lands
         on a dark dialog background and is unreadable. -->
    <style name="KnotQAlertDialogDark" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#7AA0FF</item>
    </style>
    <style name="KnotQAlertDialogLight" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#C04510</item>
    </style>

    <!-- ContextThemeWrapper themes for inline (embedded) wheel pickers. -->
    <style name="KnotQInlinePickerDark" parent="@android:style/Theme.Material">
        <item name="android:datePickerStyle">@style/KnotQSpinnerDatePicker</item>
        <item name="android:timePickerStyle">@style/KnotQSpinnerTimePicker</item>
        <item name="android:colorAccent">#7AA0FF</item>
    </style>
    <style name="KnotQInlinePickerLight" parent="@android:style/Theme.Material.Light">
        <item name="android:datePickerStyle">@style/KnotQSpinnerDatePicker</item>
        <item name="android:timePickerStyle">@style/KnotQSpinnerTimePicker</item>
        <item name="android:colorAccent">#C04510</item>
    </style>
</resources>
