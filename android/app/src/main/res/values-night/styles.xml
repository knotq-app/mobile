<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-system-mode match for Theme.App.Starting (see values/styles.xml).
         UiTheme.dark.bgApp is pure black; this is only an approximation of
         whichever KnotQ theme the user actually has selected (that choice
         lives in SharedPreferences and isn't knowable at splash-theme
         resolution time), but it is a much closer first frame for anyone in
         system dark mode than the previous unstyled default. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#000000</item>
        <item name="windowSplashScreenAnimationDuration">1</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
