    "settings.google_calendar.unlink_confirm_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتوقف KnotQ عن تحديث التقاويم لـ {name}. تبقى مخططات التقويم المستوردة في مساحة العمل الخاصة بك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ přestane aktualizovat kalendáře pro {name}. Importovaná schéma kalendáře zůstanou ve vašem pracovním prostoru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ stopper med at opdatere kalendere for {name}. Importerede kalenderskemaer forbliver i dit arbejdsområde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ stellt die Aktualisierung der Kalender für {name} ein. Importierte Kalender-Schemata bleiben in Ihrem Arbeitsbereich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το KnotQ θα σταματήσει να ανανεώνει τα ημερολόγια για {name}. Τα εισαγόμενα σχέδια ημερολογίου παραμένουν στον χώρο εργασίας σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ will stop refreshing calendars for {name}. Imported calendar schemes stay in your workspace."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ dejará de actualizar los calendarios para {name}. Los esquemas de calendario importados permanecen en tu espacio de trabajo."
