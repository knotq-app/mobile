        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι εφαρμογές για κινητά είναι σε εξέλιξη — σύντομα θα έρθουν στο App Store και στο Google Play."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mobile apps are on the way — coming soon to the App Store and Google Play."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las aplicaciones móviles están en camino — próximamente en el App Store y Google Play."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mobiilisovellukset ovat tulossa — saapuvat pian App Storeen ja Google Playyn."
