    "mobile.occurrence_scope.apply_question" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{title} — أي من المهام يجب تطبيق هذه التغييرات عليها؟"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{title} — na které úkoly se mají změny vztahovat?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{title} — hvilke opgaver skal disse ændringer gælde for?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{title} — auf welche Aufgaben sollten sich diese Änderungen auswirken?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{title} — σε ποιες εργασίες θα ισχύσουν αυτές οι αλλαγές;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{title} — which tasks should these changes apply to?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{title} — ¿a qué tareas deben aplicarse estos cambios?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{title} — mihin tehtäviin nämä muutokset tulisi soveltaa?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{title} — quelles tâches ces modifications doivent-elles s'appliquer ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{title} — לאילו משימות להחיל שינויים אלו?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{title} — ये परिवर्तन कौन से कार्यों पर लागू होने चाहिए?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{title} — melyik feladatokra alkalmazzam ezeket a módosításokat?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{title} — tugas mana yang harus berubah?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{title} — a quali compiti dovrebbero applicarsi questi cambiamenti?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{title} — どのタスクに変更を適用しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{title} — 이 변경 사항을 어느 작업에 적용할까요?"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{title} — tugasan mana yang sepatutnya perubahan ini digunakan?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{title} — hvilke oppgaver skal disse endringene brukes på?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{title} — op welke taken moeten deze wijzigingen van toepassing zijn?"
