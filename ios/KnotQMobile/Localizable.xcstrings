        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şemaları, zamanlamaları, görev durumunu ve bildirimleri mobil ve masaüstü arasında senkronize edin. Etkinleştirmek için abone olun."
          }
