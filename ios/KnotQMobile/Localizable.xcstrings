        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu espacio de trabajo sincronizado: esquemas, carpetas, tareas, entradas de calendario, y cualquier entrada de Google Calendar importada que fue parte de tu espacio de trabajo sincronizado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronoidussa työtilassasi: kaaviot, kansiot, tehtävät, kalenterikirjaukset ja kaikki tuodut Google Calendarin merkinnät, jotka olivat osa synkronoitua työtilaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre espace de travail synchronisé : schémas, dossiers, tâches, entrées de calendrier et toutes les entrées Google Calendrier importées qui faisaient partie de votre espace de travail synchronisé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מרחב העבודה המסונכרן שלך: סכמות, תיקיות, משימות, ערכי לוח שנה, וכל ערכי Google Calendar שיובאו שהיו חלק מהמרחב המסונכרן שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका सिंक किया गया वर्कस्पेस: स्कीम, फ़ोल्डर, कार्य, कैलेंडर प्रविष्टियां, और कोई भी आयातित Google कैलेंडर प्रविष्टियां जो आपके सिंक किए गए वर्कस्पेस का हिस्सा थीं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Ön szinkronizált munkahely: sémák, mappák, feladatok, naptár bejegyzések és az importált Google Naptár bejegyzések, amelyek az Ön szinkronizált munkahelyének részei voltak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
