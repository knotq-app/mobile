            "value" : "खाता हटाने, डेटा प्रतिधारण, या KnotQ सहायता के बारे में कुछ भी पूछने के लिए, ईमेल करें"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
