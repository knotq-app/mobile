    "web.home.download.mobile_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطبيقات الجوال في الطريق — سيأتي قريبًا إلى App Store و Google Play."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mobilní aplikace jsou na cestě — již brzy v App Store a Google Play."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mobile apps er på vej — kommer snart til App Store og Google Play."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mobile Apps kommen in Kürze — bald im App Store und Google Play erhältlich."
