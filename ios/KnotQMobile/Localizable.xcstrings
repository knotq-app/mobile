    "mobile.archive.delete_confirm_body_folder" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحذف المجلد وكل شيء بداخله. لا يمكن التراجع عن هذا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstraní složku a vše v ní. Toto nelze vrátit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sletter mappen og alt i den. Dette kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht den Ordner und den gesamten Inhalt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαγράφει το φάκελο και όλα τα περιεχόμενά του. Αυτό δεν μπορεί να αναιρεθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes the folder and everything inside it. This can't be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina la carpeta y todo lo que contiene. Esto no se puede deshacer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistaa kansion ja kaiken sen sisällä. Sitä ei voi kumota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime le dossier et tout ce qu'il contient. Cela ne peut pas être annulé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מחיקת התיקייה וכל מה שיש בתוכה. לא ניתן לבטל זאת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोल्डर और इसके अंदर की सभी चीजों को हटा देता है। यह पूर्ववत नहीं किया जा सकता।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Törli a mappát és mindent, amit tartalmaz. Ez nem vonható vissza."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus folder dan semuanya di dalamnya. Ini tidak dapat dibatalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina la cartella e tutto ciò che contiene. Questa azione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダとその中身をすべて削除します。取り消すことはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "폴더와 그 안의 모든 것을 삭제합니다. 이를 실행 취소할 수 없습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus folder dan semua isinya. Ini tidak dapat dibatalkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sletter mappen og alt som er inne i den. Dette kan ikke angres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert de map en alles erin. Dit kan niet ongedaan gemaakt worden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa folder i wszystko, co w nim jest. Tej czynności nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclui a pasta e tudo dentro dela. Isso não pode ser desfeito."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
