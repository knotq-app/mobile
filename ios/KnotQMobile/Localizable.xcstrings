          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xác minh email của bạn để đăng ký — kiểm tra hộp thư đến của bạn để tìm liên kết."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
