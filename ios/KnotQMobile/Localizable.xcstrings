    "web.guide.daily.p1_post" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " يمنحك صفحة جديدة كل يوم. العناصر غير المكتملة قد تنتقل بشكل اختياري من اليوم السابق، بينما تبقى المهام المكتملة خلفك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " vám dává svěží stránku každý den. Nedokončené položky se volitelně přenesou z předchozího dne, zatímco dokončené úkoly zůstávají vzadu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " giver dig en frisk side hver dag. Ufuldstændige elementer overføres eventuelt fra forrige dag, mens afsluttede opgaver bliver tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " gibt Ihnen jeden Tag eine neue Seite. Unvollständige Elemente können optional vom Vortag übergegeben werden, während abgeschlossene Aufgaben dahinter bleiben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " σας δίνει μια φρέσκια σελίδα κάθε ημέρα. Τα ατελή στοιχεία προαιρετικά μεταφέρονται από την προηγούμενη ημέρα, ενώ οι ολοκληρωμένες εργασίες παραμένουν πίσω."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " gives you a fresh page every day. Incomplete items optionally carry over from the previous day, whereas completed tasks stay behind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "te proporciona una página nueva cada día. Los elementos incompletos opcionalmente se transfieren del día anterior, mientras que las tareas completadas se quedan atrás."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " antaa sinulle tuoreen sivun joka päivä. Keskeneräiset kohteet voidaan halutessaan siirtää edellisestä päivästä, kun taas valmiit tehtävät jäävät taakse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " vous donne une page nouvelle chaque jour. Les éléments incomplets sont reportés du jour précédent, tandis que les tâches complétées restent en arrière."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " נותן לך דף חדש כל יום. פריטים לא שלמים אופציונלית נשאו מהיום הקודם, בעוד שמשימות שהושלמו נשארו מאחור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " आपको हर दिन एक नया पृष्ठ देता है। अधूरे आइटम वैकल्पिक रूप से पिछले दिन से आगे बढ़ सकते हैं, जबकि पूर्ण कार्य पीछे रहते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " minden nap egy friss lapot ad. A nem teljesített tárgyak opcionálisan áthozhatók az előző napról, míg a befejezett feladatok maradnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " memberi Anda halaman segar setiap hari. Item yang belum selesai secara opsional dibawa dari hari sebelumnya, sedangkan tugas yang selesai tetap tertinggal."
