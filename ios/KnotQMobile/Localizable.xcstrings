    "web.delete_account.what_gets_deleted_intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد فترة الرحمة، يتم حذف البيانات التالية بشكل دائم من أنظمة KnotQ:"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po uplynutí lhůty pro zvážení se z KnotQ systémů trvale odstraní následující data:"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efter henstandsperioden bliver følgende data permanent fjernet fra KnotQ's systemer:"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach der Widerrufsfrist werden die folgenden Daten dauerhaft aus KnotQ-Systemen entfernt:"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετά την περίοδο χάριτος, τα ακόλουθα δεδομένα αφαιρούνται μόνιμα από τα συστήματα του KnotQ:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After the grace period, the following data is permanently removed from KnotQ's systems:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después del período de gracia, los siguientes datos se eliminan permanentemente de los sistemas de KnotQ:"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisäajan jälkeen seuraavat tiedot poistetaan pysyvästi KnotQ:n järjestelmistä:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après la période de grâce, les données suivantes sont supprimées de manière permanente des systèmes de KnotQ :"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לאחר תקופת ההחלמה, הנתונים הבאים מוסרים בצורה קבועה מממערכות KnotQ:"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहायक अवधि के बाद, निम्नलिखित डेटा KnotQ की प्रणालियों से स्थायी रूप से हटा दिया जाता है:"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A haladék lejárta után a következő adatok véglegesen eltávolítódnak a KnotQ rendszereből:"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah periode tenggang, data berikut dihapus secara permanen dari sistem KnotQ:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo il periodo di grazia, i seguenti dati vengono rimossi permanentemente dai sistemi di KnotQ:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "猶予期間後、次のデータはKnotQのシステムから永久に削除されます:"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
