    "web.home.pitch.tile2_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب تذكيرًا أو تاريخ استحقاق أو حدثًا على أي سطر أثناء الكتابة — بدون نماذج أو حقول منفصلة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poklesněte připomenutí, splatné datum nebo událost na jakýkoli řádek při psaní — žádné samostatné formuláře nebo pole."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slip en påmindelse, forfaldsdato eller begivenhed på en hvilken som helst linje, når du skriver — ingen separate formularer eller felter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legen Sie eine Erinnerung, ein Fälligkeitsdatum oder ein Ereignis auf eine beliebige Zeile, während Sie schreiben — kein separates Formular oder Felder."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ρίξτε μια υπενθύμιση, ημερομηνία λήξης ή γεγονός σε οποιαδήποτε γραμμή καθώς γράφετε — χωρίς ξεχωριστές φόρμες ή πεδία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drop a reminder, due date, or event onto any line as you write — no separate forms or fields."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca un recordatorio, fecha de vencimiento, o evento en cualquier línea mientras escribes — sin formularios ni campos separados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pudota muistutus, eräpäivä tai tapahtuma mihin tahansa riviin kirjoittaessasi — ei erillisiä lomakkeita tai kenttiä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déposez un rappel, une date d'échéance ou un événement sur n'importe quelle ligne au moment de l'écriture — sans formulaires ni champs séparés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זרוק תזכורת, מועד קובע או אירוע לכל שורה כשאתה כותב — ללא טפסים נפרדים או שדות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जैसे ही आप लिखते हैं, किसी भी पंक्ति पर रिमाइंडर, समय सीमा, या इवेंट ड्रॉप करें — कोई अलग फॉर्म या फ़ील्ड नहीं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tegyen le egy emlékeztetõt, határidõt vagy eseményt bármelyik sorra, ahogy írunk — nincs külön forma vagy mezzõ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jatuhkan pengingat, tanggal jatuh tempo, atau acara ke baris mana pun saat Anda menulis — tidak ada formulir atau bidang terpisah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rilascia un promemoria, una scadenza o un evento su qualsiasi riga mentre scrivi — nessun modulo o campo separato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモを書くときに、任意の行にリマインダー、期限、またはイベントをドロップします — 別のフォームやフィールドはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작성하면서 알림, 기한 또는 이벤트를 모든 줄에 놓으세요 — 별도의 양식이나 필드가 필요 없습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lepaskan pengingat, tanggal jatuh tempo, atau acara ke baris apa pun saat Anda menulis — tidak ada formulir atau bidang terpisah."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slipp en påminnelse, forfallsdato eller begivenhet på en hvilken som helst linje når du skriver – ingen separate skjemaer eller felt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet een herinnering, vervaldatum of evenement op elke regel terwijl je schrijft — geen aparte formulieren of velden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upuść przypomnienie, termin lub zdarzenie w dowolną linię podczas pisania — brak odrębnych formularzy ani pól."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solte um lembrete, data de vencimento ou evento em qualquer linha enquanto escreve — sem formulários ou campos separados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque um lembrete, data de vencimento ou evento em qualquer linha conforme escreve — sem formulários ou campos separados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plasați un memento, o dată scadență sau un eveniment pe orice linie pe măsură ce scrieți — fără forme sau câmpuri separate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поместите напоминание, дату срока или событие на любую строку при написании — без отдельных форм или полей."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrhnite pripomienku, termín alebo udalosť na akýkoľvek riadok počas písania — bez oddelených formulárov alebo polí."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Släpp en påminnelse, deadline eller händelse på vilken rad som helst när du skriver — inga separata formulär eller fält."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วางการเตือน วันเสร็จสิ้น หรือเหตุการณ์ลงในบรรทัดใด ๆ ขณะเขียน — ไม่มีแบบฟอร์มหรือเขตข้อมูลแยกต่างหาก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yazarken herhangi bir satıra hatırlatıcı, vade tarihi veya etkinlik bırakın — ayrı form veya alan yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скиньте нагадування, дату виконання або подію на будь-який рядок, коли ви пишете — без окремих форм або полів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thả nhắc nhở, ngày đến hạn hoặc sự kiện vào bất kỳ dòng nào khi bạn viết — không có các mẫu hoặc trường riêng biệt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在编写时将提醒、截止日期或事件放在任何行上 — 没有单独的表单或字段。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在您編寫時將提醒、到期日期或事件放在任何行上 — 沒有單獨的表單或欄位。"
          }
        }
      }
    },
