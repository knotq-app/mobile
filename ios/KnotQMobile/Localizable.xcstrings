    "web.delete_account.what_is_kept_intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لتشغيل الخدمة بأمان والوفاء بالالتزامات المحاسبية، قد تستمر مجموعة محدودة من السجلات لفترة وجيزة بعد الحذف:"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby se služba provozovala bezpečně a plnily se účetní povinnosti, mohou se krátce po smazání uchovat omezené záznamy:"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at drive tjenesten sikkert og opfylde regnskabsforpligtelser, kan et begrænset sæt registre blive værende kort efter sletning:"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um den Service sicher zu betreiben und Rechnungslegungsverpflichtungen zu erfüllen, können einige begrenzte Datensätze kurz nach der Löschung bestehen bleiben:"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για να λειτουργήσει η υπηρεσία με ασφάλεια και να πληρούνται οι λογιστικές υποχρεώσεις, ένα περιορισμένο σύνολο αρχείων ενδέχεται να παραμείνει αμέσως μετά τη διαγραφή:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To operate the service securely and meet accounting obligations, a limited set of records may persist briefly after deletion:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para operar el servicio de forma segura y cumplir con las obligaciones contables, un conjunto limitado de registros puede persistir brevemente después de la eliminación:"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelun turvalliseksi käyttämiseksi ja kirjanpitoveloitteiden täyttämiseksi rajoitettu joukko tietueita voi säilyä lyhyesti poistamisen jälkeen:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour exploiter le service en toute sécurité et respecter les obligations comptables, un ensemble limité d'enregistrements peut persister brièvement après suppression :"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי להפעיל את השירות בבטחה ולעמוד בהתחייבויות חשבונאיות, קבוצה מוגבלת של רישומים עלולה להתמשך לתקופה קצרה לאחר המחיקה:"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेवा को सुरक्षित रूप से संचालित करने और लेखांकन दायित्वों को पूरा करने के लिए, रिकॉर्ड का एक सीमित सेट हटाने के बाद संक्षेप में बना रह सकता है:"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szolgáltatás biztonságos működtetéséhez és a könyvelési kötelezettségek teljesítéséhez a törlés után rövid ideig megmaradhat néhány adatsor:"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk mengoperasikan layanan dengan aman dan memenuhi kewajiban akuntansi, serangkaian catatan terbatas dapat tetap berlanjut sebentar setelah penghapusan:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per gestire il servizio in modo sicuro e rispettare gli obblighi contabili, una serie limitata di record può persistere brevemente dopo l'eliminazione:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サービスを安全に運用し会計義務を満たすため、限定的なレコードセットが削除後短期間残存する可能性があります:"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서비스를 안전하게 운영하고 회계 의무를 충족하기 위해 제한된 기록 집합이 삭제 후 잠시 동안 유지될 수 있습니다:"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk mengoperasikan layanan dengan aman dan memenuhi kewajiban akuntansi, serangkaian rekod terbatas dapat bertahan sebentar setelah penghapusan:"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å drive tjenesten sikkert og oppfylle regnskapsmessige forpliktelser, kan et begrenset sett med poster vedvare kort tid etter sletting:"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om de service veilig te beheren en boekhoudkundige verplichtingen na te komen, kunnen beperkte gegevens korte tijd na verwijdering blijven bestaan:"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby obsługiwać usługę bezpiecznie i spełniać zobowiązania księgowe, ograniczony zestaw rekordów może zostać przechowany przez krótki czas po usunięciu:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para operar o serviço com segurança e cumprir as obrigações contábeis, um conjunto limitado de registros pode persistir brevemente após a exclusão:"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para operar o serviço com segurança e cumprir obrigações contabilísticas, um conjunto limitado de registos pode persistir brevemente após a eliminação:"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru a funcționa serviciul în mod sigur și a îndeplini obligațiile contabile, un set limitat de înregistrări poate persista scurt timp după ștergere:"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для безопасной работы сервиса и выполнения бухгалтерских обязательств ограниченный набор записей может сохраняться в течение короткого времени после удаления:"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby služba fungovala bezpečne a spĺňala účtovné povinnosti, určitý súbor záznamov môže krátko pretrvať po zmazaní:"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att driva tjänsten säkert och möta redovisningskrav kan en begränsad uppsättning poster stanna kvar under en kort tid efter borttagning:"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพื่อให้บริการอย่างปลอดภัยและปฏิบัติตามข้อบังคับทางบัญชี ชุดบันทึกที่จำกัดอาจยังคงอยู่หลังจากการลบสั้น ๆ:"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hizmeti güvenli bir şekilde işletmek ve muhasebe yükümlülüklerini yerine getirmek için, sınırlı bir kayıt seti silme işleminden sonra kısa bir süre devam edebilir:"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для безпечної роботи сервісу та виконання облікових зобов'язань обмежений набір записів може зберігатися короткий час після видалення:"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để vận hành dịch vụ một cách an toàn và đáp ứng các nghĩa vụ kế toán, một bộ hồ sơ hạn chế có thể tồn tại trong một thời gian ngắn sau khi xóa:"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了安全运营服务和满足会计义务，有限的记录集可能在删除后短暂保留："
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為了安全營運服務並符合會計義務，有限的記錄集可能會在刪除後短期內繼續存在："
          }
        }
      }
    },
