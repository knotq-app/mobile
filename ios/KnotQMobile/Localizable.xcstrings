    "onboarding.step.schemes.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المخططات هي محاور قابلة للتحرير للمشاريع والملاحظات والخطط. أضف أوقات البدء والنهاية لأي سطر لتحويله إلى عنصر تقويم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plány jsou upravitelné osnovy pro projekty, poznámky a plány. Přidejte čas začátku a konce libovolnému řádku, abyste jej převedli na položku kalendáře."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skemaer er redigerbare konturer for projekter, noter og planer. Tilføj start- og sluttider til enhver linje for at gøre det til et kalenderelement."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schemata sind bearbeitbare Gliederungen für Projekte, Notizen und Pläne. Fügen Sie Start- und Endzeiten hinzu, um eine Zeile in ein Kalenderelement umzuwandeln."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα σχέδια είναι επεξεργάσιμα περιγράμματα για έργα, σημειώσεις και σχέδια. Προσθέστε ώρες έναρξης και λήξης σε οποιαδήποτε γραμμή για να τη μετατρέψετε σε στοιχείο ημερολογίου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schemes are editable outlines for projects, notes, and plans. Add start and end times to any line to turn it into a calendar item."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los esquemas son esquemas editables para proyectos, notas y planes. Añade horas de inicio y finalización a cualquier línea para convertirla en un elemento de calendario."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaaviot ovat muokattavia aiheita projekteihin, muistiinpanoihin ja suunnitelmiin. Lisää alkamis- ja päättymisajat mihin tahansa riville, jotta siitä tulee kalenterin kohde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les plans sont des plans éditables pour les projets, les notes et les plans. Ajoutez des heures de début et de fin à n'importe quelle ligne pour la transformer en élément de calendrier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תכניות הן קווי מתאר הניתנים לעריכה עבור פרויקטים, הערות ותוכניות. הוסף זמני התחלה וסיום לכל שורה כדי להפוך אותה לפריט לוח שנה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "योजनाएं परियोजनाओं, नोट्स, और योजनाओं के लिए संपादन योग्य रूपरेखाएं हैं। किसी भी पंक्ति को कैलेंडर आइटम में बदलने के लिए शुरुआत और अंत समय जोड़ें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sémák szerkeszthető vázlatok projektekhez, jegyzetekhez és tervekhez. Adj hozzá kezdési és befejezési időket bármely sorhoz, hogy naptárelemszé alakítsd."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skema adalah garis besar yang dapat diedit untuk proyek, catatan, dan rencana. Tambahkan waktu mulai dan akhir ke baris apa pun untuk mengubahnya menjadi item kalender."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli schemi sono contorni modificabili per progetti, note e piani. Aggiungi ore di inizio e fine a qualsiasi riga per trasformarla in un elemento del calendario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキームはプロジェクト、メモ、プランの編集可能なアウトラインです。任意の行に開始時刻と終了時刻を追加して、カレンダーアイテムに変えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스키마는 프로젝트, 메모 및 계획에 대한 편집 가능한 개요입니다. 시작 시간과 종료 시간을 추가하여 캘린더 항목으로 변환하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skema adalah garis besar yang boleh disunting untuk projek, nota, dan rancangan. Tambah masa mula dan akhir ke mana-mana baris untuk mengubahnya menjadi item kalendar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjemaer er redigerbare oversikter for prosjekter, notater og planer. Legg til start- og sluttid til en hvilken som helst linje for å gjøre det til et kalenderelement."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schema's zijn bewerkbare overzichten voor projecten, aantekeningen en plannen. Voeg start- en eindtijden toe aan elke regel om ervan een agenda-item te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schematy to edytowalne schematy projektów, notatek i planów. Dodaj czasy rozpoczęcia i zakończenia do dowolnej linii, aby zmienić ją na element kalendarza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esquemas são estruturas editáveis para projetos, anotações e planos. Adicione horários de início e fim a qualquer linha para transformá-la em um item de calendário."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os esquemas são contornos editáveis para projetos, notas e planos. Adicione tempos de início e fim a qualquer linha para a transformar num item de calendário."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planurile sunt schițe editabile pentru proiecte, note și planuri. Adăugați ore de început și de sfârșit la orice linie pentru a o transforma într-un element de calendar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Схемы — это редактируемые структуры для проектов, заметок и планов. Добавьте время начала и окончания к любой строке, чтобы превратить ее в элемент календаря."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schémy sú upraviteľné osnovy pre projekty, poznámky a plány. Pridajte časy začiatku a konca na ľubovoľný riadok, aby ste ho zmenili na položku kalendára."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scheman är redigerbara dispositioner för projekt, anteckningar och planer. Lägg till start- och sluttid för en rad för att göra den till ett kalenderitem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แบบแผนคือโครงร่างที่แก้ไขได้สำหรับโครงการ บันทึก และแผน เพิ่มเวลาเริ่มต้นและสิ้นสุดในบรรทัดใดก็ได้เพื่อเปลี่ยนเป็นรายการปฏิทิน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şemalar, projeler, notlar ve planlar için düzenlenebilir ana hatları oluşturur. Herhangi bir satıra başlangıç ve bitiş saatleri ekleyerek bunu takvim öğesine dönüştürün."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Схеми — це редаговані обриси для проектів, нотаток і планів. Додайте час початку та закінчення до будь-якого рядка, щоб перетворити його на елемент календара."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lược đồ là các phác thảo có thể chỉnh sửa cho các dự án, ghi chú và kế hoạch. Thêm thời gian bắt đầu và kết thúc cho bất kỳ dòng nào để biến nó thành một mục lịch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "方案是项目、笔记和计划的可编辑大纲。将开始和结束时间添加到任何行以将其转换为日历项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "方案是專案、筆記和計畫的可編輯大綱。將開始和結束時間新增至任何行，將其轉變為日曆項目。"
          }
        }
      }
    },
