    "onboarding.step.upcoming.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القادم يجمع الأحداث والمهام والتذكيرات القريبة. يمكنك وضع علامة على المهام المكتملة من هنا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadcházející shromažďuje blízké události, úkoly a připomenutí. Úkoly můžete označit jako dokončené přímo odsud."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommende samler nærliggende begivenheder, opgaver og påmindelser. Du kan markere opgaver som fuldført direkte herfra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevorstehend sammelt nahe Ereignisse, Aufgaben und Benachrichtigungen. Sie können Aufgaben direkt von hier aus als abgeschlossen markieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα Επερχόμενα συγκεντρώνουν κοντινά συμβάντα, εργασίες και υπενθυμίσεις. Μπορείτε να σημειώσετε τις εργασίες ως ολοκληρωμένες από εδώ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upcoming gathers nearby events, assignments, and reminders. You can mark tasks complete right from here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Próximos reúne eventos, tareas y recordatorios cercanos. Puedes marcar tareas como completadas directamente desde aquí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulevat kokoavat lähellä olevia tapahtumia, tehtäviä ja muistutuksia. Voit merkitä tehtävät valmiiksi täältä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À venir rassemble les événements, affectations et rappels proches. Vous pouvez marquer les tâches comme complétées directement d'ici."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קרוב מחברת אירועים קרובים, יעדים ותזכורות. אתה יכול לסמן משימות כמושלמות מכאן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आसन्न निकटतम घटनाएं, कार्य, और अनुस्मारक एकत्र करता है। आप यहीं से कार्यों को पूर्ण चिह्नित कर सकते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Közelgő közelgő eseményeket, hozzárendeléseket és emlékeztetőket gyűjt. Közvetlenül innen jelölheted meg a feladatokat elkészültként."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mendatang mengumpulkan acara, tugas, dan pengingat yang dekat. Anda dapat menandai tugas sebagai selesai langsung dari sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prossimi raccolti eventi, incarichi e promemoria vicini. Puoi contrassegnare i compiti come completati proprio da qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップカミングは近くのイベント、アサイン、リマインダーを集めます。ここからタスクを完了にすることができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upcoming은 인근 이벤트, 할당 및 리마인더를 수집합니다. 여기서 바로 작업을 완료로 표시할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akan datang mengumpulkan acara berdekatan, tugasan, dan peringatan. Anda boleh menandakan tugas selesai tepat dari sini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommende samler nærliggende hendelser, oppgaver og remindere. Du kan merke oppgaver som fullført rett herfra."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aankomend verzamelt nabije gebeurtenissen, taken en herinneringen. Je kunt taken direct van hier afvinken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadchodzące zbiera zbliżające się zdarzenia, zadania i przypomnienia. Możesz tutaj oznaczyć zadania jako ukończone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Próximo reúne eventos, tarefas e lembretes próximos. Você pode marcar tarefas como completas direto daqui."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Próximos reúne eventos próximos, tarefas e lembretes. Pode marcar tarefas como concluídas diretamente aqui."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upcoming adună evenimentele, atribuțiile și reamintirile apropiate. Puteți marca sarcinile complete chiar de aici."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предстоящее собирает близлежащие события, задания и напоминания. Вы можете отметить задачи как выполненные отсюда."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blížiace sa zhromažďuje blízke podujatia, úlohy a pripomenutia. Tu môžete označiť úlohy ako hotové."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommande samlar närliggande event, uppdrag och påminnelser. Du kan markera uppgifter som slutförda direkt härifrån."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upcoming รวบรวมเหตุการณ์ งานมอบหมาย และการแจ้งเตือนที่อยู่ใกล้เคียง คุณสามารถทำเครื่องหมายงานว่าเสร็จสิ้นได้จากที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaklaşan, etkinlikleri, görevleri ve anımsatıcıları bir araya getirir. Görevleri buradan tamamlandı olarak işaretleyebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наступні события збирають неподалік подій, завдань і нагадування. Ви можете позначити завдання як виконані прямо звідси."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sắp tới thu thập các sự kiện gần đây, bài tập và nhắc nhở. Bạn có thể đánh dấu các tác vụ hoàn thành ngay từ đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即将到来聚集附近的事件、任务和提醒。您可以从这里直接标记任务为完成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即將推出會收集附近的事件、代辦事項和提醒。您可以直接從此處標記任務為完成。"
          }
        }
      }
    },
    "onboarding.step.upcoming.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
