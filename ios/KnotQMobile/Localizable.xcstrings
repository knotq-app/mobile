    "web.account.sync_detail_pitch" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مزامنة الأنظمة والجداول الزمنية وحالة المهام والإخطارات على الأجهزة المحمولة وأجهزة سطح المكتب. قم بالاشتراك لتشغيلها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizujte schémata, plány, stav úkolů a oznámení na mobilní a stolní počítač. Přihlaste se k odběru a zapněte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkroniser skemaer, tidsplaner, opgavestatus og notifikationer på mobile og desktop. Abonner for at aktivere den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisieren Sie Schemen, Zeitpläne, Aufgabenstatus und Benachrichtigungen auf Mobilgeräten und Desktops. Abonnieren Sie, um es zu aktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συγχρονισμός σχεδίων, χρονοδιαγραμμάτων, κατάστασης εργασίας και ειδοποιήσεων σε κινητά και επιτραπέζια συστήματα. Κάντε συνδρομή για ενεργοποίησή του."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync schemes, schedules, task state, and notifications across mobile and desktop. Subscribe to turn it on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincroniza esquemas, calendarios, estado de tareas y notificaciones en móvil y escritorio. Suscríbete para activarla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronoi scheemat, aikataulut, tehtävän tila ja ilmoitukset mobiili- ja työpöytälaitteiden välillä. Tilaa ottaaksesi sen käyttöön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisez les schémas, les horaires, l'état des tâches et les notifications sur les appareils mobiles et de bureau. Abonnez-vous pour l'activer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סנכרן תוכניות, לוחות זמנים, מצב משימה והודעות בין נייד שולחני. הירשם כדי להפעיל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मोबाइल और डेस्कटॉप में योजनाओं, शेड्यूल, कार्य स्थिति और सूचनाओं को सिंक करें। इसे चालू करने के लिए सदस्यता लें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sémák, ütemezések, feladatállapot és értesítések szinkronizálása mobil és asztali számítógépen. Iratkozzon fel az engedélyezéshez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinkronkan skema, jadwal, status tugas, dan notifikasi di seluruh perangkat seluler dan desktop. Berlangganan untuk mengaktifkannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizza schemi, orari, stato delle attività e notifiche tra dispositivi mobili e desktop. Abbonati per attivarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキーム、スケジュール、タスク状態、通知をモバイルとデスクトップで同期します。有効にするために購読してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모바일 및 데스크톱 간 스키마, 일정, 작업 상태 및 알림을 동기화합니다. 켜려면 구독하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinkron skema, jadual, keadaan tugas, dan notifikasi merentasi mudah alih dan desktop. Langgan untuk menghidupkannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkroniser skjemaer, tidsplaner, oppgavetilstand og varsler på tvers av mobil og skrivebord. Abonner for å slå det på."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchroniseer schema's, schema's, taakstatus en meldingen op mobiel en desktop. Abonneer je om het in te schakelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizuj schematy, harmonogramy, stan zadań i powiadomienia na urządzeniach mobilnych i komputerach. Subskrybuj, aby włączyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronize esquemas, cronogramas, estado de tarefas e notificações entre celular e desktop. Assine para ativar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronize esquemas, cronogramas, estado de tarefas e notificações em dispositivos móveis e desktop. Subscreva para ativar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizare scheme, programe, stare sarcini și notificări pe dispozitivele mobile și desktop. Abonați-vă pentru a o activa."
