    "web.account.password_reset_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غيّر كلمة مرورك برابط إعادة تعيين مُرسل إلى بريد حسابك الإلكتروني."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Změňte heslo pomocí odkazu na resetování hesla odeslaného na e-mail vašeho účtu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skift din adgangskode med et nulstillingslink sendt til din kontos e-mail."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändern Sie Ihr Passwort mit einem Rücksetz-Link, der an Ihre Konto-E-Mail gesendet wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αλλάξτε τον κωδικό πρόσβασης σας με έναν σύνδεσμο επαναφοράς που αποστέλλεται στο email του λογαριασμού σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change your password with a reset link sent to your account email."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia tu contraseña con un enlace de restablecimiento enviado a tu email de cuenta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muuta salasanaasi palautuslinkin avulla, joka lähetetään tilin sähköpostiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifiez votre mot de passe avec un lien de réinitialisation envoyé à votre adresse e-mail de compte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שנה את הסיסמה שלך עם קישור איפוס שנשלח לדוא״ל החשבון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके खाते के ईमेल को भेजे गए रीसेट लिंक के साथ अपना पासवर्ड बदलें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Módosítsa jelszavát az e-mailhez küldött visszaállítási linkkel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubah kata sandi Anda dengan tautan penyetelan ulang yang dikirim ke email akun Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia la tua password con un link di ripristino inviato alla tua email dell'account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントメールに送信されたリセットリンクでパスワードを変更します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정 이메일로 보낸 재설정 링크로 비밀번호를 변경하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubah kata laluan anda dengan pautan tetapan semula yang dihantar ke e-mel akaun anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endre passordet ditt med en tilbakestillingslenke sendt til kontoe-posten din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wijzig je wachtwoord met een resetlink die naar je accounte-mail wordt verzonden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmień hasło, używając linku do resetowania wysłanego na e-mail konta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altere sua senha com um link de redefinição enviado para o email da sua conta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altere a sua senha com uma ligação de reposição enviada para o seu email de conta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schimbați parola cu un link de resetare trimis la e-mailul contului dvs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Измените пароль по ссылке сброса, отправленной на адрес электронной почты вашей учётной записи."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmeniť heslo pomocou odkazu na obnovenie poslaného na vašu e-mailovú adresu účtu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändra ditt lösenord med en återställningslänk som skickas till din kontoe-post."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปลี่ยนรหัสผ่านของคุณด้วยลิงก์รีเซ็ตที่ส่งไปยังอีเมลบัญชีของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesap e-postanıza gönderilen bir sıfırlama bağlantısıyla parolanızı değiştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Змініть пароль за допомогою посилання скидання, надісланого на адресу електронної пошти вашого облікового запису."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thay đổi mật khẩu của bạn bằng liên kết đặt lại được gửi tới email tài khoản của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用发送到您账户电子邮件的重置链接更改密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用傳送到您帳戶電子郵件的重設連結變更您的密碼。"
          }
        }
      }
