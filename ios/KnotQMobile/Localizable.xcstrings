    "web.account.delete_account_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجدول حسابك والبيانات المزامنة للإزالة بعد فترة سماح."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naplánuje váš účet a synchronizovaná data na smazání po dobu lhůty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planlægger din konto og synkroniserede data til fjernelse efter en karensperiode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminiert Ihr Konto und synchronisierte Daten zum Löschen nach einer Schonfrist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προγραμματίζει το λογαριασμό και τα συγχρονισμένα δεδομένα σας για αφαίρεση μετά από μια περίοδο χάριτος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schedules your account and synced data for removal after a grace period."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programa tu cuenta y datos sincronizados para eliminación después de un período de gracia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoittaa tilisi ja synkronoidut tiedot poistettavaksi armonkauden jälkeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifie la suppression de votre compte et de vos données synchronisées après un délai d'attente."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תזמן את החשבון שלך והנתונים המסונכרנים להסרה לאחר תקופת חסד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके खाते और सिंक किए गए डेटा को एक अनुग्रह अवधि के बाद हटाने के लिए शेड्यूल करता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fiók és szinkronizált adatokat a türelmi időszak után törli."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menjadwalkan akun dan data tersinkronisasi Anda untuk dihapus setelah masa tenggang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programma il tuo account e i dati sincronizzati per l'eliminazione dopo un periodo di grazia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントと同期されたデータを猶予期間の後に削除するようにスケジュールします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유예 기간 후 계정 및 동기화된 데이터를 삭제하도록 예약합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menjadwalkan akaun anda dan data sinkron untuk dibuang selepas tempoh tangguh."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planlegger slettingen av kontoen og de synkroniserte dataene dine etter en henstandsperiode."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plant je account en gesynchroniseerde gegevens voor verwijdering na een respijtperiode."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planuje usunięcie Twojego konta i zsynchronizowanych danych po okresie przejściowym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agenda sua conta e dados sincronizados para remoção após um período de carência."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agenda a sua conta e dados sincronizados para remoção após um período de tolerância."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programează contul dvs. și datele sincronizate pentru ștergere după o perioadă de grație."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Назначает удаление вашей учётной записи и синхронизированных данных после периода отсрочки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naplánuje odstránenie vášho účtu a synchronizovaných údajov po lehote na premýšľanie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schemalägger ditt konto och synkroniserade data för borttagning efter en respitperiod."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กำหนดให้ลบบัญชีและข้อมูลซิงค์ของคุณหลังจากช่วงเวลาการอนุมัติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesabınız ve senkronize edilen verileriniz bir inceleme süresinden sonra silinmek üzere programlanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Планує видалення вашого облікового запису та синхронізованих даних після дати закінчення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lên lịch xóa tài khoản và dữ liệu đã đồng bộ của bạn sau thời gian ân hạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "计划在宽限期后删除您的账户和已同步数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "排定您的帳戶和同步資料在緩衝期後移除。"
          }
        }
      }
    },
