    "web.guide.scheduling.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن جدولة أي سطر بإعطاؤه وقت البداية أو وقت النهاية أو كليهما:"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jakýkoli řádek lze naplánovat zadáním času začátku, času konce nebo obojího:"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En hvilken som helst linje kan planlægges ved at give den en starttid, sluttid eller begge dele:"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Zeile kann eingeplant werden, indem Sie ihr eine Startzeit, eine Endzeit oder beides geben:"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οποιαδήποτε γραμμή μπορεί να προγραμματιστεί δίνοντάς της ένα χρόνο έναρξης, χρόνο λήξης ή και τα δύο:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Any line can be scheduled by giving it a start time, end time, or both:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier línea se puede programar dándole una hora de inicio, hora de fin, o ambas:"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikä tahansa rivi voidaan ajoittaa antamalla sille alkamisaika, päättymisaika tai molemmat:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N'importe quelle ligne peut être planifiée en lui donnant une heure de début, une heure de fin ou les deux :"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל שורה יכולה להיות מתוזמנת על ידי הרחקת תאריך התחלה, תאריך סיום, או שניהם:"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी भी पंक्ति को एक शुरुआत समय, अंत समय, या दोनों देकर शेड्यूल किया जा सकता है:"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bármely sor ütemezhetõ a kezdési idő, befejezési idő vagy mindkettõ megadásával:"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baris apa pun dapat dijadwalkan dengan memberikan waktu mulai, waktu akhir, atau keduanya:"
          }
        },
        "it" : {
