    "web.guide.shortcuts.close_search_or_popover" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إغلاق البحث أو إلغاء إعادة التسمية/الحذف أو إيقاف سحب التقويم أو إغلاق منتقي النافذة النشطة"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zavřít vyhledávání, zrušit přejmenování/smazání, zastavit přetahování kalendáře nebo zavřít aktivní překryvné okno"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luk søgning, annuller omdøbning/sletning, stop kalendertrækking, eller luk den aktive popover"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suche schließen, Umbenennung/Löschung abbrechen, Kalender-Drag beenden oder aktives Popover schließen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κλείστε την αναζήτηση, ακυρώστε την μετονομασία/διαγραφή, σταματήστε το σύρσιμο ημερολογίου ή κλείστε το ενεργό popover"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close search, cancel rename/delete, stop calendar drag, or close the active popover"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra búsqueda, cancela renombrado/eliminación, detén arrastre de calendario, o cierra la ventana emergente activa"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sulje haku, peruuta nimen muutos/poistaminen, lopeta kalenterin vetäminen tai sulje aktiivinen ponnahdus"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fermez la recherche, annulez le renommage/suppression, arrêtez le glisser-déposer du calendrier ou fermez la fenêtre contextuelle active"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סגור חיפוש, בטל שם הודעה/מחיקה, עצור גרירת לוח שנה, או סגור את popover פעיל"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खोज बंद करें, नाम बदलने/हटाने को रद्द करें, कैलेंडर ड्रैग बंद करें, या सक्रिय पॉपओवर बंद करें"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keresés bezárása, átnevezés/törlés visszavonása, naptár húzásának leállítása, vagy az aktív felugró ablak bezárása"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutup pencarian, batalkan rename/delete, hentikan seret kalender, atau tutup popover aktif"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiudi ricerca, annulla rinomina/eliminazione, interrompi il trascinamento del calendario, o chiudi il popover attivo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索を閉じるか、名前変更/削除をキャンセルするか、カレンダードラッグを停止するか、アクティブなポップオーバーを閉じます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검색 닫기, 이름 바꾸기/삭제 취소, 캘린더 드래그 중지 또는 활성 팝오버 닫기"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutup pencarian, batalkan ganti nama/hapus, hentikan seret kalender, atau tutup popover aktif"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lukk søk, avbryt omdøping/sletting, stopp kalendersdrag eller lukk den aktive popoveren"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sluit zoeken, annuleer hernoemen/verwijderen, stop agendaSleep of sluit de actieve popover"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamknij wyszukiwanie, anuluj zmianę nazwy/usunięcie, zatrzymaj przeciąganie kalendarza lub zamknij aktywne okno podręczne"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fechar busca, cancelar renomear/excluir, parar arrasto de calendário ou fechar o popover ativo"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fechar pesquisa, cancelar renomeação/eliminação, parar arrasto de calendário ou fechar o popover ativo"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Închideți căutarea, anulați redenumire/ștergere, opriți tragerea calendarului sau închideți popover-ul activ"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрыть поиск, отменить переименование/удаление, остановить перетаскивание календаря или закрыть активное всплывающее окно"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zavriet vyhľadávanie, zrušiť premenovanie/zmazanie, zastaviť ťahanie kalendára alebo zavrieť aktívny popover"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stäng sökning, avbryt namnbyte/borttagning, stoppa kalenderdragning eller stäng den aktiva popover"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิดการค้นหา ยกเลิกการเปลี่ยนชื่อ/ลบ หยุดการลากปฏิทิน หรือปิดป๊อปโอเวอร์ที่ใช้งานอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aramayı kapatın, yeniden adlandırma/silmeyi iptal edin, takvim sürüklemesini durdurun veya etkin açılır pencereyi kapatın"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрити пошук, скасувати перейменування/видалення, припинити перетягування календаря або закрити активне вспливаюче вікно"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đóng tìm kiếm, hủy đổi tên/xóa, dừng kéo lịch hoặc đóng chế độ bật mở hoạt động"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭搜索，取消重命名/删除，停止日历拖动或关闭活动弹出窗口"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉搜尋、取消重新命名/刪除、停止日曆拖動或關閉活躍彈出視窗"
          }
        }
      }
    },
