    "web.home.pitch.tile3_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملفات عادية محلية أولاً تعمل بالكامل بدون اتصال. لا حساب مطلوب."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Místně první prosté soubory, které fungují zcela offline. Není vyžadován účet."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokalt-først almindelige filer, der fungerer helt offline. Ingen konto nødvendig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokal-first einfache Dateien, die vollständig offline funktionieren. Kein Konto erforderlich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τοπικά αρχεία που λειτουργούν πλήρως χωρίς σύνδεση. Δεν απαιτείται λογαριασμός."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local-first plain files that work fully offline. No account required."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivos simple local-first que funcionan completamente sin conexión. Sin cuenta requerida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paikallis-ensin tavallisia tiedostoja, jotka toimivat täysin offline-tilassa. Ei tiliä vaaditaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fichiers simples d'abord locaux qui fonctionnent entièrement hors ligne. Aucun compte requis."
          }
        },
        "he" : {
