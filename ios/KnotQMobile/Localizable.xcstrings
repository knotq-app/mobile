    "web.home.faq.q3_answer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عادة في حوالي 10 دقائق. يتم مزامنة KnotQ في الخلفية، لذا تظهر التغييرات على جهاز واحد على الأجهزة الأخرى بعد بضع دقائق — أو يمكنك بدء المزامنة يدويًا للحصول على تحديث فوري."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obvykle během asi 10 minut. KnotQ se synchronizuje na pozadí, takže změny na jednom zařízení se na ostatních objevují o pár minut později — nebo můžete spustit synchronizaci ručně pro okamžitou aktualizaci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalt inden for omkring 10 minutter. KnotQ synkroniseres i baggrunden, så ændringer på en enhed vises på dine andre få minutter senere — eller du kan udløse en synkronisering manuelt for en øjeblikkelig opdatering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalerweise in etwa 10 Minuten. KnotQ wird im Hintergrund synchronisiert, daher erscheinen Änderungen auf einem Gerät nach ein Paar Minuten auf den anderen — oder Sie können eine Synchronisierung manuell auslösen, um ein sofortiges Update zu erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνήθως σε περίπου 10 λεπτά. Το KnotQ συγχρονίζεται στο παρασκήνιο, επομένως οι αλλαγές σε μια συσκευή εμφανίζονται στις άλλες σας σε λίγα λεπτά — ή μπορείτε να ενεργοποιήσετε ένα συγχρονισμό χειροκίνητα για άμεση ενημέρωση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usually within about 10 minutes. KnotQ syncs in the background, so changes on one device show up on your others a few minutes later — or you can trigger a sync manually for an immediate update."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usualmente dentro de unos 10 minutos. KnotQ se sincroniza en segundo plano, por lo que los cambios en un dispositivo aparecen en los otros unos minutos después — o puedes activar una sincronización manual para una actualización inmediata."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yleensä noin 10 minuutin kuluessa. KnotQ synkronoidaan taustalla, joten muutokset yhdellä laitteella näkyvät muilla muutamaa minuuttia myöhemmin — tai voit käynnistää synkronoinnin manuaalisesti välittömän päivityksen saamiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Généralement en environ 10 minutes. KnotQ se synchronise en arrière-plan, donc les modifications sur un appareil apparaissent sur vos autres appareils quelques minutes plus tard — ou vous pouvez déclencher manuellement une synchronisation pour une mise à jour immédiate."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בדרך כלל תוך כ-10 דקות. KnotQ מסנכרן ברקע, כך שהשינויים בהתקן אחד מופיעים בהתקנים האחרים שלך כמה דקות מאוחר — או אתה יכול להפעיל סנכרון ידני לעדכון מיידי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आमतौर पर लगभग 10 मिनट के भीतर। KnotQ पृष्ठभूमि में सिंक करता है, इसलिए एक डिवाइस पर परिवर्तन कुछ मिनट बाद आपके अन्य पर दिखाई देते हैं — या आप तुरंत अपडेट के लिए मैन्युअल रूप से सिंक ट्रिगर कर सकते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Általában körülbelül 10 percen belül. A KnotQ a háttérben szinkronizál, így az egyik eszköz módosításai néhány perccel később megjelennek a másikon — vagy manuálisan indíthat szinkronizálást azonnali frissítéshez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biasanya dalam waktu sekitar 10 menit. KnotQ disinkronkan di latar belakang, jadi perubahan di satu perangkat muncul di perangkat lain Anda beberapa menit kemudian — atau Anda dapat memicu sinkronisasi secara manual untuk pembaruan langsung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di solito entro circa 10 minuti. KnotQ si sincronizza in background, quindi le modifiche su un dispositivo vengono visualizzate sugli altri pochi minuti dopo — oppure puoi attivare una sincronizzazione manuale per un aggiornamento immediato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常、約10分以内。KnotQはバックグラウンドで同期するため、1つのデバイスの変更は数分後に他のデバイスに表示されます。または、手動で同期をトリガーして即座に更新できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보통 약 10분 이내입니다. KnotQ는 백그라운드에서 동기화되므로 한 디바이스의 변경 사항이 다른 디바이스에 몇 분 후에 표시되거나 즉시 업데이트를 위해 동기화를 수동으로 트리거할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biasanya dalam sekitar 10 menit. KnotQ disinkronkan di latar belakang, jadi perubahan pada satu perangkat muncul di perangkat lain Anda beberapa menit kemudian — atau Anda dapat memicu sinkronisasi secara manual untuk pembaruan segera."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vanligvis innen omtrent 10 minutter. KnotQ synkroniseres i bakgrunnen, så endringer på en enhet vises på dine andre enheter noen minutter senere – eller du kan utløse en synkronisering manuelt for en umiddelbar oppdatering."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meestal binnen ongeveer 10 minuten. KnotQ synchroniseert op de achtergrond, dus wijzigingen op één apparaat verschijnen na een paar minuten op je anderen — of je kunt handmatig synchronisatie activeren voor direct bijwerken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwykle w ciągu około 10 minut. KnotQ synchronizuje się w tle, więc zmiany na jednym urządzeniu pojawiają się na twoich pozostałych urządzeniach kilka minut później — lub możesz ręcznie wyzwolić synchronizację w celu natychmiastowej aktualizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geralmente em cerca de 10 minutos. KnotQ sincroniza em segundo plano, então as alterações em um dispositivo aparecem em seus outros em poucos minutos — ou você pode disparar uma sincronização manualmente para uma atualização imediata."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalmente dentro de cerca de 10 minutos. O KnotQ sincroniza em segundo plano, portanto as alterações num dispositivo aparecem nos seus outros alguns minutos depois — ou pode ativar uma sincronização manualmente para uma atualização imediata."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De obicei în aproximativ 10 minute. KnotQ se sincronizează în fundal, deci modificările pe un dispozitiv apar pe celelalte în câteva minute — sau puteți declanșa o sincronizare manual pentru o actualizare imediată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обычно примерно за 10 минут. KnotQ синхронизируется в фоне, поэтому изменения на одном устройстве появляются на ваших других устройствах через несколько минут — или вы можете запустить синхронизацию вручную для немедленного обновления."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvyčajne približne za 10 minút. KnotQ sa synchronizuje na pozadí, takže zmeny na jednom zariadení sa objavia na ostatných o pár minút neskôr — alebo si môžete synchronizáciu spustiť ručne na okamžitú aktualizáciu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vanligtvis inom ungefär 10 minuter. KnotQ synkroniseras i bakgrunden, så ändringar på en enhet visas på dina andra enheter några minuter senare — eller du kan utlösa en synkronisering manuellt för en omedelbar uppdatering."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปกติจะอยู่ในราวเวลา 10 นาที KnotQ ซิงค์ในพื้นหลัง ดังนั้นการเปลี่ยนแปลงบนอุปกรณ์หนึ่งจะปรากฏบนอุปกรณ์อื่น ๆ สองสามนาทีต่อมา หรือคุณสามารถเรียกใช้การซิงค์ด้วยตนเองเพื่อการอัปเดตทันที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genellikle yaklaşık 10 dakika içinde. KnotQ arka planda senkronize olur, bu nedenle bir cihazda yapılan değişiklikler diğerlerinde birkaç dakika sonra görünür — veya anında güncelleme için senkronizasyonu el ile tetikleyebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звичайно в межах близько 10 хвилин. KnotQ синхронізується у фоні, тому зміни на одному пристрої з'являються на інших за кілька хвилин пізніше — або ви можете запустити синхронізацію вручну для негайного оновлення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thường là trong khoảng 10 phút. KnotQ đồng bộ ở chế độ nền, vì vậy các thay đổi trên một thiết bị sẽ xuất hiện trên các thiết bị khác của bạn vài phút sau — hoặc bạn có thể kích hoạt đồng bộ theo cách thủ công để cập nhật ngay lập tức."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常在大约 10 分钟内。KnotQ 在后台同步，所以一台设备上的更改会在几分钟后显示在您的其他设备上 — 或者您可以手动触发同步以进行即时更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常約 10 分鐘內。KnotQ 在背景進行同步，因此一個裝置上的變更會在數分鐘後出現在您的其他裝置上 — 或者您可以手動觸發同步以立即更新。"
          }
        }
      }
    },
