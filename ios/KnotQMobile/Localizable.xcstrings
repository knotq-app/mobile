    "web.guide.shortcuts.open_selected_search_result" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فتح نتيجة البحث المحددة أو تأكيد إعادة التسمية أو إغلاق نافذة الحدث"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevřít vybraný výsledek vyhledávání, potvrdit přejmenování nebo zavřít vyskakovací okno události"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn det valgte søgeresultat, bekræft omdøbning, eller luk et begivenhedspopup"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ausgewählte Suchergebnis öffnen, Umbenennung bestätigen oder Ereignis-Popup schließen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανοίξτε το επιλεγμένο αποτέλεσμα αναζήτησης, επιβεβαιώστε μετονομασία ή κλείστε ένα αναδυόμενο παράθυρο γεγονότος"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the selected search result, confirm rename, or close an event popup"
