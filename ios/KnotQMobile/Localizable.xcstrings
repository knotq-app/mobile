        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz KnotQ, przejdź do konta synchronizacji i wyślij ponownie wiadomość e-mail weryfikacyjną, aby uzyskać nowy link."
