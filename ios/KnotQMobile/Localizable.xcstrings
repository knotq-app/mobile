    "web.delete_account.questions_a" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لأي أسئلة حول حذف الحساب أو الاحتفاظ بالبيانات أو دعم KnotQ، أرسل بريدًا إلى"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud máte jakékoli otázky o smazání účtu, uchovávání dat nebo podporě KnotQ, pošlete e-mail"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For spørgsmål om kontosletning, dataopbevaring eller KnotQ-support skal du sende en email"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Fragen zur Kontolöschung, Datenspeicherung oder KnotQ-Unterstützung senden Sie eine E-Mail an"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για οποιαδήποτε ερώτηση σχετικά με τη διαγραφή λογαριασμού, τη διατήρηση δεδομένων ή την υποστήριξη KnotQ, στείλτε email στο"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For anything about account deletion, data retention, or KnotQ support, email"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cualquier cosa sobre eliminación de cuenta, retención de datos, o soporte de KnotQ, envía un correo a"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikesta tilin poistamisesta, tietojen säilytyksestä tai KnotQ-tuesta lähetä sähköpostia"
