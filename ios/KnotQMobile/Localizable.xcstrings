    "mobile.account_delete.code_prompt" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل الرمز المكون من 6 أرقام الذي أرسلناه إلى {email} لجدولة حذف حسابك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadejte 6ciferný kód, který jsme poslali na {email}, abyste naplánovali smazání vašeho účtu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indtast den 6-cifrede kode, vi sendte til {email}, for at planlægge sletning af din konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie den 6-stelligen Code ein, den wir an {email} gesendet haben, um die Löschung Ihres Kontos zu planen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εισάγετε τον 6ψήφιο κωδικό που στείλαμε στο {email} για να προγραμματίσετε τη διαγραφή του λογαριασμού σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter the 6-digit code we emailed to {email} to schedule deletion of your account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingresa el código de 6 dígitos que enviamos a {email} para programar la eliminación de tu cuenta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
