        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizujte schémy, rozvrhy, stav úloh a oznámenia cez mobilné zariadenie a pracovnú plochu. Prihláste sa, aby ste to zapnuli."
