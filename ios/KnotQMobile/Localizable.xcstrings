    "web.home.features.schemes.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ مساحة عمل تخطيط مبنية على خطط — مستندات منظمة بعناوين وخانات اختيار وعناصر متداخلة. اكتب مشروعًا بالطريقة التي تفكر فيها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ je plánovací pracovní prostor postaven na schématech — strukturované dokumenty s nadpisy, zaškrtávacími poli a vnořenými položkami. Napište projekt způsobem, jak si jej představujete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ er et planarbejdsområde bygget på skemaer — strukturerede dokumenter med overskrifter, afkrydsningsfelter og indlejrede elementer. Skriv et projekt, sådan som du tænker på det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ ist ein Planungs-Workspace, das auf Schemes aufgebaut ist — strukturierte Dokumente mit Überschriften, Kontrollkästchen und verschachtelten Elementen. Schreiben Sie ein Projekt, wie Sie darüber denken."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το KnotQ είναι ένας χώρος εργασίας σχεδιασμού κατασκευασμένο σε σχέδια — δομημένα έγγραφα με επικεφαλίδες, πλαίσια ελέγχου και ένθετα στοιχεία. Γράψτε ένα έργο όπως το σκέφτεστε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ is a planning workspace built on schemes — structured documents with headings, checkboxes, and nested items. Write a project the way you think about it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ es un espacio de trabajo de planificación basado en esquemas — documentos estructurados con encabezados, casillas de verificación y elementos anidados. Escribe un proyecto de la manera en que lo piensas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ on suunnittelutyötila, joka on rakennettu kaavioiden pohjalle — strukturoituja asiakirjoja otsikoilla, valintaruuduilla ja sisäkkäisillä kohteilla. Kirjoita projekti, kuten ajattelet siitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ est un espace de travail de planification construit sur des schémas — des documents structurés avec des en-têtes, des cases à cocher et des éléments imbriqués. Écrivez un projet comme vous le concevez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ היא מרחב עבודה תכנון בנוי על סכמות — מסמכים מובנים עם כותרות, תיבות סימון וקינון פריטים. כתוב פרויקט את הדרך שאתה חושב על זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ योजनाओं पर बनाया गया एक योजना वर्कस्पेस है — शीर्षक, चेकबॉक्स, और नेस्टेड आइटम के साथ संरचित दस्तावेज़। एक परियोजना को उसी तरह लिखें जैसे आप इसके बारे में सोचते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A KnotQ egy tervezési munkahely sémák alapján — strukturált dokumentumok fejlécekkel, jelölõnégyzetekkel és beágyazott tárgyakkal. Írjon projektet úgy, ahogy rá gondol."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ adalah ruang kerja perencanaan yang dibangun di atas skema — dokumen terstruktur dengan judul, kotak centang, dan item bertingkat. Tulis proyek dengan cara Anda memikirkannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ è uno spazio di lavoro di pianificazione costruito su schemi — documenti strutturati con intestazioni, caselle di controllo e elementi annidati. Scrivi un progetto come lo pensi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQは、スキーム上に構築された計画ワークスペースです — 見出し、チェックボックス、ネストされたアイテムを含む構造化されたドキュメント。プロジェクトの考え方を書きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ는 스킴에 기반한 계획 워크스페이스입니다 — 제목, 체크박스 및 중첩된 항목이 있는 구조화된 문서입니다. 프로젝트를 생각하는 방식대로 작성하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ adalah ruang kerja perencanaan yang dibangun di atas skema — dokumen terstruktur dengan judul, kotak centang, dan item bersarang. Tulis proyek sesuai cara Anda memikirkannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ er en planleggingsarbeitsflate bygget på skjemaer – strukturerte dokumenter med overskrifter, avmerkingsbokser og nestede elementer. Skriv et prosjekt slik du tenker på det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ is een planningswerkruimte gebouwd op schema's — gestructureerde documenten met koppen, selectievakjes en geneste items. Schrijf een project op de manier waarop je erover denkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ to obszar roboczy planowania zbudowany na schematach — strukturyzowanych dokumentach z nagłówkami, polami wyboru i zagnieżdżonymi elementami. Napisz projekt sposób, w jaki o nim myślisz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ é um workspace de planejamento construído em esquemas — documentos estruturados com títulos, caixas de seleção e itens aninhados. Escreva um projeto da forma como você pensa sobre ele."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O KnotQ é uma área de trabalho de planejamento construída sobre esquemas — documentos estruturados com títulos, caixas de seleção e itens aninhados. Escreva um projeto da forma como o pensa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ este un spațiu de lucru de planificare construit pe scheme — documente structurate cu titluri, casete de selectare și articole imbricate. Scrieți un proiect așa cum vă gândiți la el."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ — это рабочее пространство планирования, построенное на схемах — структурированные документы с заголовками, флажками и вложенными элементами. Напишите проект так, как вы о нём думаете."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ je pracovný priestor plánovania postavený na schémach — štruktúrovaných dokumentoch s nadpismi, zaškrtávacími políčkami a vnorovanými položkami. Napíšte projekt tak, ako si o ňom myslíte."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ är ett planeringsarbetsutrymme byggt på scheman — strukturerade dokument med rubriker, kryssrutor och kapslade objekt. Skriv ett projekt på det sätt du tänker på det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ เป็นพื้นที่ทำงานการวางแผนที่สร้างจากโครงการ — เอกสารที่มีโครงสร้างกับส่วนหัว ช่องทำเครื่องหมาย และรายการที่ซ้อนกัน เขียนโครงการในลักษณะที่คุณคิด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ, şemalar üzerine inşa edilmiş bir planlama çalışma alanıdır — başlıklar, onay kutuları ve iç içe öğeler içeren yapılandırılmış belgeler. Bir projeyi düşündüğünüz şekilde yazın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ — це робочий простір планування, побудований на схемах — структурованих документах із заголовками, прапорцями та вкладеними елементами. Напишіть проект так, як ви про нього думаєте."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ là một không gian làm việc lên kế hoạch được xây dựng trên các lược đồ — các tài liệu có cấu trúc với tiêu đề, hộp kiểm và các mục lồng nhau. Viết dự án theo cách bạn nghĩ về nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ 是一个基于方案的规划工作区 — 带有标题、复选框和嵌套项目的结构化文档。按照您的想法编写项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ 是一個建立在規劃方案上的規劃工作區 — 具有標題、複選框和巢狀項目的結構化文件。按照您的想法編寫專案。"
          }
        }
      }
    },
