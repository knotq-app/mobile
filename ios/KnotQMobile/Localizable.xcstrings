    "web.delete_account.store_subscription_b" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إلغاء الاشتراك الذي اشتريته من Google Play Store أو Apple App Store تلقائيًا. إذا اشتركت عبر متجر التطبيقات، قم بإلغاء الاشتراك مباشرة في إعدادات الاشتراك في متجر التطبيقات لإيقاف الرسوم المستقبلية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "automaticky zruší předplatné, které jste si koupili v Google Play Store nebo Apple App Store. Pokud jste se přihlásili prostřednictvím app storu, zrušte předplatné přímo v nastavení předplatného tohoto storu, abyste zastavili budoucí poplatky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "automatisk annullere et abonnement, du har købt gennem Google Play Store eller Apple App Store. Hvis du har abonneret via en app store, skal du annullere abonnementet direkte i den pågældende stores abonnementsindstillinger for at stoppe fremtidige debiteringer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " nicht automatisch ein Abonnement storniert, das Sie über den Google Play Store oder Apple App Store gekauft haben. Wenn Sie über einen App Store abonniert haben, stornieren Sie das Abonnement direkt in den Abonnement-Einstellungen dieses Stores, um zukünftige Gebühren zu vermeiden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "αυτόματα ακύρωση μιας συνδρομής που αγοράσατε μέσω του Google Play Store ή του Apple App Store. Αν συνδρομήθηκατε μέσω ενός app store, ακυρώστε τη συνδρομή απευθείας στις ρυθμίσεις συνδρομής του app store για να σταματήσετε τις μελλοντικές χρεώσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "automatically cancel a subscription you purchased through the Google Play Store or Apple App Store. If you subscribed through an app store, cancel the subscription directly in that store's subscription settings to stop future charges."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "no cancela automáticamente una suscripción que compraste a través de Google Play Store o Apple App Store. Si te suscribiste a través de una tienda de aplicaciones, cancela la suscripción directamente en la configuración de suscripción de esa tienda para detener los cargos futuros."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "automaattisesti peruuttaa Google Play Storesta tai Apple App Storesta ostamasi tilausta. Jos ostat tilauksen sovellussaatavuudesta, peruuta tilaus suoraan kyseisen kaupan tilausasetuksissa jatkautuvien veloitusten pysäyttämiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "annule pas automatiquement un abonnement que vous avez acheté via Google Play Store ou Apple App Store. Si vous vous êtes abonné via un magasin d'applications, annulez l'abonnement directement dans les paramètres d'abonnement de ce magasin pour arrêter les frais futurs."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא בטל באופן אוטומטי מנוי שקנית דרך Google Play Store או Apple App Store. אם נרשמת דרך חנות אפליקציות, בטל את המנוי ישירות בהגדרות המנוי של אותה חנות כדי לעצור חיובים עתידיים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्वचालित रूप से Google Play Store या Apple App Store के माध्यम से खरीदी गई सदस्यता को रद्द नहीं करता। यदि आपने ऐप स्टोर के माध्यम से सदस्यता ली है, तो भविष्य के शुल्क को रोकने के लिए सीधे उस स्टोर की सदस्यता सेटिंग में सदस्यता रद्द करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "automatikusan meghiúsítja a Google Play Áruházban vagy az Apple App Áruházban vásárolt előfizetést. Ha egy alkalmazás áruházon keresztül iratkoztál fel, közvetlenül az adott áruház előfizetési beállításaiban szakítsd meg az előfizetést a jövőbeli díjak megakadályozásához."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "secara otomatis membatalkan langganan yang Anda beli melalui Google Play Store atau Apple App Store. Jika Anda berlangganan melalui app store, batalkan langganan langsung di pengaturan langganan toko itu untuk menghentikan biaya di masa depan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "non annulla automaticamente un abbonamento che hai acquistato tramite Google Play Store o Apple App Store. Se hai effettuato l'iscrizione tramite un app store, annulla l'iscrizione direttamente nelle impostazioni di iscrizione di quell'app store per interrompere gli addebiti futuri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google PlayストアまたはApple App Store経由で購入したサブスクリプションが自動的にキャンセルされることはありません。アプリストア経由でサブスクリプションした場合、そのストアのサブスクリプション設定で直接キャンセルして、将来の請求を停止してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동으로 취소되지 않습니다. 앱 스토어를 통해 구독한 경우 해당 스토어의 구독 설정에서 직접 구독을 취소하여 향후 청구를 중단하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "secara otomatis membatalkan langganan yang Anda beli melalui Google Play Store atau Apple App Store. Jika Anda berlangganan melalui app store, batalkan langganan langsung di pengaturan langganan toko tersebut untuk menghentikan biaya di masa depan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ikke automatisk kansellere et abonnement du kjøpte gjennom Google Play Store eller Apple App Store. Hvis du abonnerte gjennom en app-butikk, kansellerer du abonnementet direkte i den butikkens abonnementsinnstillinger for å stoppe fremtidige koster."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "automatisch een abonnement annuleren dat je via de Google Play Store of Apple App Store hebt gekocht. Als je je via een app store hebt geabonneerd, annuleer het abonnement dan rechtstreeks in de abonnementsinstellingen van die winkel om toekomstige kosten te stoppen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "automatycznie anuluje subskrypcję zakupioną przez Google Play Store lub Apple App Store. Jeśli zasubskrybowałeś za pośrednictwem sklepu z aplikacjami, anuluj subskrypcję bezpośrednio w ustawieniach subskrypcji tego sklepu, aby zatrzymać przyszłe opłaty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cancela automaticamente uma assinatura que você adquiriu através da Google Play Store ou Apple App Store. Se você se inscreveu através de uma loja de aplicativos, cancele a assinatura diretamente nas configurações de assinatura dessa loja para parar de receber cobranças futuras."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cancelar automaticamente uma subscrição que adquiriu através da Google Play Store ou Apple App Store. Se subscreveu através de uma loja de aplicações, cancele a subscrição diretamente nas definições de subscrição dessa loja para interromper futuras cobranças."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "anulează automat un abonament pe care l-ați cumpărat prin Google Play Store sau Apple App Store. Dacă v-ați abonat prin intermediul unui app store, anulați abonamentul direct în setările de abonament ale respectivului magazin pentru a opri taxele viitoare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "автоматически отменит подписку, которую вы приобрели через Google Play Store или Apple App Store. Если вы подписались через app store, отмените подписку прямо в параметрах подписки этого магазина, чтобы остановить будущие платежи."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "automaticky nezruší predplatné, ktoré ste si kúpili cez Obchod Google Play alebo Obchod Apple App Store. Ak ste sa prihlásili prostredníctvom obchodu aplikácií, zrušte predplatné priamo v nastaveniach predplatného daného obchodu, aby ste zabránili budúcim platbám."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "automatiskt avbryta en prenumeration du köpte via Google Play Store eller Apple App Store. Om du prenumererade via en appbutik, avbryt prenumerationen direkt i den butikens prenumerationsinställningar för att stoppa framtida debiteringar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยกเลิกการสมัครที่คุณซื้อผ่าน Google Play Store หรือ Apple App Store โดยอัตโนมัติ หากคุณสมัครผ่านแอป store ให้ยกเลิกการสมัครโดยตรงในการตั้งค่าการสมัครของ store นั้นเพื่อหยุดการเรียกเก็บเงินในอนาคต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play Store veya Apple App Store aracılığıyla satın aldığınız aboneliği otomatik olarak iptal etmez. Bir uygulama mağazası aracılığıyla abone olduysa, gelecekteki ücretleri durdurmak için o mağazanın abonelik ayarlarında doğrudan aboneliği iptal edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "автоматично НЕ скасує підписку, яку ви придбали в Google Play Store або Apple App Store. Якщо ви підписались через магазин програм, скасуйте підписку безпосередньо в параметрах підписки цього магазину, щоб уникнути майбутніх списань."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tự động hủy đăng ký mà bạn đã mua thông qua Google Play Store hoặc Apple App Store. Nếu bạn đã đăng ký thông qua cửa hàng ứng dụng, hãy hủy đăng ký trực tiếp trong cài đặt đăng ký của cửa hàng đó để dừng các khoản phí trong tương lai."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动取消您通过 Google Play Store 或 Apple App Store 购买的订阅。如果您通过应用商店订阅，请直接在该商店的订阅设置中取消订阅以停止将来的收费。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動取消您透過 Google Play Store 或 Apple App Store 購買的訂閱。如果您透過應用程式商店訂閱，請直接在該商店的訂閱設定中取消訂閱，以停止未來的費用。"
          }
        }
      }
