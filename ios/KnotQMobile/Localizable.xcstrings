    "web.account.billing_cancelled_apple_ends" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم إلغاء الاشتراك. تبقى المزامنة نشطة حتى نهاية الفترة الحالية. أعد تفعيله من اشتراكات حسابك في Apple."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše předplatné je zrušeno. Synchronizace zůstane aktivní až do konce aktuálního období. Znovu ji povolte ze svého účtu Apple."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit abonnement er annulleret. Synkronisering forbliver aktiv til periodens afslutning. Genaktiver det fra dine Apple-kontoabonnementer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Abonnement wurde storniert. Sync bleibt aktiv, bis der aktuelle Zeitraum endet. Aktivieren Sie es über Ihre Apple-Kontoabos erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η συνδρομή σας ακυρώθηκε. Ο συγχρονισμός παραμένει ενεργός έως το τέλος της τρέχουσας περιόδου. Ενεργοποιήστε το ξανά από τις συνδρομές Apple Account σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your subscription is cancelled. Sync stays active until the current period ends. Re-enable it from your Apple account subscriptions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu suscripción está cancelada. La sincronización permanece activa hasta que termine el período actual. Vuelve a habilitarla desde tus suscripciones de cuenta de Apple."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilauksesi on peruutettu. Synkronointi pysyy aktiivisena nykyisen jakson päättymiseen asti. Ota se uudelleen käyttöön Apple-tilin tilauksista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre abonnement est annulé. La synchronisation reste active jusqu'à la fin de la période actuelle. Réactivez-le depuis les abonnements de votre compte Apple."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המנוי שלך בוטל. הסנכרון נשאר פעיל עד סוף התקופה הנוכחית. הפעל אותו מחדש מרשומות החשבון של Apple."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी सदस्यता रद्द कर दी गई है। सिंक वर्तमान अवधि के अंत तक सक्रिय रहता है। अपने Apple खाते की सदस्यता से इसे फिर से सक्षम करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az előfizetés törlésre került. A szinkronizálás az aktuális időszak végéig aktív marad. Engedélyezze újra az Apple-fiók előfizetéseiből."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langganan Anda dibatalkan. Sinkronisasi tetap aktif hingga periode saat ini berakhir. Aktifkan kembali dari langganan akun Apple Anda."
