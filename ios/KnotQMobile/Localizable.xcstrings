    },
    "web.account.sync_detail_verify_needed" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقق من بريدك الإلكتروني قبل أن تتمكن من الاشتراك — أرسلنا رابطاً إلى بريدك الإلكتروني عند التسجيل. يتم تشغيل مزامنة KnotQ بمجرد تأكيدها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ověřte svůj e-mail, abyste se mohli přihlásit k odběru – poslali jsme vám odkaz na e-mail vašeho účtu, když jste se zaregistrovali. KnotQ Sync se zapne, jakmile bude potvrzeno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekræft din e-mail før du kan abonnere — vi sendte et link til din kontos e-mail da du tilmeldte dig. KnotQ Sync aktiveres når det er bekræftet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überprüfen Sie Ihre E-Mail, bevor Sie abonnieren – wir haben einen Link an Ihre Konto-E-Mail gesendet, als Sie sich anmeldeten. KnotQ Sync wird nach der Bestätigung aktiviert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιβεβαιώστε το email σας πριν μπορέσετε να κάνετε συνδρομή — στείλαμε έναν σύνδεσμο στο email του λογαριασμού σας όταν κάνατε εγγραφή. Το KnotQ Sync ενεργοποιείται μόλις επιβεβαιωθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verify your email before you can subscribe — we sent a link to your account email when you signed up. KnotQ Sync turns on once it's confirmed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica tu email antes de poder suscribirte — enviamos un enlace a tu email de cuenta cuando te registraste. KnotQ Sync se activa una vez que esté confirmado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vahvista sähköpostiosoitteesi ennen kuin voit tilata — lähetimme linkin tilin sähköpostiin kun kirjauduit. KnotQ Sync ottuu käyttöön, kun se on vahvistettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez votre adresse e-mail avant de pouvoir vous abonner — nous avons envoyé un lien à votre adresse e-mail de compte quand vous vous êtes inscrit. KnotQ Sync s'active dès que c'est confirmé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אמת את הדוא״ל שלך לפני שתוכל להרשם — שלחנו קישור לדוא״ל החשבון שלך בעת ההרשמה. KnotQ Sync מופעל ברגע שאתה מאום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सदस्यता लेने से पहले अपना ईमेल सत्यापित करें — जब आपने साइन अप किया तो हमने आपके खाते के ईमेल में एक लिंक भेजा। KnotQ Sync सत्यापित होने के बाद चालू हो जाता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az e-mail-cím ellenőrzése az előfizetés előtt szükséges — az aláíráskor linket küldtünk a fiók e-mail-jéhez. A KnotQ szinkronizálás bekapcsolódik az ellenőrzés után."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifikasi email Anda sebelum Anda dapat berlangganan — kami mengirim tautan ke email akun Anda saat Anda mendaftar. KnotQ Sync dihidupkan setelah dikonfirmasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica la tua email prima di poterti abbonare — ti abbiamo inviato un link al tuo indirizzo email quando ti sei iscritto. KnotQ Sync si attiva una volta confermato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購読する前にメールを確認してください—サインアップ時にアカウントメールにリンクを送信しました。確認されるとKnotQ Syncが有効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구독하기 전에 이메일을 확인하세요 - 가입할 때 계정 이메일로 링크를 보냈습니다. KnotQ 동기화는 확인 후 활성화됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sahkan e-mel anda sebelum anda boleh melanggan — kami menghantar pautan ke e-mel akaun anda ketika anda mendaftar. KnotQ Sync dihidupkan setelah disahkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekreft e-posten din før du kan abonnere – vi sendte en lenke til kontoe-posten din da du registrerte deg. KnotQ Sync slår seg på når det er bekreftet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifieer je e-mailadres voordat je je kunt abonneren — wij hebben een link naar je accounte-mail verzonden toen je je aanmeldde. KnotQ Sync wordt ingeschakeld zodra het is bevestigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zweryfikuj swój e-mail, zanim będziesz mógł subskrybować — wysłaliśmy link na e-mail konta podczas rejestracji. KnotQ Synchronizacja włączy się po potwierdzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique seu email antes de se inscrever — enviamos um link para o email da sua conta quando você se inscreveu. O KnotQ Sync ativa assim que for confirmado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique o seu email antes de subscrever — enviámos uma ligação para o seu email de conta quando se inscreveu. KnotQ Sync ativa quando for confirmado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verificați-vă e-mailul înainte de a vă putea abona — v-am trimis un link la e-mailul contului atunci când v-ați înregistrat. KnotQ Sync se activează odată ce este confirmat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подтвердите свой адрес электронной почты перед подпиской — мы отправили ссылку на адрес электронной почты вашей учётной записи при регистрации. KnotQ Sync включится после подтверждения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overte svoju e-mailovú adresu predtým, ako sa budete môcť prihlásiť — pri registrácii sme vám poslali odkaz na e-mailovú adresu vášho účtu. KnotQ Sync sa zapne po potvrdení."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifiera din e-post innan du kan prenumerera — vi skickade en länk till din kontoe-post när du registrerade dig. KnotQ Sync aktiveras när det är bekräftat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยืนยันอีเมลของคุณก่อนที่คุณจะสมัครสมาชิก เราส่งลิงก์ไปยังอีเมลบัญชีของคุณเมื่อคุณลงทะเบียน KnotQ Sync เปิดใช้งานเมื่อได้รับการยืนยัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abone olmadan önce e-postanızı doğrulayın — kaydolduğunuzda hesap e-postanıza bir bağlantı gönderdik. KnotQ Senkronizasyonu onaylandıktan sonra açılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевірте свою електронну пошту перед підпискою — ми надіслали посилання на адресу електронної пошти вашого облікового запису, коли ви реєструвалися. KnotQ Синхронізація активується після підтвердження."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xác minh email của bạn trước khi bạn có thể đăng ký — chúng tôi đã gửi liên kết tới email tài khoản của bạn khi bạn đăng ký. KnotQ Sync bật sau khi được xác nhận."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "订阅前请验证您的电子邮件——我们在您注册时向您的账户电子邮件发送了链接。KnotQ 同步在确认后启用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訂閱前請驗證您的電子郵件 — 我們在您註冊時傳送了一個連結到您的帳戶電子郵件。一旦確認，KnotQ 同步就會開啟。"
          }
        }
      }
    },
