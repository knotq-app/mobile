    "web.home.faq.q7_answer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل KnotQ على macOS (Apple Silicon و Intel) و Windows و Linux، مع تطبيقات جوال لـ iOS و Android. يمكن مزامنة مساحة عملك عبر جميعها باستخدام KnotQ Sync."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ běží na macOS (Apple Silicon a Intel), Windows a Linuxu s mobilními aplikacemi pro iOS a Android. Váš pracovní prostor se může synchronizovat mezi všemi pomocí synchronizace KnotQ."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ kører på macOS (Apple Silicon og Intel), Windows og Linux, med mobile apps til iOS og Android. Dit arbejdsområde kan synkroniseres på alle med KnotQ Sync."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ läuft auf macOS (Apple Silicon und Intel), Windows und Linux, mit Mobile Apps für iOS und Android. Ihr Workspace kann mit KnotQ Sync über alle hinweg synchronisiert werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το KnotQ τρέχει στο macOS (Apple Silicon και Intel), Windows και Linux, με εφαρμογές κινητού για iOS και Android. Ο χώρος εργασίας σας μπορεί να συγχρονιστεί σε όλα με το KnotQ Sync."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ runs on macOS (Apple Silicon and Intel), Windows, and Linux, with mobile apps for iOS and Android. Your workspace can sync across all of them with KnotQ Sync."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ se ejecuta en macOS (Apple Silicon e Intel), Windows y Linux, con aplicaciones móviles para iOS y Android. Tu espacio de trabajo puede sincronizarse en todos ellos con KnotQ Sync."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ toimii macOS:ssa (Apple Silicon ja Intel), Windowsissa ja Linuxissa, mobiilisovelluksilla iOS:lle ja Androidille. Työtilasi voidaan synkronoida kaikkien niiden välillä KnotQ Syncin avulla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ s'exécute sur macOS (Apple Silicon et Intel), Windows et Linux, avec des applications mobiles pour iOS et Android. Votre espace de travail peut se synchroniser sur tous ceux-ci avec KnotQ Sync."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ רץ ב-macOS (Apple Silicon וIntel), Windows וLinux, עם אפליקציות סלולר ל-iOS וAndroid. מרחב העבודה שלך יכול לסנכרן על פני כל אלה עם KnotQ Sync."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ macOS (Apple Silicon और Intel), Windows, और Linux पर चलता है, iOS और Android के लिए मोबाइल ऐप्स के साथ। आपका वर्कस्पेस KnotQ सिंक के साथ उन सभी में सिंक कर सकता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A KnotQ macOS-en (Apple Silicon és Intel), Windows-on és Linux-en fut, iOS és Android mobil alkalmazásokkal. Az Ön munkahely az összes között szinkronizálható a KnotQ Sync-kel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ berjalan di macOS (Apple Silicon dan Intel), Windows, dan Linux, dengan aplikasi seluler untuk iOS dan Android. Ruang kerja Anda dapat disinkronkan di semuanya dengan KnotQ Sync."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ gira su macOS (Apple Silicon e Intel), Windows e Linux, con app mobile per iOS e Android. Il tuo workspace può sincronizzarsi su tutti loro con KnotQ Sync."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQはmacOS（Apple SiliconおよびIntel）、Windows、Linuxで実行され、iOS and Androidのモバイルアプリが付属しています。ワークスペースはKnotQ Syncでそのすべてを同期できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ는 macOS(Apple Silicon 및 Intel), Windows 및 Linux에서 실행되며 iOS 및 Android용 모바일 앱이 있습니다. 워크스페이스는 KnotQ Sync로 모든 항목에서 동기화할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ berjalan di macOS (Apple Silicon dan Intel), Windows, dan Linux, dengan aplikasi seluler untuk iOS dan Android. Ruang kerja Anda dapat disinkronkan di semua dengan Sinkronisasi KnotQ."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ kjører på macOS (Apple Silicon og Intel), Windows og Linux, med mobilapper for iOS og Android. Arbeitsflaten din kan synkroniseres på alle dem med KnotQ Sync."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ werkt op macOS (Apple Silicon en Intel), Windows en Linux, met mobiele apps voor iOS en Android. Je werkruimte kan over alle met KnotQ Sync synchroniseren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ działa w systemie macOS (Apple Silicon i Intel), Windows i Linux, z aplikacjami mobilnymi dla iOS i Android. Twój obszar roboczy może synchronizować się na wszystkich z KnotQ Sync."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O KnotQ é executado no macOS (Apple Silicon e Intel), Windows e Linux, com aplicativos móveis para iOS e Android. Seu workspace pode sincronizar em todos eles com KnotQ Sync."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O KnotQ funciona no macOS (Apple Silicon e Intel), Windows e Linux, com aplicações móveis para iOS e Android. A sua área de trabalho pode sincronizar-se em todos eles com o KnotQ Sync."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ rulează pe macOS (Apple Silicon și Intel), Windows și Linux, cu aplicații mobile pentru iOS și Android. Spațiul dvs. de lucru poate fi sincronizat pe toate cu KnotQ Sync."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ работает на macOS (Apple Silicon и Intel), Windows и Linux, с мобильными приложениями для iOS и Android. Ваше рабочее пространство может синхронизироваться на все из них с помощью KnotQ Sync."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ beží na macOS (Apple Silicon a Intel), Windows a Linuxe, s mobilnými aplikáciami pre iOS a Android. Váš pracovný priestor sa môže synchronizovať naprieč všetkými pomocou KnotQ Sync."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ körs på macOS (Apple Silicon och Intel), Windows och Linux, med mobilappar för iOS och Android. Ditt arbetsutrymme kan synkroniseras på alla med KnotQ Sync."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ ทำงานบน macOS (Apple Silicon และ Intel) Windows และ Linux พร้อมแอปมือถือสำหรับ iOS และ Android พื้นที่ทำงานของคุณสามารถซิงค์ทั่วทั้งหมดด้วย KnotQ Sync"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ, macOS (Apple Silicon ve Intel), Windows ve Linux'ta çalışır; iOS ve Android için mobil uygulamaları vardır. Çalışma alanınız KnotQ Sync ile bunların tümünde senkronize olabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ працює на macOS (Apple Silicon та Intel), Windows та Linux, з мобільними програмами для iOS та Android. Ваш робочий простір може синхронізуватися на всіх них за допомогою синхронізації KnotQ."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ chạy trên macOS (Apple Silicon và Intel), Windows và Linux, với các ứng dụng di động cho iOS và Android. Không gian làm việc của bạn có thể đồng bộ trên tất cả chúng với KnotQ Sync."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ 在 macOS（Apple Silicon 和 Intel）、Windows 和 Linux 上运行，提供 iOS 和 Android 移动应用。您的工作区可以通过 KnotQ Sync 在所有这些上同步。"
