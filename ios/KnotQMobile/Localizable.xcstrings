    "web.home.faq.q4_answer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يخزن مخطط محلي أولاً بياناتك على جهازك أولاً بدلاً من خادم شخص آخر. يحافظ KnotQ على ملاحظاتك ومهامك والمواعيد النهائية والتقويم كملفات عادية تملكها، لذا يبقى التطبيق سريعًا وخاصًا وتوفرًا بدون اتصال."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plánovací systém místně první ukládá vaše data nejdřív na vašem vlastním zařízení, místo na serveru někoho jiného. KnotQ uchovává vaše poznámky, úkoly, termíny a kalendář jako prosté soubory, které vlastníte, takže aplikace zůstává rychlá, soukromá a dostupná offline."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En lokalt-først planlægger gemmer dine data på din egen enhed først i stedet for på en anden persons server. KnotQ holder dine noter, opgaver, deadlines og kalender som almindelige filer, du ejer, så appen forbliver hurtig, privat og tilgængelig offline."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein lokal-first Planer speichert Ihre Daten zunächst auf Ihrem eigenen Gerät, anstatt auf dem Server eines anderen. KnotQ hält Ihre Notizen, Aufgaben, Fristen und Kalender als einfache Dateien, die Sie besitzen, damit die App schnell, privat und offline verfügbar bleibt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένας σχεδιαστής με τοπικό πρώτο αποθηκεύει τα δεδομένα σας στη δική σας συσκευή πρώτα, παρά στον διακομιστή κάποιου άλλου. Το KnotQ κρατά τις σημειώσεις, τις εργασίες, τις προθεσμίες και το ημερολόγιό σας ως απλά αρχεία που ιδιοκτητεύετε, επομένως η εφαρμογή παραμένει γρήγορη, ιδιωτική και διαθέσιμη χωρίς σύνδεση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A local-first planner stores your data on your own device first, rather than on someone else’s server. KnotQ keeps your notes, tasks, deadlines, and calendar as plain files you own, so the app stays fast, private, and available offline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un planificador local-first almacena tus datos en tu propio dispositivo primero, en lugar de en el servidor de otra persona. KnotQ mantiene tus notas, tareas, fechas límite y calendario como archivos simples que eres dueño, para que la aplicación sea rápida, privada y disponible sin conexión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paikallinen suunnittelu tallentaa tiedot ensin omalle laitteellesi, ei jonkun muun palvelimelle. KnotQ pitää muistiinpanot, tehtävät, määräpäivät ja kalenterin tavallisina tiedostoina, jotka omistat, joten sovellus pysyy nopeana, yksityisenä ja saatavilla offline-tilassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un planificateur d'abord local stocke vos données d'abord sur votre propre appareil, plutôt que sur le serveur de quelqu'un d'autre. KnotQ conserve vos notes, tâches, délais et calendrier en tant que fichiers simples que vous possédez, ce qui fait que l'application reste rapide, privée et disponible hors ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תוכנית מקומית קדם אחסנת את הנתונים שלך בהתקן שלך תחילה, ולא בשרת של מישהו אחר. KnotQ שומר את ההערות שלך, המשימות, הדדליינים ולוח השנה כקבצים פשוטים שאתה בעלים, כך שהאפליקציה נשארת מהירה, פרטית וזמינה ללא חיבור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक स्थानीय-प्रथम योजनाकार आपके डेटा को आपके अपने डिवाइस पर पहले संग्रहीत करता है, किसी और के सर्वर पर नहीं। KnotQ आपके नोट्स, कार्य, समय सीमा, और कैलेंडर को सादी फ़ाइलों के रूप में रखता है जो आप स्वामित्व में हैं, इसलिए ऐप तेज़, निजी, और ऑफलाइन उपलब्ध रहता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A helyi-elsõ tervez az Ön adatait elõször az Ön eszközén tárolt, nem más szervere. A KnotQ az Ön jegyzeteit, feladatait, határidejét és naptárát egyszerû fájlokként tartja, így az alkalmazás gyors, privát és offline elérhetõ marad."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perencana lokal-pertama menyimpan data Anda di perangkat Anda terlebih dahulu, bukan di server orang lain. KnotQ menyimpan catatan, tugas, tenggat waktu, dan kalender Anda sebagai file biasa yang Anda miliki, sehingga aplikasi tetap cepat, pribadi, dan tersedia offline."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pianificatore local-first archivia i tuoi dati sul tuo dispositivo prima, piuttosto che sul server di qualcun altro. KnotQ mantiene le tue note, compiti, scadenze e calendario come file semplici che possiedi, in modo che l'app rimanga veloce, privata e disponibile offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルファースト プランナーは、他のサーバーではなく、最初にあなた自身のデバイスにデータを保存します。KnotQは、あなたが所有するプレーンファイルとしてメモ、タスク、期限、カレンダーを保持するため、アプリは高速、プライベート、オフラインで利用可能です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 우선 플래너는 다른 사람의 서버가 아닌 자신의 디바이스에 먼저 데이터를 저장합니다. KnotQ는 소유한 일반 파일로 노트, 작업, 기한 및 캘린더를 유지하므로 앱이 빠르고 개인적이며 오프라인으로 사용 가능합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perencana lokal-pertama menyimpan data Anda di perangkat Anda sendiri terlebih dahulu, bukan di server orang lain. KnotQ menyimpan catatan, tugas, tenggat waktu, dan kalender Anda sebagai file biasa yang Anda miliki, sehingga aplikasi tetap cepat, pribadi, dan tersedia secara offline."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En lokalt-først-planlegger lagrer dataene dine på din egen enhet først, i stedet for på noen andre sin tjener. KnotQ holder notatene, oppgavene, fristene og kalenderen dine som enkle filer du eier, slik at appen forblir rask, privat og tilgjengelig offline."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een planner die eerst lokaal werkt, slaat je gegevens eerst op je eigen apparaat op, in plaats van op iemand anders' server. KnotQ houdt je notities, taken, deadlines en agenda als gewone bestanden die je bezit, zodat de app snel, privé en offline beschikbaar blijft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planer lokalnie-pierwszy przechowuje Twoje dane na Twoim urządzeniu najpierw, a nie na czyimś serwerze. KnotQ przechowuje Twoje notatki, zadania, terminy i kalendarz jako zwykłe pliki, które posiadasz, aby aplikacja była szybka, prywatna i dostępna w trybie offline."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um planejador local primeiro armazena seus dados em seu próprio dispositivo primeiro, em vez de em um servidor de outra pessoa. KnotQ mantém suas notas, tarefas, prazos e calendário como arquivos simples que você possui, para que o aplicativo permaneça rápido, privado e disponível offline."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um planeador local-first armazena os seus dados no seu próprio dispositivo em primeiro lugar, em vez de no servidor de alguém. O KnotQ mantém as suas notas, tarefas, prazos e calendário como ficheiros simples que possui, portanto a aplicação mantém-se rápida, privada e disponível offline."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un planificator local-first stochează mai întâi datele dvs. pe propriul dvs. dispozitiv, în loc să le stocheze pe serverul cuiva altcineva. KnotQ vă păstrează notele, sarcinile, termenele limită și calendarul ca fișiere simple pe care le dețineți, astfel încât aplicația rămâne rapidă, privată și disponibilă offline."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Локально-первый планировщик хранит ваши данные на вашем собственном устройстве в первую очередь, а не на чужом сервере. KnotQ хранит ваши заметки, задачи, крайние сроки и календарь как простые файлы, которыми вы владеете, поэтому приложение остаётся быстрым, приватным и доступным в автономном режиме."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plánovač s miestnym prioritou najskôr ukladá vaše údaje na vaše zariadenie, nie na server niekoho iného. KnotQ uchovávajú vaše poznámky, úlohy, termíny a kalendár ako jednoduché súbory, ktoré vlastníte, takže aplikácia zostáva rýchla, súkromná a dostupná offline."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En lokalt först-planerare lagrar din data på din egen enhet först, snarare än på någon annans server. KnotQ håller dina anteckningar, uppgifter, deadlines och kalender som vanliga filer du äger, så appen förblir snabb, privat och tillgänglig offline."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แผนงานที่เป็นเครื่องหมายแรกท้องถิ่นจะเก็บข้อมูลของคุณบนอุปกรณ์ของคุณก่อน แม่นยำมากกว่าบนเซิร์ฟเวอร์ของผู้อื่น KnotQ เก็บบันทึก งาน เส้นตายและปฏิทินของคุณเป็นไฟล์ธรรมดาที่คุณเป็นเจ้าของ ดังนั้นแอปจึงเร็ว ส่วนตัว และพร้อมใช้งานแบบออฟไลน์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerel-ilk bir planlayıcı, verilerinizi başka birinin sunucusu yerine önce kendi cihazınızda depolar. KnotQ, notlarınızı, görevlerinizi, son tarihlerinizi ve takvimi sahibi olduğunuz düz dosyalar olarak tutar, böylece uygulama hızlı, özel ve çevrimdışı olarak kullanılabilir kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Планувальник локального розташування зберігає ваші дані спочатку на власному пристрої, а не на чужому сервері. KnotQ тримає ваші нотатки, завдання, крайні терміни та календар як звичайні файли, якими ви володієте, тому програма залишається швидкою, приватною й доступною в автономному режимі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một trình hoạch định cục bộ-trước tiên lưu trữ dữ liệu của bạn trên thiết bị của chính bạn trước, thay vì trên máy chủ của người khác. KnotQ giữ ghi chú, tác vụ, hạn chót và lịch của bạn dưới dạng các tệp đơn giản mà bạn sở hữu, vì vậy ứng dụng vẫn nhanh, riêng tư và có sẵn ngoại tuyến."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地优先的计划应用将您的数据首先存储在您自己的设备上，而不是他人的服务器上。KnotQ 将您的笔记、任务、截止日期和日历保存为您拥有的纯文本文件，因此该应用保持快速、隐私和离线可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本機優先的規劃器首先將您的資料儲存在您自己的裝置上，而不是他人的伺服器上。KnotQ 將您的筆記、任務、截止日期和日曆保留為您擁有的純文字檔案，因此應用程式始終快速、隱私且離線可用。"
          }
        }
      }
    },
