          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše predplatné je zrušené. Synchronizácia zostáva aktívna až do konca aktuálneho obdobia. Opätovne ju zapnite z predplatných svojho Apple účtu."
