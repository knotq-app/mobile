    "web.delete_account.kept_payment_records_trailing" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المحفوظة لدى موفر الدفع الخاص بنا، Lemon Squeezy، يتم الاحتفاظ بها وفقًا لشروطهم الخاصة ومتطلبات الضرائب والمحاسبة، منفصلة عن KnotQ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "vedené naším poskytovatelem plateb, Lemon Squeezy, se uchovávají podle jejich vlastních podmínek a daňových/účetních požadavků, oddělené od KnotQ."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "opbevaret af vores betalingsudbyder Lemon Squeezy, bevares under deres egne vilkår og skatte-/regnskabskrav, adskilt fra KnotQ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "von unserem Zahlungsanbieter Lemon Squeezy werden nach deren eigenen Bedingungen und steuer-/buchhalterischen Anforderungen separat von KnotQ aufbewahrt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "που διατηρούνται από τον πάροχο πληρωμών μας, Lemon Squeezy, διατηρούνται σύμφωνα με τους δικούς τους όρους και απαιτήσεις φόρων/λογιστικής, ξεχωριστά από το KnotQ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "held by our payment provider, Lemon Squeezy, are retained under their own terms and tax/accounting requirements, separate from KnotQ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
