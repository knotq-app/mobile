            "value" : "Ruang kerja tersinkronisasi Anda: skema, folder, tugas, entri kalender, dan entri Kalender Google yang diimpor yang merupakan bagian dari ruang kerja tersinkronisasi Anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbeitsflaten din som ble synkronisert: skjemaer, mapper, oppgaver, kalenderoppføringer og alle importerte Google Calendar-oppføringer som var en del av arbeitsflaten din som ble synkronisert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gesynchroniseerde werkruimte: schema's, mappen, taken, agendavermeldingen en alle geïmporteerde Google Calendar-vermeldingen die deel uitmaakten van je gesynchroniseerde werkruimte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój zsynchronizowany obszar roboczy: schematy, foldery, zadania, wpisy w kalendarzu i wszelkie zaimportowane wpisy z Google Calendar, które były częścią Twojego zsynchronizowanego obszaru roboczego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu workspace sincronizado: esquemas, pastas, tarefas, entradas de calendário e qualquer entrada do Google Calendar importada que fazia parte do seu workspace sincronizado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua área de trabalho sincronizada: esquemas, pastas, tarefas, entradas de calendário e quaisquer entradas do Google Calendar importadas que fizeram parte da sua área de trabalho sincronizada."
          }
        },
