    "web.home.faq.q5_answer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ مبني على خطط — مستندات بنمط Markdown. أضف تاريخ بداية أو تاريخ نهاية أو كليهما لأي سطر ويصبح عنصر تقويم: حدث أو مهمة أو تذكير. كل ما تجدوله يظهر في عرض أسبوع واحد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ je postaven na schématech — dokumentech ve stylu markdownu. Přidejte počáteční datum, koncové datum nebo obojí na jakýkoli řádek a stane se položkou kalendáře: událostí, úkolem nebo připomenutím. Všechno, co naplánujete, se zobrazí v jednom pohledu na týden."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ er bygget på skemaer — markdown-stilsdokumenter. Tilføj en startdato, en slutdato eller begge dele til en hvilken som helst linje, og det bliver et kalenderelement: en begivenhed, en opgave eller en påmindelse. Alt du planlægger, vises i én ugevisning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ basiert auf Schemes — markdown-ähnliche Dokumente. Fügen Sie ein Startdatum, ein Enddatum oder beides zu einer Zeile hinzu und es wird zu einem Kalenderelement: ein Ereignis, eine Aufgabe oder eine Erinnerung. Alles, was Sie einplanen, wird in einer Wochenansicht angezeigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το KnotQ είναι κατασκευασμένο σε σχέδια — έγγραφα σαν markdown. Προσθέστε ημερομηνία έναρξης, ημερομηνία λήξης ή και τα δύο σε οποιαδήποτε γραμμή και γίνεται στοιχείο ημερολογίου: γεγονός, ανάθεση ή υπενθύμιση. Τα πάντα που προγραμματίζετε εμφανίζονται σε μια προβολή εβδομάδας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ is built on schemes — markdown-style documents. Add a start date, an end date, or both to any line and it becomes a calendar item: an event, an assignment, or a reminder. Everything you schedule shows up in one week view."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ se basa en esquemas — documentos tipo markdown. Agrega una fecha de inicio, una fecha de fin, o ambas a cualquier línea y se convierte en un elemento de calendario: un evento, una asignación, o un recordatorio. Todo lo que programas aparece en una vista semanal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ on rakennettu kaavioiden pohjalle — markdown-tyylisille asiakirjoille. Lisää alkamispäivämäärä, päättymispäivämäärä tai molemmat mihin tahansa riviin ja se tulee kalenterikohteeksi: tapahtuma, tehtävä tai muistutus. Kaikki, mitä aikataulutit, näkyy yhdessä viikon näkymässä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ est construit sur des schémas — des documents de style markdown. Ajoutez une date de début, une date de fin ou les deux à n'importe quelle ligne et elle devient un élément de calendrier : un événement, une tâche ou un rappel. Tout ce que vous planifiez apparaît dans une seule vue hebdomadaire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ בנוי על סכמות — מסמכים בסגנון markdown. הוסף תאריך התחלה, תאריך סיום, או שניהם לכל שורה והוא הופך לפריט לוח שנה: אירוע, הקצאה או תזכורת. הכל שאתה מזמן מציג בתצוגה שבועית אחת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ योजनाओं पर बनाया गया है — मार्कडाउन-शैली दस्तावेज़। किसी भी पंक्ति में शुरुआत की तारीख, अंत की तारीख, या दोनों जोड़ें और यह एक कैलेंडर आइटम बन जाता है: एक इवेंट, एक असाइनमेंट, या एक रिमाइंडर। आप जो कुछ भी शेड्यूल करते हैं वह एक सप्ताह के दृश्य में दिखाई देता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A KnotQ sémák alapján épül — markdown stílusú dokumentumok. Adjon hozzá kezdési dátumot, befejezési dátumot vagy mindkettõt bármelyik sorra, és az naptári tárgy lesz: esemény, feladat vagy emlékeztetõ. Minden, amit ütemez, megjelenik egy heti nézetben."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ dibangun di atas skema — dokumen gaya markdown. Tambahkan tanggal mulai, tanggal akhir, atau keduanya ke baris apa pun dan itu menjadi item kalender: acara, penugasan, atau pengingat. Semua yang Anda jadwalkan muncul dalam satu tampilan minggu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ è costruito su schemi — documenti di stile markdown. Aggiungi una data di inizio, una data di fine, o entrambe a qualsiasi riga e diventa un elemento del calendario: un evento, un compito o un promemoria. Tutto ciò che pianifichi appare in una singola visualizzazione settimanale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQはスキーム上に構築されています — マークダウンスタイルのドキュメント。任意の行に開始日、終了日、またはその両方を追加すると、カレンダーアイテムになります: イベント、課題、またはリマインダー。スケジュールするすべてが1つの週表示に表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ는 마크다운 스타일 문서인 스킴을 기반으로 구축됩니다. 모든 줄에 시작 날짜, 종료 날짜 또는 둘 다를 추가하면 이벤트, 할당 또는 알림이 되는 캘린더 항목이 됩니다. 예약한 모든 항목은 한 주간 보기에 나타납니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ dibangun di atas skema — dokumen gaya markdown. Tambahkan tanggal mulai, tanggal akhir, atau keduanya ke baris apa pun dan menjadi item kalender: acara, penugasan, atau pengingat. Semua yang Anda jadwalkan muncul dalam satu tampilan mingguan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ er bygget på skjemaer – markdown-lignende dokumenter. Legg til en startdato, en sluttdato eller begge deler til en hvilken som helst linje og den blir et kalenderelement: en begivenhet, en oppgave eller en påminnelse. Alt du planlegger vises i en ukeoversikt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ is gebouwd op schema's — markdown-achtige documenten. Voeg een startdatum, einddatum of beide toe aan elke regel en deze wordt een agendaitem: een evenement, taak of herinnering. Alles wat je plant verschijnt in één weekweergave."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ jest zbudowany na schematach — dokumentach w stylu markdown. Dodaj datę rozpoczęcia, datę zakończenia lub obie do dowolnej linii, aby stało się elementem kalendarza: zdarzeniem, przypisaniem lub przypomnieniem. Wszystko, co planujesz, pojawia się w jednym widoku tygodniowym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O KnotQ é construído em esquemas — documentos no estilo markdown. Adicione uma data de início, uma data de término ou ambas a qualquer linha e ela se torna um item de calendário: um evento, uma atribuição ou um lembrete. Tudo que você agenda aparece em uma visualização de semana."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O KnotQ é construído sobre esquemas — documentos de estilo markdown. Adicione uma data de início, uma data de fim, ou ambas a qualquer linha e ela torna-se num item de calendário: um evento, uma atribuição ou um lembrete. Tudo o que agenda aparece numa única vista semanal."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ este construit pe scheme — documente de stil markdown. Adăugați o dată de început, o dată de sfârşit, sau amândouă pe orice linie și devine un articol de calendar: un eveniment, o sarcină sau un memento. Tot ceea ce programați apare într-o singură vizualizare săptămânală."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ построена на схемах — документах стиля разметки. Добавьте дату начала, дату окончания или обе к любой строке, и она становится элементом календаря: событием, заданием или напоминанием. Всё, что вы запланируете, отображается в одной еженедельной сетке."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ je vybudovaný na schémach — dokumentoch podobných markdownu. Akémukoľvek riadku pridajte dátum začatia, dátum ukončenia alebo oboje a stane sa z neho položkou kalendára: udalosťou, úlohou alebo pripomienkou. Všetko, čo si naplánujete, sa zobrazuje v jednom týždňovom pohľade."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ är byggt på scheman — markdown-stiliga dokument. Lägg till ett startdatum, ett slutdatum eller båda till vilken rad som helst och det blir ett kalenderobjekt: en händelse, ett uppdrag eller en påminnelse. Allt du schemalägger visas i en veckoöversikt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ สร้างขึ้นจากโครงการ — เอกสารรูปแบบมาร์กดาวน์ เพิ่มวันเริ่มต้น วันสิ้นสุด หรือทั้งสองอย่างลงในบรรทัดใด ๆ และมันจะกลายเป็นรายการปฏิทิน: เหตุการณ์ งาน หรือการเตือน ทุกสิ่งที่คุณจัดตารางเวลาจะปรากฏในมุมมองสัปดาห์เดียว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ şemalar üzerine inşa edilmiştir — markdown tarzı belgeler. Herhangi bir satıra başlangıç tarihi, bitiş tarihi veya her ikisini ekleyin ve takvim öğesi haline gelir: etkinlik, ödev veya hatırlatıcı. Planladığınız her şey bir hafta görünümünde görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ побудований на схемах — документах, подібних до markdown. Додайте дату початку, дату закінчення або обидва в будь-який рядок, і він стає елементом календаря: подія, завдання або нагадування. Все, що ви запланюєте, з'являється в одному тижневому представленні."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ được xây dựng trên các lược đồ — các tài liệu kiểu markdown. Thêm ngày bắt đầu, ngày kết thúc hoặc cả hai vào bất kỳ dòng nào và nó sẽ trở thành mục lịch: sự kiện, bài tập hoặc nhắc nhở. Mọi thứ bạn lên lịch sẽ xuất hiện trong một chế độ xem tuần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ 基于方案 — 类似 markdown 的文档。将开始日期、结束日期或两者都添加到任何行，它就变成日历项目：事件、分配或提醒。您安排的所有事项都显示在一个周视图中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ 是建立在規劃方案上的 — Markdown 風格的文件。將開始日期、結束日期或兩者新增到任何行，它就變成了一個日曆項目：事件、指派或提醒。您排程的所有內容都會出現在一個周視圖中。"
          }
        }
      }
    },
