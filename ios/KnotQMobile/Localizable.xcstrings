    "settings.google_calendar.accounts_offline_notice" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد بيانات اعتماد حساب Google محلية. ستبقى التقاويم أدناه غير متصلة حتى تعيد الاتصال."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádné místní přihlašovací údaje k účtu Google. Kalendáře níže zůstanou offline, dokud se znovu nepřipojíte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen lokale Google-kontooplysninger. Kalenderne herunder forbliver offline, indtil du forbinder igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine lokalen Google-Kontoanmeldedaten. Kalender unten bleiben offline, bis Sie erneut verbunden sind."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχουν τοπικά διαπιστευτήρια λογαριασμού Google. Τα ημερολόγια παρακάτω θα παραμείνουν χωρίς σύνδεση έως ότου συνδεθείτε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No local Google account credentials. Calendars below will stay offline until you reconnect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin credenciales locales de Google. Los calendarios a continuación permanecerán sin conexión hasta que te reconectes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paikallista Google-tiliä ei ole. Kalenterit alla pysyvät offline-tilassa kunnes muodostat yhteyden uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas d'identifiants de compte Google locaux. Les calendriers ci-dessous resteront hors ligne jusqu'à ce que vous vous reconnectiez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין פרטי הכניסה של חשבון Google מקומי. לוחות שנה למטה יישארו לא מחוברים עד שתתחבר מחדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई स्थानीय Google खाता क्रेडेंशियल नहीं। नीचे दिए गए कैलेंडर तब तक ऑफ़लाइन रहेंगे जब तक आप फिर से कनेक्ट न करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs helyi Google-fiók hitelesítő adatai. Az alábbi naptárak offline maradnak, amíg újra nem csatlakozol."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada kredensial akun Google lokal. Kalender di bawah akan tetap offline hingga Anda menghubungkan kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna credenziale dell'account Google locale. I calendari sottostanti rimangono offline fino a quando non ti riconnetti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカル Google アカウント認証情報がありません。以下のカレンダーは再度接続するまでオフラインのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 Google 계정 자격증명이 없습니다. 아래 캘린더는 다시 연결할 때까지 오프라인 상태로 유지됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiada kelayakan akaun Google tempatan. Kalendar di bawah akan tetap luar talian sehingga anda sambung semula."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen lokale Google-kontolegitimasjoner. Kalenderene nedenfor vil forbli offline til du kobler til igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen lokale Google-accountgegevens. Onderstaande agenda's blijven offline tot je ze opnieuw verbindt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak lokalnych poświadczeń konta Google. Kalendarze poniżej będą offline, dopóki się nie ponownie połączysz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem credenciais locais de conta do Google. Os calendários abaixo permanecerão offline até você se reconectar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem credenciais de conta Google local. Os calendários abaixo permanecerão offline até que se reconecte."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fără acreditări locale de cont Google. Calendarele de mai jos vor rămâne offline până vă reconectați."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет локальных учетных данных Google. Календари ниже останутся в режиме «оффлайн», пока вы не восстановите соединение."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žiadne poverenia lokálneho účtu Google. Kalendáre nižšie budú offline, kým sa znova nepripojíte."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inga lokala Google-kontouppgifter. Kalendrar nedan förblir offline tills du återansluter."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีข้อมูลประจำตัวบัญชี Google ในเครื่อง ปฏิทินด้านล่างจะยังคงออฟไลน์จนกว่าคุณจะเชื่อมต่ออีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerel Google hesabı kimlik bilgileri yok. Aşağıdaki takvimler yeniden bağlanana kadar çevrimdışı kalacaktır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Немає локальних облікових даних Google. Календарі нижче залишатимуться в режимі офлайн, доки ви не повторно підключитеся."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có thông tin xác thực tài khoản Google cục bộ. Các lịch dưới đây sẽ ở ngoại tuyến cho đến khi bạn kết nối lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有本地 Google 账户凭据。下面的日历将保持离线直到您重新连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有本機 Google 帳戶認證。下方的日曆會保持離線狀態，直到您重新連接。"
          }
        }
      }
    },
