    "mobile.onboarding.calendar_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتوي التقويم على الأحداث والمهام والتذكيرات. اضغط لفترة طويلة لإضافة مهمة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš kalendář obsahuje události, úkoly a připomenutí. Dlouhým stisknutím přidáte úkol."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din kalender indeholder begivenheder, opgaver og påmindelser. Tryk og hold for at tilføje en opgave."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Kalender enthält Ereignisse, Aufgaben und Benachrichtigungen. Halten Sie gedrückt, um eine Aufgabe hinzuzufügen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ημερολόγιό σας περιέχει συμβάντα, εργασίες και υπενθυμίσεις. Πατήστε παρατεταμένα για να προσθέσετε μια εργασία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your calendar holds events, assignments, and reminders. Long-press to add a task."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu calendario contiene eventos, tareas y recordatorios. Presiona largo para añadir una tarea."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalenterisi sisältää tapahtumia, tehtäviä ja muistutuksia. Pitkä painallus lisää tehtävän."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre calendrier contient des événements, des affectations et des rappels. Appuyez longuement pour ajouter une tâche."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לוח השנה שלך מכיל אירועים, יעדים ותזכורות. לחץ ארוך לעמוד כדי להוסיף משימה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका कैलेंडर घटनाएं, कार्य, और अनुस्मारक रखता है। एक कार्य जोड़ने के लिए लंबे समय तक दबाएं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A naptárod eseményeket, hozzárendeléseket és emlékeztetőket tartalmaz. Hosszan nyomva hozzáadhat egy feladatot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalender Anda menyimpan acara, tugas, dan pengingat. Tekan lama untuk menambah tugas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo calendario contiene eventi, incarichi e promemoria. Premi a lungo per aggiungere un compito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カレンダーにはイベント、アサイン、リマインダーが含まれます。長く押してタスクを追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캘린더에는 이벤트, 할당 및 리마인더가 있습니다. 길게 눌러 작업을 추가하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalendar anda memegang acara, tugasan, dan peringatan. Tekan lama untuk menambah tugas."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalenderen inneholder arrangementet, oppgaver og remindere. Trykk lenge for å legge til en oppgave."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je agenda bevat gebeurtenissen, taken en herinneringen. Houd ingedrukt om een taak toe te voegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój kalendarz zawiera zdarzenia, zadania i przypomnienia. Długo naciśnij, aby dodać zadanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu calendário contém eventos, tarefas e lembretes. Pressione longamente para adicionar uma tarefa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu calendário contém eventos, tarefas e lembretes. Prima e mantenha para adicionar uma tarefa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendarul dvs. conține evenimente, atribuții și reamintiri. Apăsați lung pentru a adăuga o sarcină."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш календарь содержит события, задания и напоминания. Нажмите долго, чтобы добавить задачу."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš kalendár obsahuje podujatia, úlohy a pripomenutia. Podržte dlhšie na pridanie úlohy."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din kalender innehåller event, uppdrag och påminnelser. Håll ned för att lägga till en uppgift."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปฏิทินของคุณมีเหตุการณ์ งานมอบหมาย และการแจ้งเตือน กดนานเพื่อเพิ่มงาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takviminiz etkinlikleri, görevleri ve anımsatıcıları içerir. Görev eklemek için uzun basın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш календар містить Події, завдання і нагадування. Натисніть та утримуйте, щоб додати завдання."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lịch của bạn chứa các sự kiện, bài tập và nhắc nhở. Nhấn và giữ để thêm một tác vụ."
          }
        },
