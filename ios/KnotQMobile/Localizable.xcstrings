    "web.home.pitch.tile4_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العمل من صف يومي نظيف — تنتقل المهام غير المكتملة للأمام حتى لا يسقط شيء من خلالك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pracujte z čisté denní fronty — nedokončené úkoly se přenášejí tak, aby nic neuniklo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbejd fra en ren Daglig Kø — ufuldstændige opgaver overføres, så intet glider forbi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbeiten Sie von einer sauberen Daily Queue — unvollständige Aufgaben werden weitergegeben, sodass nichts übersehen wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δουλέψτε από μια καθαρή Ημερήσια Ουρά — οι ατελείς εργασίες μεταφέρονται προς τα εμπρός, ώστε τίποτα να μην ξεγλιτρήσει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Work from a clean Daily Queue — unfinished tasks carry forward so nothing slips through."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabaja desde una cola diaria limpia — las tareas sin terminar se transfieren para que nada se escape."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Työ puhtaasta päivittäisestä jonosta — keskeneräiset tehtävät siirtyvät eteenpäin, joten mitään ei pääse livahtamaan läpi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travaillez à partir d'une file d'attente quotidienne propre — les tâches inachevées se reportent donc rien ne se glisse."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עבוד מתור יומי נקי — משימות שלא בוצעו קדימה כדי שום דבר לא מחליק דרך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक स्वच्छ दैनिक कतार से काम करें — अधूरे कार्य आगे बढ़ते हैं ताकि कुछ भी न छूटे।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiszta Napi sorból dolgozzon — a befejezetlen feladatok továbbmegyenek, így semmi sem csúszik el."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekerja dari Antrean Harian yang bersih — tugas yang belum selesai dibawa maju sehingga tidak ada yang terlewat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lavora da una coda giornaliera pulita — i compiti non finiti si trasportano in avanti in modo che nulla scivoli attraverso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリーンなDaily Queueから作業します — 完了していないタスクが進み、何も漏れません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "깨끗한 일일 큐에서 작업하세요 — 미완료 작업이 계속되므로 아무것도 놓치지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerja dari Antrian Harian yang bersih — tugas yang belum selesai dibawa maju sehingga tidak ada yang terlewatkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbeid fra en ren Daily Queue – ufullstendige oppgaver tas med videre slik at ingenting glir gjennom."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werk vanuit een schone Daily Queue — onvoltooide taken gaan door zodat niets tussen wal en schip valt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pracuj z czystą Kolejką dzienną — niedokończone zadania przenoszą się dalej, aby nic nie przesunęło się."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabalhe a partir de uma Fila Diária limpa — tarefas inacabadas seguem em frente para que nada escape."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabalhe a partir de uma Fila Diária limpa — tarefas inacabadas transitam para que nada escorregue."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lucrați dintr-o Coadă de zi curată — sarcinile neterminate se duc mai departe, deci nimic nu se strecoară prin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работайте из чистой ежедневной очереди — незавершённые задачи переносятся вперёд, чтобы ничего не проскользнуло."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pracuj z čistej dennému fronte — nedokončené úlohy sa prenesú dopredu, takže nič neprekročí."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbeta från en ren Daily Queue — ofullständiga uppgifter överförs framåt så ingenting glider igenom."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำงานจากคิวรายวันที่สะอาด — งานที่ไม่เสร็จจะส่งต่อไปเพื่อไม่ให้มีอะไรลำลัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temiz bir Günlük Kuyruktan çalışın — tamamlanmamış görevler iletilir, böylece hiçbir şey unutulmuyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Робота з чистої щоденної черги — незавершені завдання переходять вперед, щоб нічого не змовилось."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Làm việc từ Hàng đợi Hàng ngày sạch — các tác vụ chưa hoàn thành được chuyển tiếp để không có gì bị bỏ qua."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从干净的日常队列中工作 — 未完成的任务会继续，所以没有任何遗漏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從乾淨的每日隊列工作 — 未完成的任務會結轉，這樣就不會有任何遺漏。"
          }
        }
      }
    },
