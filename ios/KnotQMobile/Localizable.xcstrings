    "mobile.subscription.disclosure_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اشتراك KnotQ Sync قابل للتجديد التلقائي يتم فرض رسومه من خلال حسابك في Google Play. يتجدد تلقائياً كل فترة ما لم تقم بالإلغاء قبل انقضاء 24 ساعة على الأقل من نهاية الفترة؛ يمكنك الإدارة أو الإلغاء في أي وقت في Google Play. يتم عرض السعر وفترة الفواتير على الشاشة التالية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ Sync je automaticky obnovované předplatné fakturované prostřednictvím vašeho účtu Google Play. Obnovuje se automaticky v každém období, pokud jej nezrušíte nejméně 24 hodin před koncem období; spravujte nebo zrušte kdykoli v Google Play. Cena a fakturační období se zobrazují na další obrazovce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ Sync er et automatisk fornyende abonnement faktureret gennem din Google Play-konto. Det fornys automatisk hver periode, medmindre du annullerer mindst 24 timer før perioden slutter; administrer eller annullér når som helst i Google Play. Prisen og faktureringsperioden vises på næste skærm."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ Sync ist ein automatisch erneuerbares Abonnement, das über Ihr Google Play-Konto abgerechnet wird. Es wird automatisch in jedem Zeitraum erneuert, es sei denn, Sie kündigen mindestens 24 Stunden vor Ende des Zeitraums. Sie können es jederzeit in Google Play verwalten oder kündigen. Preis und Abrechnungszeitraum werden auf dem nächsten Bildschirm angezeigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το KnotQ Sync είναι μια αυτοανανεώσιμη συνδρομή που χρεώνεται μέσω του λογαριασμού σας στο Google Play. Ανανεώνεται αυτόματα κάθε περίοδο εκτός αν την ακυρώσετε τουλάχιστον 24 ώρες πριν το τέλος της περιόδου. Διαχειριστείτε ή ακυρώστε ανά πάσα στιγμή στο Google Play. Η τιμή και η περίοδος χρέωσης εμφανίζονται στην επόμενη οθόνη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ Sync is an auto-renewing subscription billed through your Google Play account. It renews automatically each period unless you cancel at least 24 hours before the period ends; manage or cancel anytime in Google Play. The price and billing period are shown on the next screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ Sync es una suscripción de renovación automática facturada a través de tu cuenta de Google Play. Se renueva automáticamente cada período a menos que canceles al menos 24 horas antes de que finalice el período; gestiona o cancela en cualquier momento en Google Play. El precio y el período de facturación se muestran en la siguiente pantalla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ Sync on automaattisesti uusiutuva tilaus, joka laskutetaan Google Play -tilillesi. Se uusiutuu automaattisesti joka jakso, ellei peruuta vähintään 24 tuntia ennen jakson loppua. Voit hallita tai perua sitä milloin tahansa Google Play:ssa. Hinta ja laskutuskausi näytetään seuraavalla näytöllä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation KnotQ est un abonnement se renouvelant automatiquement facturé via votre compte Google Play. Elle se renouvelle automatiquement à chaque période sauf si vous annulez au moins 24 heures avant la fin de la période ; gérez ou annulez à tout moment dans Google Play. Le prix et la période de facturation sont affichés à l'écran suivant."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ Sync היא הרשמה המתחדשת באופן אוטומטי שמחויבת דרך חשבון Google Play שלך. היא מתחדשת באופן אוטומטי בכל תקופה אלא אם תבטל לפחות 24 שעות לפני סוף התקופה; ניהול או ביטול בכל עת ב-Google Play. המחיר ותקופת החיוב מוצגים במסך הבא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ सिंक एक स्वत: नवीकरण सदस्यता है जिसे आपके Google Play खाते के माध्यम से बिल दिया जाता है। यह प्रत्येक अवधि में स्वचालित रूप से नवीकृत होता है जब तक आप अवधि समाप्त होने से कम से कम 24 घंटे पहले रद्द न करें; Google Play में किसी भी समय प्रबंधित या रद्द करें। मूल्य और बिलिंग अवधि अगली स्क्रीन पर दिखाई देते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A KnotQ Sync egy automatikusan megújuló előfizetés, amelyet a Google Play-fiókodon keresztül számláznak. Az egyes időszakok végét megelőző legalább 24 órával korábban lemondható; a Google Play-ben bármikor kezelheted vagy lemondhatod. Az ár és a számlázási időszak a következő képernyőn látható."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ Sync adalah langganan yang diperbaharui otomatis melalui akun Google Play Anda. Ini diperbaharui secara otomatis setiap periode kecuali Anda membatalkan setidaknya 24 jam sebelum periode berakhir; kelola atau batalkan kapan saja di Google Play. Harga dan periode penagihan ditampilkan di layar berikutnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ Sync è un abbonamento con rinnovo automatico fatturato tramite il tuo account Google Play. Si rinnova automaticamente ogni periodo a meno che tu non annulli almeno 24 ore prima della fine del periodo; gestisci o annulla in qualsiasi momento in Google Play. Il prezzo e il periodo di fatturazione sono mostrati nella schermata successiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ Sync は Google Play アカウント経由で課金される自動更新サブスクリプションです。期間終了の 24 時間以上前にキャンセルしない限り、毎期自動的に更新されます。Google Play でいつでも管理またはキャンセルできます。価格と課金期間は次の画面に表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ Sync는 Google Play 계정을 통해 청구되는 자동 갱신 구독입니다. 기간이 끝나기 최소 24시간 전에 취소하지 않으면 각 기간마다 자동으로 갱신되며, Google Play에서 언제든지 관리하거나 취소할 수 있습니다. 가격과 청구 기간은 다음 화면에 표시됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ Sync adalah langganan yang diperbaharui sendiri yang dikenakan melalui akaun Google Play anda. Ia diperbaharui secara automatik setiap tempoh melainkan anda membatalkan sekurang-kurangnya 24 jam sebelum tempoh berakhir; kelola atau batalkan pada bila-bila masa di Google Play. Harga dan tempoh pengebilan ditunjukkan pada skrin seterusnya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ Sync er et automatisk fornyet abonnement fakturert gjennom Google Play-kontoen din. Det fornyes automatisk hver periode med mindre du avbryter minst 24 timer før perioden avsluttes; administrer eller avbryt når som helst i Google Play. Prisen og faktureringsperioden vises på neste skjerm."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ Sync is een automatisch verlengend abonnement dat via je Google Play-account wordt gefactureerd. Het wordt automatisch vernieuwd elke periode tenzij je minstens 24 uur voor het einde van de periode annuleert; beheer of annuleer het op elk moment in Google Play. De prijs en factureringsperiode worden op het volgende scherm weergegeven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ Sync to subskrypcja z automatycznym odnowieniem rozliczana na koncie Google Play. Odnawia się automatycznie w każdym okresie, chyba że anulujesz co najmniej 24 godziny przed końcem okresu; możesz zarządzać lub anulować w dowolnym momencie w Google Play. Cena i okres rozliczeniowy są wyświetlane na następnym ekranie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ Sync é uma inscrição de renovação automática faturada através de sua conta Google Play. Ela se renova automaticamente a cada período, a menos que você cancele pelo menos 24 horas antes do final do período; gerencie ou cancele a qualquer momento no Google Play. O preço e o período de faturamento serão mostrados na próxima tela."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ Sync é uma subscrição de renovação automática cobrada através da sua conta Google Play. Renova automaticamente em cada período, a menos que cancele pelo menos 24 horas antes do fim do período; gerencie ou cancele em qualquer altura no Google Play. O preço e o período de faturação são apresentados no próximo ecrã."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ Sync este un abonament cu reînnoire automată facturat prin contul dvs. Google Play. Se rennoiește automat în fiecare perioadă, cu excepția cazului în care anulați cel puțin 24 de ore înainte de sfârșitul perioadei; gestionați sau anulați oricând în Google Play. Prețul și perioada de facturare sunt afișate pe ecranul următor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ Sync — это автоматически возобновляющаяся подписка, выставленная через ваш аккаунт Google Play. Она автоматически возобновляется каждый период, если вы не отмените ее как минимум за 24 часа до конца периода; управляйте или отменяйте в любое время в Google Play. Цена и период выставления счетов показаны на следующем экране."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ Sync je automaticky sa obnovujúce predplatné, ktoré sa účtuje prostredníctvom vášho účtu Google Play. Automaticky sa obnovuje v každom období, pokiaľ ho nezrušíte najmenej 24 hodín pred koncom obdobia; spravujte alebo zrušte kedykoľvek v Obchode Google Play. Cena a zúčtovacie obdobie sú zobrazené na ďalšej obrazovke."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ Sync är en automatisk prenumeration som faktureras genom ditt Google Play-konto. Den förnyas automatiskt varje period om du inte avbryter minst 24 timmar före periodens slut. Hantera eller avbryt när som helst i Google Play. Priset och faktureringsperioden visas på nästa skärm."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ Sync เป็นการสมัครสมาชิกที่ต่ออายุโดยอัตโนมัติและเรียกเก็บเงินผ่านบัญชี Google Play ของคุณ การต่ออายุจะเกิดขึ้นโดยอัตโนมัติในแต่ละช่วงเว้นแต่คุณยกเลิกอย่างน้อย 24 ชั่วโมงก่อนสิ้นสุดช่วงเวลา คุณสามารถจัดการหรือยกเลิกได้ตลอดเวลาใน Google Play ราคาและระยะเวลาการเรียกเก็บเงินแสดงในหน้าถัดไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ Sync, Google Play hesabınız aracılığıyla faturalandırılan otomatik yenilenen bir aboneliktir. Dönem bitmeden en az 24 saat önce iptal etmediğiniz sürece her dönemde otomatik olarak yenilenir; Google Play'de istediğiniz zaman yönetin veya iptal edin. Fiyat ve fatura dönemi sonraki ekranda gösterilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ Sync — це автоматично поновлювана підписка, враховується через ваш обліковий запис Google Play. Вона автоматично поновлюється кожний період, якщо ви не скасуєте принаймні за 24 години до завершення періоду. Керуйте або скасуйте підписку в будь-який час у Google Play. Ціна та період виставлення рахунків відображаються на наступному екрані."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ Sync là một đăng ký tự động gia hạn được tính phí thông qua tài khoản Google Play của bạn. Nó tự động gia hạn mỗi kỳ trừ khi bạn hủy ít nhất 24 giờ trước khi kỳ kết thúc; quản lý hoặc hủy bất cứ lúc nào trong Google Play. Giá cả và kỳ thanh toán được hiển thị trên màn hình tiếp theo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ 同步是通过您的 Google Play 账户计费的自动续订。除非您在周期结束前至少 24 小时取消，否则将自动续订；可在 Google Play 中随时管理或取消。价格和计费周期显示在下一屏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ Sync 是透過您的 Google Play 帳戶計費的自動續訂訂閱。除非您在期間結束前至少 24 小時取消，否則會自動續訂。您可以隨時在 Google Play 中管理或取消。價格和計費期間會顯示在下一個畫面。"
          }
        }
      }
    },
