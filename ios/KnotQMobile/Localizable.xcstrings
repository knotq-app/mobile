    "web.account.verify_gate_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرسلنا رابط التحقق إلى بريدك الإلكتروني للحساب. أكّده لتشغيل مزامنة KnotQ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslali jsme ověřovací odkaz na e-mail vašeho účtu. Potvrďte jej a zapněte KnotQ Sync."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi sendte et bekræftelseslink til din kontos e-mail. Bekræft det for at aktivere KnotQ Sync."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben einen Überprüfungs-Link an Ihre Konto-E-Mail gesendet. Bestätigen Sie ihn, um KnotQ Sync zu aktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στείλαμε έναν σύνδεσμο επιβεβαίωσης στο email του λογαριασμού σας. Επιβεβαιώστε το για ενεργοποίηση KnotQ Sync."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We sent a verification link to your account email. Confirm it to turn on KnotQ Sync."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te enviamos un enlace de verificación a tu email de cuenta. Confirmaló para activar KnotQ Sync."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähetimme vahvistuslinkin tilin sähköpostiin. Vahvista se ottaaksesi KnotQ Sync:n käyttöön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous avons envoyé un lien de vérification à votre adresse e-mail de compte. Confirmez-le pour activer KnotQ Sync."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שלחנו קישור אימות לדוא״ל החשבון שלך. אשר אותו כדי להפעיל את KnotQ Sync."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हमने आपके खाते के ईमेल को सत्यापन लिंक भेजा है। KnotQ Sync चालू करने के लिए इसकी पुष्टि करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
