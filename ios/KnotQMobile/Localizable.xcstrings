    "web.guide.daily.p2_post" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " أريد الانتهاء منها. من المهم أن تكون هذه عناصر محددة حتى تكون قابلة للتنفيذ. طوال اليوم، أمر عبرها وأتحقق منها أثناء إكمال كل واحدة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " které chci dokončit. Je důležité, aby to byly konkrétní položky, aby byly realizovatelné. Během dne si je projdu a zaškrtávám je, jak postupně završuji každou z nich."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", som jeg gerne vil afslutte. Det er vigtigt, at disse er specifikke elementer, så de kan handles. I løbet af dagen går jeg gennem dem og markerer dem af, når jeg afslutter hver enkelt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " die ich an diesem Tag abschließen möchte. Es ist wichtig, dass dies spezifische Elemente sind, damit sie umsetzbar sind. Den ganzen Tag über gehe ich die Liste durch und häkle sie ab, wenn ich jede fertigstelle."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " θέλω να τελειώσω. Είναι σημαντικό αυτά να είναι συγκεκριμένα στοιχεία ώστε να είναι δυνατό να ενεργήσουν πάνω τους. Καθ' όλη τη διάρκεια της ημέρας, τα περνώ και τα σημειώνω καθώς ολοκληρώνω κάθε ένα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " I want to finish. It's important these are specific items so that they are actionable. Throughought the day, I go through and check them off as I complete each one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "que quiero terminar. Es importante que estos sean elementos específicos para que sean accionables. A lo largo del día, voy revisándolos y marcándolos a medida que completo cada uno."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " haluan saada valmiiksi. On tärkeää, että nämä ovat spesifisiä kohteita, jotta ne ovat toiminnallisia. Päivän mittaan käyn ne läpi ja merkitsen ne valmiiksi, kun suoritan jokaisen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " que je veux terminer. Il est important que ce soient des éléments spécifiques pour qu'ils soient exploitables. Tout au long de la journée, je les parcours et je les coche au fur et à mesure que j'en complète chacun."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " אני רוצה לסיים. חשוב שהם יהיו פריטים ספציפיים כדי שהם יהיו פעולה ישימה. במהלך כל היום, אני הולך דרך והבדוק אותם כשהם משלימים כל אחד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " मुझे खत्म करना है। ये विशिष्ट आइटम होना महत्वपूर्ण है ताकि वे कार्यान्वयन योग्य हों। दिन भर, मैं उनके माध्यम से जाता हूं और जैसे ही मैं प्रत्येक को पूरा करता हूं उन्हें चेक करता हूं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " , amelyeket szeretnék befejezni. Fontos, hogy ezek konkrét tárgyak legyenek, hogy gyakorlati legyenek. Az egész nap során végigmegyek és bejelölöm őket, ahogy mindegyiket befejezem."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " yang ingin saya selesaikan. Penting bahwa ini adalah item spesifik sehingga dapat ditindaklanjuti. Sepanjang hari, saya mengerjakannya dan mencentangnya saat saya menyelesaikan masing-masing."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " voglio finire. È importante che questi siano elementi specifici in modo che siano attuabili. Durante tutto il giorno, vado attraverso e li contraddistinguo man mano che completo ognuno."
          }
        },
        "ja" : {
