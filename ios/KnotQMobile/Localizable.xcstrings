    "onboarding.step.daily.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اليوميات هي مخطط خاص وافتراضي. اكتب قائمة مهام متفائلة كل يوم وحدد المهام المكتملة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily je speciální výchozí plán. Napište si seznam úkolů každý den a zaškrtněte ty, které jste dokončili."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daglig er et særligt, standardskema. Skriv en optimistisk opgaveliste hver dag og marker de opgaver, du udfører."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Täglich ist ein spezielles Standardschema. Schreiben Sie jeden Tag eine optimistische Aufgabenliste und kreuzen Sie die abgeschlossenen an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Daily είναι ένα ειδικό, προεπιλεγμένο σχέδιο. Γράψτε μια αισιόδοξη λίστα εργασιών κάθε μέρα και σημειώστε τις που ολοκληρώνετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily is a special, default scheme. Write an optimistic task list each day and check off the ones you complete."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diario es un esquema especial y predeterminado. Escribe una lista de tareas optimista cada día y marca las que completes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päivittäinen on erityinen oletuskaavio. Kirjoita optimistinen tehtävälista joka päivä ja merkitse valmiit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quotidien est un plan spécial par défaut. Écrivez une liste de tâches optimiste chaque jour et cochez celles que vous avez complétées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יומי היא תכנית מיוחדת וברירת מחדל. כתוב רשימת משימות אופטימית כל יום וסמן את כל אלה שהושלמו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दैनिक एक विशेष, डिफ़ॉल्ट योजना है। प्रत्येक दिन एक आशावादी कार्य सूची लिखें और जो पूरे करते हैं उन्हें चेक करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Napi egy speciális, alapértelmezett séma. Minden nap írj egy optimista feladatlistát, és pipáld be az elkészülteket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harian adalah skema khusus dan bawaan. Tulis daftar tugas yang optimis setiap hari dan tandai yang Anda selesaikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily è uno schema speciale e predefinito. Scrivi un elenco di compiti ottimista ogni giorno e spunta quelli che completi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デイリーは特別なデフォルトスキームです。毎日楽観的なタスクリストを作成し、完了したものにチェックを入れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily는 특별하고 기본값인 스키마입니다. 매일 낙관적인 작업 목록을 작성하고 완료한 작업을 확인하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harian adalah skema khas dan lalai. Tulis senarai tugas yang optimis setiap hari dan tandakan yang anda selesaikan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daglig er en spesiell standardskjema. Skriv en optimistisk oppgaveliste hver dag og merk av dem du fullfører."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagelijks is een speciaal standaardschema. Schrijf elke dag een optimistische takenlijst en vink de voltooide items af."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dziennie to specjalny, domyślny schemat. Napisz optymistyczną listę zadań każdego dnia i zaznacz te, które ukończysz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily é um esquema especial e padrão. Escreva uma lista de tarefas otimista a cada dia e marque as que você completa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily é um esquema especial e predefinido. Escreva uma lista de tarefas otimista cada dia e marque as que completar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily este un plan special și implicit. Scrieți o listă optimistă de sarcini în fiecare zi și bifați pe cele pe care le finalizați."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дневник — это специальная схема по умолчанию. Напишите оптимистичный список задач каждый день и отметьте те, которые вы выполнили."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denník je špeciálna, predvolená schéma. Každý deň si napíšte optimistický zoznam úloh a odškrtnite tie, ktoré ste dokončili."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagligt är ett speciellt standardschema. Skriv en optimistisk uppgiftslista varje dag och bocka av de du slutför."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily เป็นแบบแผนพิเศษและเริ่มต้น เขียนรายชื่องานตามความหวังแต่ละวันและทำเครื่องหมายรายการที่คุณเสร็จสิ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günlük, özel bir varsayılan şemadır. Her gün iyimser bir görev listesi yazın ve tamamladıklarınızı işaretleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоденно — це спеціальна схема за замовчуванням. Напишіть оптимістичний список завдань кожного дня й відмітьте виконані."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hàng ngày là một lược đồ mặc định đặc biệt. Viết danh sách tác vụ lạc quan mỗi ngày và tích vào những cái bạn hoàn thành."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日常是一个特殊的默认方案。每天写一个乐观的任务列表并检查完成的任务。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每日是特殊的預設方案。每天編寫樂觀的任務清單，並勾選您完成的項目。"
          }
        }
      }
    },
