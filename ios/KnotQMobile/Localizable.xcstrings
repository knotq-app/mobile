    "mobile.account_delete.google_play_warning" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ألغِ اشتراكك في Google Play أولاً. حذف حسابك لا يلغي فواتير المتجر - Google Play سيستمر في محاسبتك حتى تلغيها هناك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejdřív zrušte své předplatné Google Play. Smazání vašeho účtu NEZRUŠÍ fakturaci v obchodě – Google Play vás bude nadále zpoplatňovat, dokud jej tam nezrušíte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuller dit Google Play abonnement først. Sletning af din konto annullerer IKKE faktureringen i butikken — Google Play vil fortsætte med at opkræve dig, indtil du annullerer det der."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kündigen Sie zunächst Ihr Google Play-Abonnement. Das Löschen Ihres Kontos bricht NICHT die Store-Abrechnung ab – Google Play berechnet Ihnen weiterhin, bis Sie dort kündigen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ακυρώστε τη συνδρομή σας στο Google Play πρώτα. Η διαγραφή του λογαριασμού σας ΔΕΝ ακυρώνει τη χρέωση του καταστήματος — το Google Play συνεχίζει να σας χρεώνει μέχρι να το ακυρώσετε εκεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancel your Google Play subscription first. Deleting your account does NOT cancel store billing — Google Play keeps charging you until you cancel it there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancela primero tu suscripción de Google Play. Eliminar tu cuenta NO cancela la facturación de la tienda — Google Play seguirá cobrándote hasta que lo hagas allá."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peruuta Google Play -tilauksesi ensin. Tilin poistaminen EI peruuta sovelluskaupan laskutusta — Google Play jatkaa laskutusta, kunnes peruutat sen siellä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annulez d'abord votre abonnement Google Play. Supprimer votre compte N'annule PAS la facturation du magasin — Google Play continue de vous facturer jusqu'à ce que vous l'annuliez là-bas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בטל את המנוי Google Play שלך תחילה. מחיקת החשבון שלך עושה **לא** בטל חיוב חנות — Google Play ממשיך לגבות אותך עד שתבטל זאת שם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहले अपनी Google Play सदस्यता रद्द करें। आपके खाते को हटाना स्टोर बिलिंग को रद्द नहीं करता — Google Play आपको तब तक चार्ज करता रहता है जब तक आप वहां इसे रद्द नहीं करते।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Először mondja le az előfizetést a Google Play-ben. A fiók törlése NEM szünteti meg a tárolt számlázást – a Google Play továbbra is számlázza Önt, amíg ott le nem mondja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batalkan langganan Google Play Anda terlebih dahulu. Menghapus akun Anda TIDAK membatalkan penagihan toko — Google Play terus mengenakan biaya kepada Anda hingga Anda membatalkannya di sana."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annulla prima l'abbonamento a Google Play. L'eliminazione dell'account NON annulla la fatturazione del negozio — Google Play continua a addebitarti fino a quando non lo annulli lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Playのサブスクリプションをまずキャンセルしてください。アカウントを削除しても、Google Playでの請求はキャンセルされません。そこでキャンセルするまでGoogle Playが課金を続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "먼저 Google Play 구독을 취소하세요. 계정을 삭제해도 스토어 청구가 취소되지 않습니다 — Google Play는 이곳에서 취소할 때까지 계속 청구합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batalkan langganan Google Play Anda terlebih dahulu. Menghapus akun Anda TIDAK membatalkan penagihan toko — Google Play terus menagih Anda hingga Anda membatalkannya di sana."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avbryt Google Play-abonnementet ditt først. Sletting av kontoen din AVBRYTER IKKE butikkfakturering — Google Play fortsetter å belaste deg til du avbryter det der."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeg je Google Play-abonnement eerst op. Het verwijderen van je account annuleert NO het winkelbetaling — Google Play blijft je factureren tot je het daar opzegt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw anuluj subskrypcję w Google Play. Usunięcie Twojego konta NIE anuluje rozliczeń w sklepie — Google Play będzie Cię rozliczać, dopóki nie anulujesz tam."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancele sua assinatura do Google Play primeiro. Excluir sua conta NÃO cancela cobrança na loja — Google Play continuará cobrando você até você cancelar lá."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancele a sua subscrição do Google Play primeiro. Eliminar a sua conta NÃO cancela o faturamento da loja — Google Play continua a cobrar-lhe até a cancelar lá."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anulați-vă abonamentul Google Play în prealabil. Ștergerea contului NU anulează facturarea prin magazin — Google Play continuă să vă perceapă până când o anulați acolo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала отмените подписку Google Play. Удаление вашего аккаунта НЕ отменяет оплату в магазине — Google Play продолжит списывать средства, пока вы не отмените подписку там."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najprv zrušte predplatné Google Play. Vymazanie účtu NEZRUŠUJE účtovanie v obchode – Google Play vás bude ďalej fakturovať, kým ho tam nezrušíte."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avsluta din Google Play-prenumeration först. Om du raderar ditt konto AVSLUTS inte butiksdebitering – Google Play debiterar dig tills du avsluter det där."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยกเลิกการสมัครสมาชิก Google Play ก่อน การลบบัญชีของคุณ ไม่ยกเลิกการเรียกเก็บเงินในร้านค้า — Google Play จะเรียกเก็บเงินจากคุณต่อไปจนกว่าคุณจะยกเลิกที่นั่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce Google Play aboneliğinizi iptal edin. Hesabınızı silmek Google Play faturalandırmasını iptal ETMEZ — Google Play onu iptal edene kadar faturalandırmaya devam eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спочатку скасуйте підписку Google Play. Видалення вашого облікового запису НЕ скасує виставлення рахунків у магазині — Google Play продовжуватиме вас стягувати, доки ви не скасуєте її там."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hủy đăng ký Google Play của bạn trước. Xóa tài khoản của bạn KHÔNG hủy thanh toán cửa hàng — Google Play tiếp tục tính phí cho bạn cho đến khi bạn hủy nó ở đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先取消您的 Google Play 订阅。删除您的账户不会取消商店计费 — Google Play 将继续向您收费,直到您在那里取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首先取消您的 Google Play 訂閱。刪除您的帳戶不會取消商店帳單—Google Play 會持續向您收費，直到您在那裡取消為止。"
          }
        }
      }
    },
