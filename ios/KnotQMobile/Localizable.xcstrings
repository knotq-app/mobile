    "web.guide.calendar.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التقويم عبارة عن شبكة عرض أسبوعية تسحب الأحداث من جميع خطتك، مع ترميز لوني حسب الخطة. انقر على أي حدث للانتقال إلى سطره الأصلي في المحرر. تعرض اللوحة القادمة على اليسار ما هو مقبل وتكون مرئية على كل صفحة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalendář je tabulka pohledu na týden, která vytahuje události ze všech vašich schémat, barevně odlišených podle schématu. Kliknutím na jakoukoli událost skočíte na její zdrojový řádek v editoru. Nadcházející panel na levé straně ukazuje, co je dále splatné, a je viditelný na každé stránce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalenderen er et ugevisnetsark, der henter begivenheder fra alle dine skemaer, farvekodet efter skema. Klik på en begivenhed for at gå til dens kildelinje i editoren. Det kommende panel til venstre viser, hvad der forfalder næste gang, og er synligt på hver side."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kalender ist eine Wochenansichts-Rasteransicht, die Ereignisse aus all Ihren Schemes heranzieht, farbcodiert nach Scheme. Klicken Sie auf ein Ereignis, um zur Quellzeile im Editor zu springen. Das Feld „Bevorstehend“ auf der linken Seite zeigt, was als Nächstes fällig ist und ist auf jeder Seite sichtbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ημερολόγιο είναι ένα πλέγμα προβολής εβδομάδας που τραβά γεγονότα από όλα τα σχέδιά σας, κωδικοποιημένα με χρώμα ανά σχέδιο. Κάντε κλικ σε οποιοδήποτε γεγονός για να μεταβείτε στη γραμμή προέλευσής του στο επεξεργαστή. Το τρέχον πάνελ στα αριστερά δείχνει τι πρόκειται να λήξει στη συνέχεια και είναι ορατό σε κάθε σελίδα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The calendar is a week-view grid that pulls events from all your schemes, color-coded by scheme. Click any event to jump to its source line in the editor. The upcoming panel on the left shows what's due next and is visible on every page."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El calendario es una cuadrícula de vista semanal que extrae eventos de todos tus esquemas, codificados por color según el esquema. Haz clic en cualquier evento para ir a su línea de origen en el editor. El panel de próximos eventos a la izquierda muestra qué vence a continuación y es visible en todas las páginas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalenteri on viikon näkymä, joka hakee tapahtumat kaikista kaavioistasi värikoodattuina. Napsauta mitä tahansa tapahtumaa hyppääksesi sen lähdelinjalle muokkaimessa. Vasemmalla oleva tulevien paneeli näyttää, mitä on seuraavaksi esillä, ja se näkyy jokaisella sivulla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le calendrier est une grille d'affichage hebdomadaire qui extrait les événements de tous vos schémas, codés par couleur selon le schéma. Cliquez sur n'importe quel événement pour accéder à sa ligne source dans l'éditeur. Le panneau à venir sur la gauche affiche ce qui est dû ensuite et est visible sur chaque page."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לוח השנה הוא רשת צפיית שבוע המשיכה אירועים מכל הסכמות שלך, בקוד צבע לפי סכמה. לחץ על כל אירוע כדי לקפוץ לשורת המקור שלו בעריכה. הלוח הקרוב בצד שמאל מציג מה הוא בא לידי ביטוי הבא וגלוי בכל עמוד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कैलेंडर एक सप्ताह-दृश्य ग्रिड है जो आपकी सभी स्कीमों से ईवेंट खींचता है, स्कीम द्वारा रंग-कोडित। किसी भी ईवेंट पर क्लिक करें संपादक में इसकी स्रोत पंक्ति पर कूदने के लिए। बाईं ओर आने वाला पैनल अगले क्या कारण है और प्रत्येक पृष्ठ पर दृश्यमान है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A naptár egy heti nézet, amely az összes séma eseményeit jeleníti meg, séma szerint színkódolva. Kattintson bármely eseményre, hogy az szerkesztőben a forrássorára ugorjon. A bal oldali, közelgő panel a következő teendőket jeleníti meg, és minden oldalon látható."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalender adalah kisi tampilan minggu yang menarik acara dari semua skema Anda, dikodekan warna menurut skema. Klik acara mana pun untuk melompat ke baris sumbernya di editor. Panel mendatang di sebelah kiri menunjukkan apa yang jatuh tempo berikutnya dan terlihat di setiap halaman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il calendario è una griglia di visualizzazione settimanale che attrae gli eventi da tutti i tuoi schemi, codificati per colore secondo lo schema. Fai clic su qualsiasi evento per saltare alla sua riga sorgente nell'editor. Il pannello dei prossimi eventi sulla sinistra mostra cosa scade dopo ed è visibile su ogni pagina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カレンダーはすべてのスキームからイベントを引き出す週表示グリッドで、スキーム別に色分けされています。任意のイベントをクリックしてエディターのソース行にジャンプします。左側のアップカミングパネルは次の期限を表示し、すべてのページで表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캘린더는 모든 스킴에서 이벤트를 가져온 주간 보기 그리드이며 스킴별로 색상 구분됩니다. 이벤트를 클릭하면 편집기에서 원본 줄로 이동합니다. 왼쪽의 예정된 항목 패널에는 다음에 기한이 있는 항목이 표시되며 모든 페이지에서 볼 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalender adalah kisi tampilan minggu yang menarik acara dari semua skema Anda, dikodekan warna menurut skema. Klik acara apa pun untuk melompat ke baris sumbernya di editor. Panel mendatang di sebelah kiri menunjukkan apa yang akan datang dan terlihat di setiap halaman."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalenderen er et ukeskjema som henter hendelser fra alle skjemaene dine, fargekodede etter skjema. Klikk på en hvilken som helst hendelse for å hoppe til kildelinjen i redigeringsprogrammet. Kommende panel på venstre side viser hva som forfaller neste og er synlig på hver side."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De agenda is een week-overzichtsgrid dat evenementen uit al je schema's haalt, met kleurcodering per schema. Klik op een evenement om naar de bronregel in de editor te springen. Het komende paneel aan de linkerkant toont wat er volgende is verschuldigd en is op elke pagina zichtbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalendarz jest siatką widoku tygodniowego, która pobiera zdarzenia z wszystkich Twoich schematów, kodowane kolorami według schematu. Kliknij dowolne zdarzenie, aby przejść do jego linii źródłowej w edytorze. Panel „Planowane” po lewej stronie pokazuje, co czeka Ciebie dalej, i jest widoczny na każdej stronie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O calendário é uma grade de visualização semanal que extrai eventos de todos os seus esquemas, codificados por cor por esquema. Clique em qualquer evento para ir até sua linha de origem no editor. O painel de próximos eventos à esquerda mostra o que está próximo e é visível em cada página."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O calendário é uma grelha de vista semanal que extrai eventos de todos os seus esquemas, codificados por cor conforme o esquema. Clique em qualquer evento para saltar para a sua linha de origem no editor. O painel de próximas tarefas à esquerda mostra o que é devido em seguida e é visível em todas as páginas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendarul este o grilă de vizualizare săptămânală care extrage evenimente din toate schemele dvs., codificate după culori după schemă. Faceți clic pe orice eveniment pentru a sări la linia sa sursă în editor. Panoul următor din stânga arată ce se datorează mai departe și este vizibil pe fiecare pagină."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Календарь — это еженедельная сетка просмотра, которая вытягивает события из всех ваших схем, кодированных цветом по схеме. Нажмите на любое событие, чтобы перейти к его исходной строке в редакторе. Панель предстоящих задач слева показывает, что дальше наступит, и видна на каждой странице."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalendár je týždenný pohľad v mriežke, ktorý ťahá udalosti z všetkých vašich schém, farebne kódované podľa schémy. Kliknite na akúkoľvek udalosť, aby ste skočili na jej zdrojový riadok v editore. Panel Nadchádzajúce na ľavej strane ukazuje, čo je ďalej, a je viditeľný na každej stránke."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalendern är en veckovyrutnät som hämtar händelser från alla dina scheman, färgkodade efter schema. Klicka på en händelse för att hoppa till dess källrad i redigeraren. Panelen för kommande på vänster sida visar vad som ska göras härnäst och är synlig på varje sida."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปฏิทินเป็นกริดมุมมองสัปดาห์ที่ดึงเหตุการณ์จากโครงการทั้งหมดของคุณ โดยเข้ากำหนดสีตามโครงการ คลิกเหตุการณ์ใด ๆ เพื่อข้ามไปยังบรรทัดต้นทางของมันในตัวแก้ไข แผงที่กำลังจะมาถึงทางด้านซ้ายแสดงสิ่งที่ค้างไว้ต่อไปและมองเห็นได้ในทุกหน้า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takvim, tüm şemalarınızdan etkinlikleri çeken ve şemaya göre renk kodlu bir hafta görünümü ızgarasıdır. Editördeki kaynak satırına geçmek için herhangi bir etkinliği tıklayın. Soldaki yaklaşan panel, sonra ne vadesi olduğunu gösterir ve her sayfada görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Календар — це сітка тижневого представлення, яка отримує события з усіх ваших схем, розфарбовані за схемами. Натисніть на будь-яке подію, щоб перейти до її вихідного рядка в редакторі. Панель «Найближчі» ліворуч показує, що повинно статися далі, й видна на кожній сторінці."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lịch là lưới chế độ xem tuần kéo các sự kiện từ tất cả các lược đồ của bạn, được mã hóa màu theo lược đồ. Nhấp vào bất kỳ sự kiện nào để nhảy đến dòng nguồn của nó trong trình soạn thảo. Bảng điều khiển sắp tới ở bên trái cho biết những gì sắp đến hạn và hiển thị trên mọi trang."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日历是一个周视图网格，从您的所有方案中提取事件，按方案按颜色编码。单击任何事件可跳转到编辑器中的源行。左侧的\"即将推出\"面板显示下一步应做的事情，在每个页面上都可见。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日曆是一個周視圖網格，會從您的所有規劃方案中拉取事件，按規劃方案以顏色編碼。點擊任何事件以跳到編輯器中的源行。左側的即將推出面板顯示接下來要完成的內容，在每一頁上都可見。"
          }
        }
      }
    },
