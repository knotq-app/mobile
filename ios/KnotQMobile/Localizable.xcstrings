    "web.delete_account.contact_fallback_b" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من العنوان المرتبط بحسابك واطلب منا حذف حسابك. لا تُرسل كلمة مرورك أو رموز OAuth أو أسرار أخرى عبر البريد الإلكتروني. قد نطلب منك التحقق من ملكية الحساب قبل حذفه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "z adresy přidružené k vašemu účtu a požádejte nás, abychom váš účet smazali. Neposílejte e-mailem své heslo, tokeny OAuth nebo další tajemství. Než váš účet smažeme, můžeme vás požádat o ověření vlastnictví účtu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "fra adressen knyttet til din konto og bed os om at slette din konto. Send ikke din adgangskode, OAuth-tokens eller andre hemmeligheder via e-mail. Vi kan bede dig om at bekræfte ejerskabet af kontoen før sletningen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "von der E-Mail-Adresse, die mit Ihrem Konto verknüpft ist, und bitten Sie uns, Ihr Konto zu löschen. Senden Sie Ihr Passwort, OAuth-Tokens oder andere Geheimnisse nicht per E-Mail. Wir können Sie auffordern, den Besitz des Kontos zu überprüfen, bevor wir es löschen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "από τη διεύθυνση που σχετίζεται με το λογαριασμό σας και ζητήστε να διαγράψουμε το λογαριασμό σας. Μην στέλνετε τον κωδικό πρόσβασης, τα διακριτικά OAuth ή άλλα μυστικά ως email. Μπορεί να σας ζητήσουμε να επιβεβαιώσετε την ιδιοκτησία του λογαριασμού πριν τη διαγραφή του."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "from the address associated with your account and ask us to delete your account. Do not send your password, OAuth tokens, or other secrets by email. We may ask you to verify ownership of the account before deleting it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "desde la dirección asociada con tu cuenta y pídenos que elimines tu cuenta. No envíes tu contraseña, tokens de OAuth u otros secretos por email. Podemos pedirte que verifiques la propiedad de la cuenta antes de eliminarla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tiliin liittyvästä osoitteesta ja pyydä meitä poistamaan tilisi. Älä lähetä salasanaasi, OAuth-merkkejä tai muita salaisuuksia sähköpostitse. Voimme pyytää sinua vahvistamaan tilin omistajuuden ennen sen poistamista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "à partir de l'adresse associée à votre compte et demandez-nous de supprimer votre compte. N'envoyez pas votre mot de passe, vos jetons OAuth ou d'autres secrets par e-mail. Nous pouvons vous demander de vérifier la propriété du compte avant de le supprimer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מהכתובת המשויכת לחשבון שלך ובקש מאיתנו למחוק את החשבון שלך. אל תשלח את הסיסמה, אסימוני OAuth או סודות אחרים בדוא״ל. אנו עשויים לבקש ממך לאמת בעלות על החשבון לפני מחיקתו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने खाते से जुड़े पते से और हमसे अपने खाते को हटाने के लिए कहें। अपना पासवर्ड, OAuth टोकन या अन्य रहस्य ईमेल द्वारा न भेजें। हटाने से पहले हम आपसे खाते के मालिकाना हक को सत्यापित करने के लिए कह सकते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "a fiókhoz társított e-mail-címről, és kérjük, hogy törölje a fiók. Ne küldjön jelszót, OAuth tokeneket vagy más titkos információt e-mailben. Elképzelhető, hogy meg kell erősítenie a fiók tulajdonát a törlés előtt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "dari alamat yang terkait dengan akun Anda dan minta kami menghapus akun Anda. Jangan kirim kata sandi, token OAuth, atau rahasia lainnya melalui email. Kami dapat meminta Anda memverifikasi kepemilikan akun sebelum menghapusnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "dall'indirizzo associato al tuo account e chiedici di eliminare il tuo account. Non inviare la tua password, token OAuth o altri segreti via email. Potremmo chiederti di verificare la proprietà dell'account prima di eliminarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントに関連付けられたメールアドレスから、アカウントの削除をリクエストしてください。パスワード、OAuthトークン、または他の秘密をメールで送信しないでください。削除する前にアカウント所有権の確認をお願いする場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정과 관련된 주소에서 이메일로 계정 삭제를 요청하세요. 이메일로 비밀번호, OAuth 토큰 또는 기타 비밀을 보내지 마세요. 계정을 삭제하기 전에 계정 소유권을 확인하도록 요청할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "daripada alamat yang dikaitkan dengan akaun anda dan minta kami untuk memadamkan akaun anda. Jangan hantar kata laluan, token OAuth, atau rahsia lain melalui e-mel. Kami mungkin meminta anda untuk mengesahkan pemilikan akaun sebelum memadamkannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "fra adressen som er knyttet til kontoen din og be oss om å slette kontoen din. Ikke send passordet ditt, OAuth-tokens eller andre hemmeligheter via e-post. Vi kan be deg om å verifisere eierskapet til kontoen før vi sletter den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "van het e-mailadres dat aan je account is gekoppeld en vraag ons je account te verwijderen. Stuur je wachtwoord, OAuth-tokens of andere geheimen niet per e-mail. We kunnen je vragen het eigendom van het account te verifiëren voordat we het verwijderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "z adresu powiązanego z Twoim kontem i poproś nas o usunięcie Twojego konta. Nie wysyłaj hasła, tokenów OAuth ani innych tajemnic e-mailem. Możemy poprosić Cię o weryfikację właścicielstwa konta przed jego usunięciem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "a partir do endereço associado à sua conta e nos peça para deletar sua conta. Não envie sua senha, tokens OAuth ou outros segredos por email. Podemos pedir para você verificar a propriedade da conta antes de deletá-la."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "a partir do endereço associado à sua conta e peça-nos para eliminar a sua conta. Não envie a sua senha, tokens OAuth ou outros segredos por email. Podemos pedir-lhe que verifique a propriedade da conta antes de a eliminar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "din adresa asociată contului dvs. și rugați-ne să-și șteargă contul. Nu trimiteți parola, token-urile OAuth sau alte secrete prin e-mail. Vă putem cere să verificați proprietatea contului înainte de a-l șterge."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "с адреса, связанного с вашей учётной записью, и попросите нас удалить вашу учётную запись. Не отправляйте пароль, токены OAuth или другие секреты по электронной почте. Перед удалением мы можем попросить вас подтвердить право собственности на учётную запись."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "z adresy spojenej s vašim účtom a požiadajte nás, aby sme odstránili váš účet. Nepošlite svoje heslo, OAuth tokeny ani iné tajomstvá e-mailom. Môžeme vás požiadať, aby ste overili vlastníctvo účtu pred jeho odstránením."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "från adressen som är associerad med ditt konto och be oss att ta bort ditt konto. Skicka inte ditt lösenord, OAuth-tokens eller andra hemligheter via e-post. Vi kan be dig att verifiera kontoägarskapet innan vi raderar det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จากที่อยู่ที่เกี่ยวข้องกับบัญชีของคุณและขอให้เราลบบัญชีของคุณ อย่าส่งรหัสผ่าน โทเค็น OAuth หรือความลับอื่นๆ ทางอีเมล เราอาจขอให้คุณยืนยันความเป็นเจ้าของบัญชีก่อนลบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "adresinden hesabınızla ilişkili e-posta adresinden e-posta gönderin ve hesabınızı silmemizi isteyin. Parolanız, OAuth jetonları veya diğer sırları e-posta yoluyla göndermekten kaçının. Hesaptan silmeden önce sahipliğini doğrulamanız istenebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "з адреси, пов'язаної з вашим обліковим записом, і попросіть нас видалити ваш обліковий запис. Не надсилайте свій пароль, токени OAuth або інші секрети електронною поштою. Ми можемо попросити вас підтвердити право власності на обліковий запис перед його видаленням."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "từ địa chỉ được liên kết với tài khoản của bạn và yêu cầu chúng tôi xóa tài khoản của bạn. Không gửi mật khẩu, mã token OAuth hoặc bí mật khác qua email. Chúng tôi có thể yêu cầu bạn xác minh quyền sở hữu tài khoản trước khi xóa nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从与您的账户相关联的地址，并要求我们删除您的账户。不要通过电子邮件发送您的密码、OAuth 令牌或其他机密。我们可能会在删除前要求您验证账户所有权。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從與您帳戶關聯的地址，並要求我們刪除您的帳戶。請勿透過電子郵件傳送您的密碼、OAuth 權杖或其他密碼。我們可能會要求您在刪除帳戶前驗證帳戶所有權。"
          }
        }
      }
    },
