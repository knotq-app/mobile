    "mobile.subscription.cancel_confirm_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى مساحة العمل المحلية على هذا الجهاز. قد تظل المزامنة المدفوعة متاحة حتى نهاية فترة الفواتير الحالية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš místní pracovní prostor zůstává v tomto zařízení. Placená synchronizace může zůstat dostupná do konce aktuálního fakturačního období."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit lokale arbejdsområde forbliver på denne enhed. Betalt synkronisering kan forblive tilgængelig indtil den aktuelle faktureringsperiode slutter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr lokaler Arbeitsbereich bleibt auf diesem Gerät. Bezahlte Synchronisierung kann bis zum Ende des aktuellen Abrechnungszeitraums verfügbar bleiben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο τοπικός σας χώρος εργασίας παραμένει σε αυτήν τη συσκευή. Η πληρωμένη συγχρονισμό ενδέχεται να παραμείνει διαθέσιμη έως το τέλος της τρέχουσας περιόδου χρέωσης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your local workspace stays on this device. Paid sync may remain available until the current billing period ends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu espacio de trabajo local permanece en este dispositivo. La sincronización de pago puede permanecer disponible hasta que termine el período de facturación actual."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paikallinen työtila säilyy tässä laitteessa. Maksettu synkronointi voi säilyä käytettävissä kunnes nykyinen laskutuskausi päättyy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre espace de travail local reste sur cet appareil. La synchronisation payante peut rester disponible jusqu'à la fin de la période de facturation actuelle."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מרחב העבודה המקומי שלך נשאר בהתקן זה. סנכרון בתשלום עשוי להישאר זמין עד סוף תקופת החיוב הנוכחית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका स्थानीय कार्यक्षेत्र इस उपकरण पर रहता है। भुगतान की गई सिंक वर्तमान बिलिंग अवधि के अंत तक उपलब्ध रह सकती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A helyi munkaterület marad ezen az eszközön. A fizetett szinkronizálás az aktuális számlázási időszak végéig elérhető maradhat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruang kerja lokal Anda tetap di perangkat ini. Sinkronisasi berbayar mungkin tetap tersedia hingga akhir periode penagihan saat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo workspace locale rimane su questo dispositivo. La sincronizzazione a pagamento potrebbe rimanere disponibile fino alla fine del periodo di fatturazione corrente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルワークスペースはこのデバイスに残ります。有料同期は現在の課金期間まで利用可能なままである可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 작업 영역은 이 기기에 유지됩니다. 유료 동기화는 현재 청구 기간이 끝날 때까지 사용할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruang kerja tempatan anda tetap di peranti ini. Segerakan berbayar mungkin tetap tersedia sehingga tempoh pengebilan semasa berakhir."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbeidsrommet ditt lokalt blir værende på denne enheten. Betalt synkronisering kan være tilgjengelig til gjeldende faktureringsperiode avsluttes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je lokale werkruimte blijft op dit apparaat. Betaalde synchronisatie kan beschikbaar blijven tot het einde van de huidige factureringsperiode."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój lokalny obszar roboczy pozostaje na tym urządzeniu. Płatna synchronizacja może pozostać dostępna do końca bieżącego okresu rozliczeniowego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu espaço de trabalho local permanece neste dispositivo. A sincronização paga pode permanecer disponível até o final do período de faturamento atual."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu espaço de trabalho local permanece neste dispositivo. A sincronização paga pode permanecer disponível até ao final do período de faturação atual."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spațiul de lucru local rămâne pe acest dispozitiv. Sincronizarea plătită poate rămâne disponibilă până la sfârșitul perioadei de facturare curente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваше локальное рабочее пространство остается на этом устройстве. Платная синхронизация может оставаться доступной до конца текущего периода выставления счетов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš lokálny pracovný priestor zostáva v tomto zariadení. Platenou synchronizáciu možno udržiavať v dostupnosti až do konca aktuálneho zúčtovacieho obdobia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din lokala arbetsyta förblir på denna enhet. Betald synkronisering kan förbli tillgänglig tills den aktuella faktureringsperioden slutar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พื้นที่ทำงานท้องถิ่นของคุณยังคงอยู่บนอุปกรณ์นี้ การซิงค์ที่จ่ายเงินอาจยังคงพร้อมใช้งานจนกว่าระยะเวลาการเรียกเก็บเงินปัจจุบันจะสิ้นสุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerel çalışma alanınız bu cihazda kalır. Ücretli senkronizasyon, geçerli fatura döneminin sonuna kadar kullanılabilir kalabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш локальний робочий простір залишається на цьому пристрої. Платна синхронізація може залишатися доступною до завершення поточного періоду виставлення рахунків."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không gian làm việc cục bộ của bạn vẫn ở trên thiết bị này. Đồng bộ trả tiền có thể vẫn khả dụng cho đến khi kỳ thanh toán hiện tại kết thúc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的本地工作区保留在此设备上。付费同步可能保持可用直到当前计费周期结束。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的本機工作區會保留在此裝置上。付費同步可能會保持可用，直到目前計費期間結束。"
          }
        }
      }
    },
