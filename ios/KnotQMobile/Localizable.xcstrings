    "web.guide.scheduling.p_post" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " لإضافة قاعدة تكرار. يمكنك أيضًا إنشاء عناصر مباشرة من التقويم: انقر فوق فترة زمنية للتذكير، أو انقر مع الضغط على المفتاح Shift للمهمة، أو اسحب لإنشاء حدث."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " pro přidání pravidla opakování. Můžete také vytvářet položky přímo z kalendáře: kliknutím na časový slot vytvoříte připomenutí, shift+kliknutím vytvoříte úkol, nebo přetažením vytvoříte událost."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " til at tilføje en gentagelsesregel. Du kan også oprette elementer direkte fra kalenderen: klik på en tidsslot for en påmindelse, shift+klik for en opgave, eller træk for en begivenhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " um eine Wiederholungsregel hinzuzufügen. Sie können auch Elemente direkt aus dem Kalender erstellen: Klicken Sie auf einen Zeitslot für eine Erinnerung, Shift+Klick für eine Aufgabe oder ziehen Sie für ein Ereignis."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " για να προσθέσετε μια κανόνα επανάληψης. Μπορείτε επίσης να δημιουργήσετε στοιχεία απευθείας από το ημερολόγιο: κάντε κλικ σε μια υποδοχή ώρας για μια υπενθύμιση, shift+κλικ για ανάθεση ή σύρστε για γεγονός."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " to add a repeat rule. You can also create items directly from the calendar: click a time slot for a reminder, shift+click for an assignment, or drag for an event."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "para agregar una regla de repetición. También puedes crear elementos directamente desde el calendario: haz clic en un espacio de tiempo para un recordatorio, mayús+clic para una asignación, o arrastra para un evento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " toistosäännön lisäämiseen. Voit myös luoda kohteita suoraan kalenterista: napsauta aikavälillä saadaksesi muistutuksen, shift+napsauta tehtävää varten tai vedä tapahtumaa varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " pour ajouter une règle de répétition. Vous pouvez également créer des éléments directement à partir du calendrier : cliquez sur une tranche horaire pour un rappel, maj+cliquez pour une tâche ou glissez-déposez pour un événement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " כדי להוסיף כלל חזרה. אתה יכול גם ליצור פריטים ישירות מלוח השנה: לחץ על משבצת זמן לתזכורת, shift+לחץ להקצאה, או גרור לאירוע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " दोहराव नियम जोड़ने के लिए। आप कैलेंडर से सीधे आइटम भी बना सकते हैं: रिमाइंडर के लिए समय स्लॉट पर क्लिक करें, असाइनमेंट के लिए shift+क्लिक करें, या इवेंट के लिए ड्रैग करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " az ismétlési szabály hozzáadásához. Közvetlenül a naptárból is létrehozhat tárgyakat: kattintson egy időpontra az emlékeztetőhöz, shift+kattintás a feladathoz, vagy húzza az eseményhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " untuk menambahkan aturan pengulangan. Anda juga dapat membuat item langsung dari kalender: klik slot waktu untuk pengingat, shift+klik untuk penugasan, atau seret untuk acara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " per aggiungere una regola di ripetizione. Puoi anche creare elementi direttamente dal calendario: fai clic su uno slot orario per un promemoria, maiusc+clic per un compito, oppure trascina per un evento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "を使用して繰り返しルールを追加します。カレンダーから直接アイテムを作成することもできます: 時間枠をクリックしてリマインダーを作成するか、Shift+クリックで課題を作成するか、ドラッグでイベントを作成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "를 사용하여 반복 규칙을 추가합니다. 캘린더에서 직접 항목을 만들 수도 있습니다: 알림을 위해 시간 슬롯을 클릭하거나 할당을 위해 Shift+클릭하거나 이벤트를 위해 드래그합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "untuk menambahkan aturan pengulangan. Anda juga dapat membuat item langsung dari kalender: klik slot waktu untuk pengingat, shift+klik untuk penugasan, atau seret untuk acara."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " for å legge til en gjentakelsesregel. Du kan også opprette elementer direkte fra kalenderen: klikk på et tidspunkt for en påminnelse, shift+klikk for en oppgave eller dra for en begivenhet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " om een herhalingsr regel toe te voegen. Je kunt ook items rechtstreeks vanuit de agenda maken: klik op een tijdslot voor een herinnering, shift+klik voor een taak of sleep voor een evenement."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " aby dodać regułę powtarzania. Możesz również tworzyć elementy bezpośrednio z kalendarza: kliknij przedział czasu na przypomnienie, Shift+kliknij na przypisanie lub przeciągnij na zdarzenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " para adicionar uma regra de repetição. Você também pode criar itens diretamente do calendário: clique em um slot de tempo para um lembrete, shift+clique para uma atribuição ou arraste para um evento."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " para adicionar uma regra de repetição. Também pode criar itens diretamente a partir do calendário: clique numa ranhura de tempo para um lembrete, shift+clique para uma atribuição, ou arraste para um evento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " pentru a adăuga o regulă de repetare. Puteți crea, de asemenea, articole direct din calendar: faceți clic pe o fantă de timp pentru un memento, shift+clic pentru o sarcină, sau trageți pentru un eveniment."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "чтобы добавить правило повторения. Вы также можете создавать элементы прямо из календаря: нажмите на временной промежуток для напоминания, shift+нажмите для задания или перетащите для события."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " na pridanie pravidla opakovania. Položky si môžete vytvoriť aj priamo z kalendára: kliknite na časový slot na pripomienku, Shift+kliknite na úlohu alebo pretiahnite na udalosť."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " för att lägga till en upprepningsregel. Du kan också skapa objekt direkt från kalendern: klicka på en tidsslot för en påminnelse, skift+klick för ett uppdrag eller dra för en händelse."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " เพื่อเพิ่มกฎการทำซ้ำ คุณยังสามารถสร้างรายการโดยตรงจากปฏิทิน: คลิกช่องเวลาสำหรับการเตือน shift+คลิกสำหรับการมอบหมาย หรือลากสำหรับเหตุการณ์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tekrar kuralı eklemek için. Takvimden doğrudan öğe oluşturabilirsiniz: hatırlatıcı için bir zaman alanına tıklayın, ödev için shift+tıklayın veya etkinlik için sürükleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " щоб додати правило повтору. Ви також можете створювати елементи безпосередньо з календаря: натисніть на часовий слот для нагадування, shift+натисніть для завдання або перетягніть для подій."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " để thêm quy tắc lặp lại. Bạn cũng có thể tạo mục trực tiếp từ lịch: nhấp vào một khe thời gian để nhắc nhở, shift + nhấp để bài tập hoặc kéo để tạo sự kiện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加重复规则。您还可以直接从日历创建项目：单击时间段添加提醒，Shift+单击添加分配，或拖动添加事件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以新增重複規則。您也可以直接從日曆建立項目：點擊時間槽以設定提醒，按 Shift 點擊以進行指派，或拖動以建立事件。"
          }
        }
      }
    },
