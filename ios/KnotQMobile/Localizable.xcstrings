    "web.account.cancel_confirm_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إلغاء تجديد هذا الاشتراك؟ تبقى المزامنة متاحة حتى نهاية الفترة الحالية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zrušit obnovení tohoto předplatného? Synchronizace zůstane dostupná až do konce aktuálního období."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuller fornyelsen af dette abonnement? Synkronisering forbliver tilgængelig til periodens afslutning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stornieren Sie die Verlängerung für dieses Abonnement? Sync bleibt bis zum Ende des aktuellen Zeitraums verfügbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ακυρώστε την ανανέωση αυτής της συνδρομής; Ο συγχρονισμός παραμένει διαθέσιμος έως το τέλος της τρέχουσας περιόδου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancel renewal for this subscription? Sync stays available until the current period ends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cancelar la renovación de esta suscripción? La sincronización seguirá disponible hasta que termine el período actual."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peruuta tämän tilauksen uusiminen? Synkronointi pysyy käytettävissä nykyisen jakson päättymiseen asti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuler le renouvellement de cet abonnement ? La synchronisation reste disponible jusqu'à la fin de la période actuelle."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בטל את ההחידוש עבור מנוי זה? הסנכרון נשאר זמין עד סוף התקופה הנוכחית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस सदस्यता के लिए नवीकरण रद्द करें? सिंक वर्तमान अवधि के अंत तक उपलब्ध रहता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lemondja az előfizetés megújítását? A szinkronizálás az aktuális időszak végéig elérhető marad."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batalkan pembaruan untuk langganan ini? Sinkronisasi tetap tersedia hingga periode saat ini berakhir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annullare il rinnovo di questa sottoscrizione? La sincronizzazione rimane disponibile fino alla fine del periodo attuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサブスクリプションの更新をキャンセルしますか？同期は現在の期間が終わるまで利用可能です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 구독의 갱신을 취소하시겠습니까? 동기화는 현재 기간이 끝날 때까지 사용 가능합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batalkan pembaruan untuk langganan ini? Sinkron tetap tersedia hingga tempoh semasa berakhir."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avbestille fornyelse av dette abonnementet? Synk forblir tilgjengelig til slutten av den nåværende perioden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlenging van dit abonnement annuleren? Sync blijft beschikbaar tot het einde van de huidige periode."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anulować odnowienie tej subskrypcji? Synchronizacja będzie dostępna do końca bieżącego okresu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancelar a renovação desta assinatura? A sincronização permanecerá disponível até o final do período atual."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancelar a renovação desta subscrição? A sincronização permanece disponível até ao fim do período atual."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anulați reînnoirea pentru acest abonament? Sincronizarea rămâne disponibilă până la sfârșitul perioadei curente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отменить автоматическое продление для этой подписки? Синхронизация остаётся доступной до конца текущего периода."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zrušiť obnovu tohto predplatného? Synchronizácia zostáva dostupná až do konca aktuálneho obdobia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avbryta förnyelsen för denna prenumeration? Synkronisering förblir tillgänglig tills den aktuella perioden slutar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยกเลิกการต่ออายุสำหรับการสมัครสมาชิกนี้หรือไม่ Sync จะคงอยู่ได้จนสิ้นสุดช่วงเวลาปัจจุบัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu aboneliğin yenilemesi iptal edilsin mi? Senkronizasyon geçerli dönem sonuna kadar kullanılabilir kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скасувати поновлення цієї підписки? Синхронізація залишається доступною до закінчення поточного періоду."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hủy gia hạn cho đăng ký này? Đồng bộ vẫn khả dụng cho đến khi khoảng thời gian hiện tại kết thúc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消此订阅的续订？同步将保持可用直到当前期限结束。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消此訂閱的續約？同步在目前週期結束前保持可用。"
          }
        }
      }
    },
