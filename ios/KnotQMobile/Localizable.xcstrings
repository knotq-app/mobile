    "web.delete_account.kept_backups_logs_trailing" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد تحتوي على نسخ متبقية لفترة قصيرة قبل انتهاء صلاحيتها في دورة الدوران العادية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mohou obsahovat zbývající kopie na krátkou dobu, než vypadnou z jejich normálního cyklu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "kan indeholde resterende kopier i en kort periode, før de udgår på deres normale rotation."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "können für einen kurzen Zeitraum residuelle Kopien enthalten, bevor sie auf ihrer normalen Rotation auslaufen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "μπορεί να περιέχουν υπολειπόμενα αντίγραφα για μια σύντομη περίοδο πριν εξαφανιστούν στην κανονική τους περιστροφή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "may contain residual copies for a short period before they age out on their normal rotation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "pueden contener copias residuales durante un corto período antes de que se agoten en su rotación normal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "saattavat sisältää jäljelle jääneitä kopioita lyhyen ajan ennen kuin ne poistetaan normaalin kiertosäädön mukaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "peut contenir des copies résiduelles pendant une courte période avant leur suppression lors de leur rotation normale."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עלול להכיל עותקי שיור לתקופה קצרה לפני שהם מתיישנים במחזורם הרגיל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उनके सामान्य रोटेशन पर समाप्त होने से पहले थोड़े समय के लिए अवशेष प्रतियां रख सकते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "rövid ideig tartalmazhatnak maradék másolatokat, mielőtt kiöregednek a normál cikluson."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mungkin berisi salinan sisa untuk waktu singkat sebelum mereka keluar pada rotasi normal mereka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "possono contenere copie residue per un breve periodo prima che si esauriscano nella loro rotazione normale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "は通常のローテーション対象となる前に、短期間残存コピーが含まれる可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단기간 동안 잔존 복사본을 포함할 수 있으며, 정상적인 로테이션에서 제거되기 전까지 유지됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mungkin berisi salinan sisa untuk waktu singkat sebelum mereka kadaluarsa pada rotasi normal mereka."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "kan inneholde residuale kopier i en kort periode før de aldreres på sin normale rotasjon."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "kunnen gedurende een korte periode restantexemplaren bevatten voordat deze in hun normale circulatie verouderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mogą zawierać pozostałe kopie przez krótki okres, zanim wygasną w zwykłej rotacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "podem conter cópias residuais por um curto período antes de serem descartadas em sua rotação normal."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "podem conter cópias residuais por um curto período antes de expirem na sua rotação normal."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "pot conține copii reziduale pentru o scurtă perioadă înainte de a fi puse la discard în rotația normală."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "могут содержать остаточные копии в течение короткого периода, прежде чем они устаревают при обычной ротации."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "môžu obsahovať zvyšné kópie na krátku dobu, kým sa nevyčistia podľa normálneho plánu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "kan innehålla restanta kopior under en kort period innan de åldras på sin normala rotationsschema."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อาจมีสำเนาคงเหลือในช่วงเวลาสั้น ๆ ก่อนที่จะหมดอายุตามรอบการหมุนเวียนปกติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "kısa bir süre boyunca artık yedek kopyalar içerebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "можуть містити залишкові копії протягом короткого періоду, перш ніж вони застаріють на своєму звичайному цикліку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "có thể chứa các bản sao còn lại trong một thời gian ngắn trước khi chúng hết hạn theo quay vòng thường xuyên của chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在正常轮换之前可能包含残余副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可能在正常輪換之前的短期內包含殘留副本。"
          }
        }
      }
    },
