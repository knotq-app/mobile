          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đăng ký của bạn đã bị hủy. Đồng bộ vẫn hoạt động cho đến khi khoảng thời gian hiện tại kết thúc. Kích hoạt lại từ những đăng ký tài khoản Apple của bạn."
