        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrir le résultat de recherche sélectionné, confirmer le renommage ou fermer une fenêtre contextuelle d'événement"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פתח את תוצאת החיפוש הנבחרת, אשר שם הודעה, או סגור popup אירוע"
