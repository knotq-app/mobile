    "web.home.pitch.tile1_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خطط من كل خطة، بالإضافة إلى Google Calendar، في عرض أسبوع واحد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plány ze všech schémat plus váš Kalendář Google v jednom pohledu na týden."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planer fra ethvert skema plus din Google Calendar i en enkelt ugevisning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pläne aus jedem Scheme, plus Ihr Google Calendar, in einer einzigen Wochenansicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σχέδια από κάθε σχέδιο, συν το Google Calendar, σε μια μόνο προβολή εβδομάδας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plans from every scheme, plus your Google Calendar, in a single week view."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planes de cada esquema, más tu Google Calendar, en una única vista semanal."
