    "onboarding.sync_prompt.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المزامنة بقيمة 3.99 دولار شهرياً تسمح لك بمشاركة مساحة العمل عبر الأجهزة. المحلية فقط مجانية بالكامل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizace stojí 3,99 $ za měsíc a umožňuje vám sdílet pracovní prostor v zařízeních. Pouze lokální je zcela zdarma."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronisering koster $3,99 pr. måned og lader dig dele dit arbejdsområde på tværs af enheder. Kun lokal er helt gratis."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisierung kostet 3,99 $ pro Monat und ermöglicht es Ihnen, Ihren Arbeitsbereich auf Geräten zu teilen. Nur lokal ist völlig kostenlos."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο συγχρονισμός κοστίζει 3,99 $ ανά μήνα και σας επιτρέπει να μοιράζεστε τον χώρο εργασίας σας σε συσκευές. Η τοπική χρήση είναι εντελώς δωρεάν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync is $3.99 a month and lets you share your workspace across devices. Local-only is fully free."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización cuesta $3.99 al mes y te permite compartir tu espacio de trabajo en todos los dispositivos. Solo local es completamente gratis."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronointi maksaa 3,99 $ kuukaudessa ja antaa sinun jakaa työtilaa laitteiden välillä. Pelkkä paikallinen käyttö on täysin ilmaista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation coûte 3,99 $ par mois et vous permet de partager votre espace de travail entre appareils. Local uniquement est entièrement gratuit."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סנכרון עולה $3.99 בחודש ומאפשר לך לשתף את מרחב העבודה שלך בין התקנים. רק מקומי הוא בחינם לחלוטין."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिंक $3.99 प्रति माह है और आपको अपने कार्यक्षेत्र को उपकरणों में साझा करने देता है। केवल स्थानीय पूरी तरह मुफ़्त है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szinkronizálás havonta 3,99 dollár, és lehetővé teszi a munkaterület megosztását az eszközök között. A csak helyi verzió teljesen ingyenes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinkronisasi biaya $3,99 per bulan dan memungkinkan Anda berbagi ruang kerja di perangkat. Lokal-saja sepenuhnya gratis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync è $3.99 al mese e ti consente di condividere il tuo workspace tra dispositivi. Solo locale è completamente gratuito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期は月額 $3.99 で、ワークスペースをデバイス間で共有できます。ローカルのみは完全に無料です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동기화는 월 $3.99이며 기기 간에 작업 영역을 공유할 수 있습니다. 로컬 전용은 완전히 무료입니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segerakan adalah $3.99 sebulan dan membolehkan anda berkongsi ruang kerja anda di semua peranti. Tempatan sahaja adalah percuma sepenuhnya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronisering koster $3,99 per måned og lar deg dele arbeidsrommet ditt på tvers av enheter. Lokalt er helt gratis."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisatie kost $3,99 per maand en laat je je werkruimte over apparaten delen. Alleen lokaal is volledig gratis."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizacja to 3,99 USD miesięcznie i pozwala udostępniać obszar roboczy na urządzeniach. Tylko lokalne jest całkowicie bezpłatne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronização é $3,99 por mês e permite compartilhar seu espaço de trabalho entre dispositivos. Apenas local é totalmente gratuito."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync custa $3,99 por mês e permite-lhe partilhar o seu espaço de trabalho em dispositivos. Local-only é completamente gratuito."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizarea costă 3,99 USD pe lună și vă permite să partajați spațiul de lucru pe mai multe dispozitive. Doar local este complet gratuit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизация стоит $3,99 в месяц и позволяет вам делиться рабочим пространством между устройствами. Только локальное — полностью бесплатно."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizácia stojí 3,99 USD mesačne a umožňuje vám zdieľať pracovný priestor na viacerých zariadeniach. Lokálne je úplne bezplatné."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronisering kostar $3,99 per månad och låter dig dela din arbetsyta mellan enheter. Endast lokalt är helt kostnadsfritt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync คือ $3.99 ต่อเดือน และให้คุณแชร์พื้นที่ทำงานของคุณบนอุปกรณ์ต่างๆ Local-only ฟรีทั้งหมด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senkronizasyon aylık 3,99$ ve çalışma alanınızı cihazlar arasında paylaşmanıza izin verir. Yalnızca yerel tamamen ücretsizdir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронізація коштує 3,99 доларів США на місяць і дозволяє спільно використовувати робочий простір на пристроях. Тільки локально є повністю безплатно."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đồng bộ là $3.99 một tháng và cho phép bạn chia sẻ không gian làm việc của bạn trên các thiết bị. Cục bộ chỉ hoàn toàn miễn phí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步每月 $3.99，让您在设备间共享工作区。仅本地完全免费。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步每月 $3.99，可讓您跨裝置共享工作區。僅限本機使用完全免費。"
          }
        }
      }
