    "web.home.faq.q2_answer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تماما. KnotQ محلي أولاً: خططك ومهامك وتقويمك تعيش في ملفات عادية على جهازك وتعمل بدون اتصال بالإنترنت. المزامنة اختيارية وإضافية — حتى مع تشغيل المزامنة، يستمر KnotQ في العمل بالكامل بدون اتصال وتتم مزامنة التعديلات الخاصة بك تلقائيًا بمجرد عودتك إلى الإنترنت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zcela. KnotQ je místně první: vaše schémata, úkoly a kalendář žijí v prostých souborech na vašem zařízení a fungují bez připojení k internetu. Synchronizace je volitelná a přídavná — i když je synchronizace zapnutá, KnotQ nadále funguje zcela offline a vaše úpravy se synchronizují automaticky, jakmile se vrátíte online."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helt og holdent. KnotQ er lokalt først: dine skemaer, opgaver og kalender lever i almindelige filer på din enhed og fungerer uden internetforbindelse. Synkronisering er valgfri og tilføjet — selv med synkronisering tændt, fungerer KnotQ helt offline, og dine redigeringer synkroniseres automatisk, når du er tilbage online."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Absolut. KnotQ ist lokal-first: Ihre Schemes, Aufgaben und Kalender befinden sich in einfachen Dateien auf Ihrem Gerät und funktionieren ohne Internetverbindung. Synchronisierung ist optional und additiv — selbst wenn die Synchronisierung aktiviert ist, funktioniert KnotQ vollständig offline und Ihre Bearbeitungen werden automatisch synchronisiert, wenn Sie wieder online sind."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ολοκληρωτικά. Το KnotQ είναι τοπικό πρώτο: τα σχέδιά σας, οι εργασίες και το ημερολόγιό σας ζουν σε απλά αρχεία στη συσκευή σας και λειτουργούν χωρίς σύνδεση στο internet. Ο συγχρονισμός είναι προαιρετικός και προσθετικός — ακόμη και με την ενεργοποίησή του, το KnotQ συνεχίζει να λειτουργεί πλήρως χωρίς σύνδεση και οι επεξεργασίες σας συγχρονίζονται αυτόματα μόλις επιστρέψετε σε σύνδεση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completely. KnotQ is local-first: your schemes, tasks, and calendar live in plain files on your device and work without an internet connection. Sync is optional and additive — even with sync turned on, KnotQ keeps working fully offline and your edits sync automatically once you’re back online."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completamente. KnotQ es local-first: tus esquemas, tareas y calendario viven en archivos simples en tu dispositivo y funcionan sin conexión a internet. La sincronización es opcional y aditiva — incluso con sincronización activada, KnotQ sigue funcionando completamente sin conexión y tus ediciones se sincronizan automáticamente una vez que estés de vuelta en línea."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Täysin. KnotQ on paikallinen ensin: kaaviot, tehtävät ja kalenteri elävät tavallisissa tiedostoissa laitteellasi ja toimivat ilman internet-yhteyttä. Synkronointi on vapaaehtoinen ja lisäävä — jopa kun synkronointi on päällä, KnotQ jatkaa täysin offline-toimintaa ja muutoksesi synkronoidaan automaattisesti, kun olet takaisin online-tilassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Complètement. KnotQ est d'abord local : vos schémas, tâches et calendrier vivent dans des fichiers simples sur votre appareil et fonctionnent sans connexion Internet. La synchronisation est optionnelle et supplémentaire — même avec la synchronisation activée, KnotQ continue de fonctionner entièrement hors ligne et vos modifications se synchronisent automatiquement une fois que vous êtes de retour en ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לחלוטין. KnotQ הוא מקומי קדם: הסכמות שלך, המשימות ולוח השנה חיים בקבצים פשוטים בהתקן שלך ועובדים ללא חיבור אינטרנט. סנכרון הוא אופציונלי תוסף — אפילו עם סנכרון פעיל, KnotQ ממשיך לעבוד במלואו ללא חיבור ועריכות שלך מסנכרנות באופן אוטומטי ברגע שאתה בחזרה באינטרנט."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिल्कुल। KnotQ स्थानीय-प्रथम है: आपकी योजनाएं, कार्य, और कैलेंडर आपके डिवाइस पर सादी फ़ाइलों में रहते हैं और इंटरनेट कनेक्शन के बिना काम करते हैं। सिंक वैकल्पिक और अतिरिक्त है — भले ही सिंक चालू हो, KnotQ पूरी तरह से ऑफलाइन काम करता रहता है और आपके संपादन स्वचालित रूप से सिंक होते हैं जब आप फिर से ऑनलाइन आते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teljesen. A KnotQ helyi-első: a sémák, feladatok és naptár egyszerû fájlokként élnek az eszközén és internetkapcsolat nélkül működnek. A szinkronizálás opcionális és adalék — még szinkronizálás bekapcsolásával is a KnotQ teljesen offline működik, és a szerkesztések automatikusan szinkronizálódnak, amikor újra online vagy."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sepenuhnya. KnotQ adalah lokal-pertama: skema, tugas, dan kalender Anda hidup dalam file biasa di perangkat Anda dan bekerja tanpa koneksi internet. Sinkronisasi opsional dan aditif — bahkan dengan sinkronisasi aktif, KnotQ terus bekerja sepenuhnya offline dan pengeditan Anda disinkronkan secara otomatis setelah Anda kembali online."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completamente. KnotQ è local-first: i tuoi schemi, compiti e calendario vivono in file semplici sul tuo dispositivo e funzionano senza una connessione a Internet. La sincronizzazione è facoltativa e additiva — anche con la sincronizzazione attivata, KnotQ continua a funzionare completamente offline e i tuoi modifiche si sincronizzano automaticamente una volta che sei di nuovo online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全です。KnotQはローカルファーストです: スキーム、タスク、カレンダーはデバイス上のプレーンファイルに存在し、インターネット接続なしで機能します。Syncはオプションで追加的 — 同期がオンになっていても、KnotQは完全にオフラインで機能し続け、オンラインに戻ると編集は自動的に同期されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "완전히. KnotQ는 로컬 우선입니다: 스킴, 작업 및 캘린더는 디바이스의 일반 파일로 존재하며 인터넷 연결 없이 작동합니다. 동기화는 선택적이며 추가적입니다 — 동기화가 켜져 있어도 KnotQ는 완전히 오프라인으로 작동하며 온라인이 되면 편집 내용이 자동으로 동기화됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sepenuhnya. KnotQ adalah lokal-pertama: skema, tugas, dan kalender Anda hidup dalam file biasa di perangkat Anda dan berfungsi tanpa koneksi internet. Sinkronisasi adalah opsional dan aditif — bahkan dengan sinkronisasi aktif, KnotQ terus bekerja sepenuhnya secara offline dan suntingan Anda disinkronkan secara otomatis setelah Anda kembali online."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helt og holdent. KnotQ er lokalt-først: skjemaene, oppgavene og kalenderen dine lever i enkle filer på enheten din og fungerer uten internettforbindelse. Synkronisering er valgfri og tilleggsfunksjon – selv med synkronisering slått på, fortsetter KnotQ å fungere helt offline og redigeringene dine synkroniseres automatisk når du er tilbake på nettet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volledig. KnotQ is eerst lokaal: je schema's, taken en agenda bevinden zich in gewone bestanden op je apparaat en werken zonder internetverbinding. Synchronisatie is optioneel en aanvullend — zelfs met synchronisatie ingeschakeld werkt KnotQ volledig offline en synchroniseren je wijzigingen automatisch wanneer je weer online bent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Całkowicie. KnotQ jest lokalnie-pierwszą: Twoje schematy, zadania i kalendarz znajdują się w zwykłych plikach na Twoim urządzeniu i działają bez połączenia internetowego. Synchronizacja jest opcjonalna i dodatkowaniem — nawet z włączoną synchronizacją, KnotQ nadal działa w pełni offline, a Twoje edycje synchronizują się automatycznie, gdy wrócisz do Internetu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completamente. KnotQ é local primeiro: seus esquemas, tarefas e calendário vivem em arquivos simples em seu dispositivo e funcionam sem uma conexão com a internet. A sincronização é opcional e aditiva — mesmo com a sincronização ativada, o KnotQ continua funcionando completamente offline e suas edições sincronizam automaticamente quando você estiver online novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totalmente. O KnotQ é local-first: os seus esquemas, tarefas e calendário vivem em ficheiros simples no seu dispositivo e funcionam sem uma ligação à Internet. A sincronização é opcional e aditiva — mesmo com a sincronização ativada, o KnotQ continua a funcionar totalmente offline e as suas edições sincronizam-se automaticamente assim que voltar a estar online."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Complet. KnotQ este local-first: schemele, sarcinile și calendarul dvs. trăiesc în fișiere simple pe dispozitivul dvs. și funcționează fără o conexiune la internet. Sincronizarea este opțională și aditivă — chiar și cu sincronizarea activată, KnotQ continuă să funcționeze complet offline și edițiile dvs. se sincronizează automat odată ce sunteți din nou online."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полностью. KnotQ — это локальная-первая система: ваши схемы, задачи и календарь живут в простых файлах на вашем устройстве и работают без подключения к Интернету. Синхронизация опциональна и дополнительна — даже с включённой синхронизацией KnotQ полностью работает в автономном режиме и ваши правки синхронизируются автоматически, когда вы снова в сети."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úplne. KnotQ je miestne založený: vaše schémy, úlohy a kalendár sú v jednoduchých súboroch na vašom zariadení a fungujú bez internetového pripojenia. Synchronizácia je voliteľná a dodatková — aj keď je synchronizácia zapnutá, KnotQ funguje úplne offline a vaše úpravy sa automaticky synchronizujú, keď ste späť online."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helt och hållet. KnotQ är lokalt först: dina scheman, uppgifter och kalender bor i vanliga filer på din enhet och fungerar utan internetanslutning. Synkronisering är valfri och additiv — även med synkronisering påslagen fungerar KnotQ helt offline och dina redigeringar synkroniseras automatiskt när du är tillbaka online."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อย่างสิ้นเชิง KnotQ เป็นเครื่องหมายแรกท้องถิ่น: โครงการ งาน และปฏิทินของคุณอยู่ในไฟล์ธรรมดาบนอุปกรณ์ของคุณและทำงานโดยไม่ต้องเชื่อมต่ออินเทอร์เน็ต การซิงค์เป็นแบบทางเลือกและเพิ่มเติม — แม้ว่าจะเปิดการซิงค์ KnotQ ก็ยังทำงานออฟไลน์อย่างเต็มรูปแบบและการแก้ไขของคุณจะซิงค์โดยอัตโนมัติเมื่อคุณกลับมาออนไลน์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamamen. KnotQ yerel-ilk: şemalarınız, görevleriniz ve takvim, cihazınızda düz dosyalarda yaşar ve internet bağlantısı olmadan çalışır. Senkronizasyon isteğe bağlı ve katkı niteliğindedir — senkronizasyon açık olsa bile, KnotQ tamamen çevrimdışı çalışmaya devam eder ve düzenlemeleriniz çevrimiçi olduğunuz anda otomatik olarak senkronize olur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Абсолютно. KnotQ є локальним: ваші схеми, завдання та календар живуть як звичайні файли на вашому пристрої й працюють без підключення до інтернету. Синхронізація необов'язкова й адитивна — навіть з увімкненою синхронізацією, KnotQ продовжує повністю працювати в автономному режимі, а ваші редагування синхронізуються автоматично, коли ви повернетесь в режим онлайну."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoàn toàn. KnotQ là cục bộ-trước tiên: các lược đồ, tác vụ và lịch của bạn sống trong các tệp đơn giản trên thiết bị của bạn và hoạt động mà không cần kết nối internet. Đồng bộ là tùy chọn và bổ sung — ngay cả khi bật tính năng đồng bộ, KnotQ tiếp tục hoạt động hoàn toàn ngoại tuyến và các chỉnh sửa của bạn được đồng bộ tự động khi bạn quay lại trực tuyến."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全。KnotQ 是本地优先的：您的方案、任务和日历存储在设备上的纯文本文件中，无需互联网连接即可运行。同步是可选的且附加的 — 即使启用了同步，KnotQ 也可以完全离线工作，并且您的编辑在重新联机后会自动同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全是。KnotQ 是本機優先的：您的規劃方案、任務和日曆存在於您裝置上的純文字檔案中，無需網際網路連線即可運作。同步是可選的且是附加的 — 即使開啟同步，KnotQ 仍然完全離線運作，您的編輯會在恢復在線後自動同步。"
          }
        }
      }
    },
