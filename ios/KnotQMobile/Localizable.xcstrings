    "web.guide.google_calendar.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لـ KnotQ عرض أحداث Google Calendar الخاصة بك إلى جانب خططك (قراءة فقط في الوقت الحالي). يمكنك إنشاء خطة Google Calendar جديدة بالضغط على جديد في الشريط الجانبي الأيسر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ může zobrazovat vaše události Kalendáře Google vedle vašich schémat (zatím pouze pro čtení). Nové schéma Kalendáře Google můžete vytvořit stisknutím tlačítka nový na levém bočním panelu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ kan vise dine Google Calendar-begivenheder ved siden af dine skemaer (skrivebeskyttet for nu). Du kan oprette et nyt Google Calendar-skema ved at trykke på nyt i venstre sidebjælke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ kann Ihre Google Calendar-Ereignisse neben Ihren Schemes anzeigen (für jetzt nur-lesbar). Sie können ein neues Google Calendar-Scheme erstellen, indem Sie in der linken Seitenleiste auf „Neu“ drücken."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το KnotQ μπορεί να εμφανίσει τα γεγονότα του Google Calendar σας δίπλα στα σχέδιά σας (προς το παρόν μόνο για ανάγνωση). Μπορείτε να δημιουργήσετε ένα νέο σχέδιο Google Calendar πατώντας νέο στην αριστερή πλευρική γραμμή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ can display your Google Calendar events alongside your schemes (read-only for now). You can create a new Google Calendar scheme by pressing new in the left sidebar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ puede mostrar tus eventos de Google Calendar junto con tus esquemas (solo lectura por ahora). Puedes crear un nuevo esquema de Google Calendar presionando nuevo en la barra lateral izquierda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ voi näyttää Google Calendarin tapahtumat kaavioiden rinnalla (vain luku-tilassa toistaiseksi). Voit luoda uuden Google Calendarin kaavion painamalla uutta vasemmassa sivupalkkissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ peut afficher vos événements Google Calendrier aux côtés de vos schémas (lecture seule pour l'instant). Vous pouvez créer un nouveau schéma Google Calendrier en appuyant sur nouveau dans la barre latérale gauche."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ יכול להציג את אירועי Google Calendar שלך לצד הסכמות שלך (קריאה בלבד לעת עתה). אתה יכול ליצור סכמת Google Calendar חדשה על ידי לחיצה על + חדש בסרגל הצד השמאלי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ आपके Google कैलेंडर इवेंट को आपकी योजनाओं के साथ प्रदर्शित कर सकता है (अभी के लिए केवल पढ़ने के लिए)। आप बाईं ओर की साइडबार में नया दबाकर एक नई Google कैलेंडर योजना बना सकते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A KnotQ megjelenítheti a Google Naptár eseményeit a sémáid mellett (jelenleg csak olvasásra). A bal oldali sáv új megnyomásával új Google Naptár sémát hozhatsz létre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ dapat menampilkan acara Google Calendar Anda bersama skema Anda (hanya baca untuk saat ini). Anda dapat membuat skema Google Calendar baru dengan menekan baru di bilah sisi kiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ può visualizzare gli eventi di Google Calendar insieme ai tuoi schemi (per ora solo lettura). Puoi creare un nuovo schema di Google Calendar premendo new nella barra laterale sinistra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQはGoogle Calendarイベントをスキームと並べて表示できます（現在のところ読み取り専用）。左側のサイドバーで新規を押して、新しいGoogle Calendarスキームを作成できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ는 Google Calendar 이벤트를 스킴과 함께 표시할 수 있습니다(현재 읽기 전용). 왼쪽 사이드바에서 새로 만들기를 눌러 새 Google Calendar 스킴을 만들 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ dapat menampilkan acara Google Calendar Anda bersama skema Anda (baca-saja untuk saat ini). Anda dapat membuat skema Google Calendar baru dengan menekan baru di bilah sisi kiri."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ kan vise Google Calendar-hendelsene dine sammen med skjemaene dine (bare lesing for nå). Du kan opprette et nytt Google Calendar-skjema ved å trykke på nytt i venstre sidestolpe."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ kan je Google Calendar-evenementen naast je schema's weergeven (alleen-lezen voor nu). Je kunt een nieuw Google Calendar-schema maken door nieuw in de linkerzijbalk in te drukken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ może wyświetlać zdarzenia Twojego Google Calendar obok Twoich schematów (na razie tylko do odczytu). Możesz utworzyć nowy schemat Google Calendar, naciskając przycisk nowy na lewym pasku bocznym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O KnotQ pode exibir seus eventos do Google Calendar junto com seus esquemas (somente leitura por enquanto). Você pode criar um novo esquema do Google Calendar pressionando novo na barra lateral esquerda."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O KnotQ pode exibir os seus eventos do Google Calendar juntamente com os seus esquemas (apenas leitura por enquanto). Pode criar um novo esquema do Google Calendar pressionando novo na barra lateral esquerda."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ poate afișa evenimentele dvs. Google Calendar alături de schemele dvs. (doar pentru citire în prezent). Puteți crea o nouă schemă Google Calendar prin apăsarea noii în bara laterală din stânga."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ может отображать события вашего Google Календаря наряду с вашими схемами (пока только для чтения). Вы можете создать новую схему Google Календаря, нажав кнопку создания в левой боковой панели."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ môže zobraziť vaše udalosti z Kalendára Google vedľa vašich schém (zatiaľ iba na čítanie). Novú schému Kalendára Google môžete vytvoriť stlačením tlačidla Nový v ľavom bočnom paneli."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ kan visa dina Google Calendar-händelser tillsammans med dina scheman (för närvarande endast läsa). Du kan skapa ett nytt Google Calendar-schema genom att trycka på nytt i den vänstra sidofältet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ สามารถแสดงเหตุการณ์ Google Calendar ของคุณควบคู่ไปกับโครงการของคุณ (อ่านอย่างเดียวตอนนี้) คุณสามารถสร้างโครงการ Google Calendar ใหม่ได้โดยกดเพิ่มเติมในแถบด้านข้างด้านซ้าย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ, Google Takvim etkinliklerinizi şemalarınızın yanında görüntüleyebilir (şimdilik yalnızca okunur). Sol kenar çubuğundaki yeni'ye basarak yeni bir Google Takvim şeması oluşturabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ може відображати ваші события Google Календаря поряд з вашими схемами (на даний момент лише для читання). Ви можете створити нову схему Google Календаря, натиснувши на кнопку «Новий» на лівій бічній панелі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ có thể hiển thị các sự kiện Lịch Google của bạn cùng với các lược đồ của bạn (hiện tại chỉ đọc). Bạn có thể tạo lược đồ Lịch Google mới bằng cách nhấn mục mới trong thanh bên trái."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ 可以在您的方案旁边显示您的 Google Calendar 事件（目前为只读）。您可以通过在左侧栏中按\"新建\"来创建新的 Google Calendar 方案。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ 可以在您的規劃方案旁邊顯示您的 Google Calendar 事件（目前為唯讀）。您可以通過按左側邊欄中的新增來建立新的 Google Calendar 規劃方案。"
          }
        }
      }
    },
