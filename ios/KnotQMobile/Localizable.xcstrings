    "mobile.subscription.sync_off_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى مساحة العمل المحلية على هذا الجهاز، ويمكنك تسجيل الدخول لاحقاً لإعادة تمكين المزامنة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš místní pracovní prostor zůstává v tomto zařízení a později se můžete přihlásit znovu a znovu povolit synchronizaci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit lokale arbejdsområde forbliver på denne enhed, og du kan logge ind igen senere for at genaktivere synkronisering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr lokaler Arbeitsbereich bleibt auf diesem Gerät, und Sie können sich später erneut anmelden, um die Synchronisierung erneut zu aktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο τοπικός σας χώρος εργασίας παραμένει σε αυτήν τη συσκευή και μπορείτε να συνδεθείτε ξανά αργότερα για να επανενεργοποιήσετε τη συγχρονισμό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your local workspace stays on this device, and you can sign in again later to re-enable sync."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu espacio de trabajo local permanece en este dispositivo y puedes iniciar sesión más tarde para reactivar la sincronización."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paikallinen työtila säilyy tässä laitteessa, ja voit kirjautua sisään uudelleen myöhemmin synkronoinnin ottamiseksi käyttöön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre espace de travail local reste sur cet appareil, et vous pouvez vous reconnecter plus tard pour réactiver la synchronisation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מרחב העבודה המקומי שלך נשאר בהתקן זה, ותוכל להיכנס שוב מאוחר יותר כדי להפעיל את הסנכרון מחדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका स्थानीय कार्यक्षेत्र इस उपकरण पर रहता है, और आप बाद में फिर से साइन इन कर सकते हैं सिंक को फिर से सक्षम करने के लिए।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A helyi munkaterület marad ezen az eszközön, és később újra bejelentkezhetsz a szinkronizálás újraengedélyezéséhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruang kerja lokal Anda tetap di perangkat ini, dan Anda dapat masuk lagi nanti untuk mengaktifkan kembali sinkronisasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo workspace locale rimane su questo dispositivo e puoi accedere di nuovo più tardi per riabilitare la sincronizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルワークスペースはこのデバイスに残ります。後で再度サインインして同期を再度有効にできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 작업 영역은 이 기기에 유지되며, 나중에 다시 로그인하여 동기화를 다시 활성화할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruang kerja tempatan anda tetap di peranti ini, dan anda boleh daftar masuk semula kemudian untuk mendayakan semula segerakan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbeidsrommet ditt lokalt blir værende på denne enheten, og du kan logge inn igjen senere for å re-aktivere synkronisering."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je lokale werkruimte blijft op dit apparaat, en je kunt je later opnieuw aanmelden om synchronisatie opnieuw in te schakelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój lokalny obszar roboczy pozostaje na tym urządzeniu i możesz zalogować się ponownie, aby ponownie włączyć synchronizację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu espaço de trabalho local permanece neste dispositivo, e você pode entrar novamente mais tarde para reativar a sincronização."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu espaço de trabalho local permanece neste dispositivo, e pode iniciar sessão novamente mais tarde para reativar a sincronização."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spațiul de lucru local rămâne pe acest dispozitiv și puteți să vă reconectați mai târziu pentru a reactiva sincronizarea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваше локальное рабочее пространство остается на этом устройстве, и вы можете позже снова войти, чтобы повторно включить синхронизацию."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš lokálny pracovný priestor zostáva v tomto zariadení a neskôr sa môžete prihlásiť znova, aby ste znova povolili synchronizáciu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din lokala arbetsyta förblir på denna enhet, och du kan logga in igen senare för att återaktivera synkronisering."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พื้นที่ทำงานท้องถิ่นของคุณยังคงอยู่บนอุปกรณ์นี้ และคุณสามารถลงชื่อเข้าอีกครั้งในภายหลังเพื่อเปิดใช้งานการซิงค์อีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerel çalışma alanınız bu cihazda kalır ve senkronizasyonu yeniden etkinleştirmek için daha sonra tekrar oturum açabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш локальний робочий простір залишається на цьому пристрої, й ви можете увійти пізніше, щоб повторно ввімкнути синхронізацію."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không gian làm việc cục bộ của bạn vẫn ở trên thiết bị này, và bạn có thể đăng nhập lại sau để bật lại đồng bộ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的本地工作区保留在此设备上，您可以稍后再次登录以重新启用同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的本機工作區會保留在此裝置上，您稍後可以重新登入以重新啟用同步。"
          }
        }
      }
    },
