    "web.verify.hint_error" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح KnotQ، وانتقل إلى حساب المزامنة، وأعد إرسال بريد التحقق للحصول على رابط جديد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevřete KnotQ, jděte do účtu synchronizace a znovu odešlete ověřovací e-mail, abyste získali nový odkaz."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn KnotQ, gå til synkroniseringskontoen, og send verifikations-e-mailen igen for at få et nyt link."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie KnotQ, wechseln Sie zum Sync-Konto und senden Sie die Überprüfungs-E-Mail erneut, um einen neuen Link zu erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανοίξτε το KnotQ, μεταβείτε στο λογαριασμό συγχρονισμού και ξαναστείλτε το email επαλήθευσης για να λάβετε ένα φρέσκο σύνδεσμο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open KnotQ, go to the sync account, and resend the verification email to get a fresh link."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre KnotQ, ve a la cuenta de sincronización y reenvía el correo de verificación para obtener un enlace fresco."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa KnotQ, siirry synkronointi-tiliin ja lähetä vahvistussähköposti uudelleen saadaksesi uuden linkin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez KnotQ, accédez au compte de synchronisation et renvoyez l'e-mail de vérification pour obtenir un lien frais."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פתח KnotQ, לך לחשבון הסנכרון, ושלח שנית את דוא״ל האימות כדי לקבל קישור טרייה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ खोलें, सिंक खाते पर जाएं, और एक नया लिंक प्राप्त करने के लिए सत्यापन ईमेल फिर से भेजें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyissa meg a KnotQ-t, lépjen a szinkronizálási fiókra, és küldje újra az ellenõrzési e-mailt egy friss hivatkozásért."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka KnotQ, buka akun sinkronisasi, dan kirim kembali email verifikasi untuk mendapatkan tautan baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri KnotQ, vai all'account di sincronizzazione e invia nuovamente l'email di verifica per ottenere un link fresco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
