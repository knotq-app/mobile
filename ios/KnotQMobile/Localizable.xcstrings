    "web.home.features.daily.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصف اليومي قائمة اليوم القصيرة. أي شيء لا تنهيه ينتقل إلى غد؛ ما تنهيه يبقى خلفك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denní fronta je dnešní krátký seznam. Cokoli, co nedokončíte, se přesune na zítřek; co dokončíte, zůstane vzadu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daglig Kø er dagens korte liste. Det, du ikke afslutter, ruller ind i morgen; det, du afslutter, bliver tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Daily Queue ist Ihre heutige kurze Liste. Was Sie nicht fertigstellen, läuft in morgen über; was Sie fertigstellen, bleibt dahinter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η Ημερήσια Ουρά είναι η λίστα σήμερα. Ό,τι δεν τελειώσετε κυλά σε αύριο· ό,τι τελειώσετε παραμένει πίσω."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Daily Queue is today’s short list. Whatever you don’t finish rolls into tomorrow; what you finish stays behind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cola diaria es la lista corta de hoy. Lo que no termines se transfiere a mañana; lo que termines se queda atrás."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päivittäinen jono on tämän päivän lyhyt lista. Mitä et lopeta, vierii huomiseen; mitä lopetit, jää taakse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La file d'attente quotidienne est la liste courte d'aujourd'hui. Tout ce que vous n'avez pas terminé se reportera à demain ; ce que vous terminez reste en arrière."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התור היומי היא רשימה קצרה של היום. כל מה שלא תשלים קדימה ליום מחר; מה שאתה סיים נשארת מאחור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दैनिक कतार आज की छोटी सूची है। जो कुछ भी आप समाप्त नहीं करते वह कल तक जाता है; जो आप समाप्त करते हैं वह पीछे रहता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Napi sor a mai rövid lista. Amit nem fejezs be, átgurul holnapra; amit befejezs, marad."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antrean Harian adalah daftar singkat hari ini. Apa pun yang tidak Anda selesaikan berguling ke besok; apa yang Anda selesaikan tetap tertinggal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La coda giornaliera è l'elenco breve di oggi. Tutto quello che non finisci viene trasportato a domani; quello che finisci rimane indietro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily Queueは本日の短いリストです。完了しなかったものは明日にロールオーバーされます。完了したものは後に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일일 큐는 오늘의 짧은 목록입니다. 완료하지 못한 항목은 내일로 이월되고 완료된 항목은 남아 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antrian Harian adalah daftar pendek hari ini. Apa pun yang tidak Anda selesaikan berguling ke besok; apa yang Anda selesaikan tetap di belakang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily Queue er dagens korte liste. Hva du ikke fullfører, rulles over til i morgen; det du fullfører, blir igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily Queue is vandaag's korte lijst. Wat je niet afmaakt rolt door naar morgen; wat je afmaakt blijft achter."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolejka dzienna to dzisiejsza krótka lista. Cokolwiek nie ukończysz, przenosi się na jutro; co ukończy, zostaje w tyle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Fila Diária é a lista curta de hoje. O que você não terminar entra em amanhã; o que você terminar fica para trás."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Fila Diária é a lista curta de hoje. O que não termina passa para amanhã; o que termina fica para trás."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coada zilei este lista scurtă a zilei. Orice nu termini se rostogolește în mâine; ceea ce termini rămâne în spate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ежедневная очередь — это краткий список на сегодня. То, что вы не завершили, переносится на завтра; то, что вы завершили, остаётся позади."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denná fronta je dnešný krátky zoznam. Čokoľvek, čo neukončíte, sa presunie na zajtra; čo ukončíte, zostane pozadu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily Queue är dagens korta lista. Det du inte slutför rullar in i imorgon; det du slutför stannar kvar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คิวรายวันคือรายการสั้น ๆ ของวันนี้ สิ่งที่คุณไม่ทำเสร็จจะหมุนเข้าสู่วันพรุ่งนี้ สิ่งที่คุณทำเสร็จจะอยู่เบื้องหลัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günlük Kuyruk, bugünün kısa listesidir. Bitirmedikleriniz yarına aktarılır; bitirdikleriniz geride kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоденна черга — це список на сьогодні. Те, що ви не закінчите, переходить на завтра; те, що ви закінчите, залишається позаду."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hàng đợi Hàng ngày là danh sách ngắn của hôm nay. Bất kỳ những gì bạn không hoàn thành sẽ chuyển sang ngày mai; những gì bạn kết thúc vẫn lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日常队列是今天的短列表。您未完成的任何内容都会滚入明天；您完成的内容会留在后面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每日隊列是今天的簡短清單。您未完成的任何內容會結轉到明天；您完成的內容會留下。"
          }
        }
      }
    },
