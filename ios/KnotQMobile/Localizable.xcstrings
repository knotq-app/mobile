          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モバイルアプリは近日公開予定です。App StoreとGoogle Playにて提供予定です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
