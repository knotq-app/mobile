    "onboarding.step.calendar.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتوي التقويم على الأحداث والمهام والتذكيرات. انقر لإضافة تذكير، أو انقر مع Shift لإضافة مهمة، أو اسحب لحجز حدث."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš kalendář obsahuje události, úkoly a připomenutí. Klikněte pro přidání připomenutí, shift+klik pro úkol nebo táhnutí pro blokování události."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din kalender indeholder begivenheder, opgaver og påmindelser. Klik for at tilføje en påmindelse, Shift-klik for en opgave, eller træk for at blokere en begivenhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Kalender enthält Ereignisse, Aufgaben und Benachrichtigungen. Klicken Sie, um eine Benachrichtigung hinzuzufügen, Umschalt+Klick für eine Aufgabe oder ziehen Sie, um ein Ereignis zu blockieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ημερολόγιό σας περιέχει συμβάντα, εργασίες και υπενθυμίσεις. Κάντε κλικ για να προσθέσετε μια υπενθύμιση, shift-κλικ για μια εργασία ή σύρετε για να εμποδίσετε ένα συμβάν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your calendar holds events, assignments, and reminders. Click to add a reminder, shift-click for an assignment, or drag to block out an event."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu calendario contiene eventos, tareas y recordatorios. Haz clic para añadir un recordatorio, mayúscula+clic para una tarea, o arrastra para bloquear un evento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalenterisi sisältää tapahtumia, tehtäviä ja muistutuksia. Napsauta lisätäksesi muistutuksen, Shift+napsautus tehtävälle tai vedä tapahtuman varaaminen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre calendrier contient des événements, des affectations et des rappels. Cliquez pour ajouter un rappel, Maj+Clic pour une affectation, ou glissez pour bloquer un événement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לוח השנה שלך מכיל אירועים, יעדים ותזכורות. לחץ כדי להוסיף תזכורת, Shift+לחץ ליעד, או גרור כדי לחסום אירוע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका कैलेंडर घटनाएं, कार्य, और अनुस्मारक रखता है। एक अनुस्मारक जोड़ने के लिए क्लिक करें, किसी कार्य के लिए शिफ्ट-क्लिक करें, या किसी घटना को अवरुद्ध करने के लिए खींचें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A naptárod eseményeket, hozzárendeléseket és emlékeztetőket tartalmaz. Kattints egy emlékeztetőhöz hozzáadásához, Shift+kattints hozzárendeléshez, vagy húzz egy esemény blokkolásához."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalender Anda menyimpan acara, tugas, dan pengingat. Klik untuk menambah pengingat, shift-klik untuk tugas, atau seret untuk memblokir waktu untuk acara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo calendario contiene eventi, incarichi e promemoria. Fai clic per aggiungere un promemoria, fai clic con maiusc per un incarico, o trascina per bloccare un evento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カレンダーにはイベント、アサイン、リマインダーが含まれます。クリックしてリマインダーを追加し、Shift+クリックでアサイン、またはドラッグしてイベントをブロックします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캘린더에는 이벤트, 할당 및 리마인더가 있습니다. 클릭하여 리마인더를 추가하거나, Shift+클릭하여 할당을 추가하거나, 드래그하여 이벤트를 차단하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalendar anda memegang acara, tugasan, dan peringatan. Klik untuk menambah peringatan, klik shift untuk tugasan, atau seret untuk menyekat acara."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalenderen inneholder arrangementet, oppgaver og remindere. Klikk for å legge til en påminnelse, skift-klikk for en oppgave, eller dra for å blokkere ut et arrangement."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je agenda bevat gebeurtenissen, taken en herinneringen. Klik om een herinnering toe te voegen, Shift+klik voor een taak, of sleep om een evenement in te plannen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój kalendarz zawiera zdarzenia, zadania i przypomnienia. Kliknij, aby dodać przypomnienie, shift-kliknij dla zadania lub przeciągnij, aby zaplanować zdarzenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu calendário contém eventos, tarefas e lembretes. Clique para adicionar um lembrete, shift-clique para uma tarefa, ou arraste para bloquear um evento."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu calendário contém eventos, tarefas e lembretes. Clique para adicionar um lembrete, Shift+clique para uma tarefa, ou arraste para bloquear um evento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendarul dvs. conține evenimente, atribuții și reamintiri. Faceți clic pentru a adăuga o reamintire, shift-clic pentru o atribuție, sau glisați pentru a bloca un eveniment."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш календарь содержит события, задания и напоминания. Нажмите, чтобы добавить напоминание, Shift+щелчок для задания или перетащите, чтобы заблокировать событие."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš kalendár obsahuje podujatia, úlohy a pripomenutia. Kliknutím pridajte pripomenutie, shift-kliknutím úlohu alebo potiahnutím vykryť podujatie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din kalender innehåller event, uppdrag och påminnelser. Klicka för att lägga till en påminnelse, skift+klick för ett uppdrag, eller dra för att blockera ett event."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปฏิทินของคุณมีเหตุการณ์ งานมอบหมาย และการแจ้งเตือน คลิกเพื่อเพิ่มการแจ้งเตือน shift-click สำหรับงานมอบหมาย หรือลากเพื่อบล็อกเหตุการณ์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takviminiz etkinlikleri, görevleri ve anımsatıcıları içerir. Anımsatıcı eklemek için tıklayın, görev için shift-tıklayın veya bir etkinliği engelleme için sürükleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш календар містить подій, завдання і нагадування. Натисніть, щоб додати нагадування, Shift+натиск для завдання або перетягніть, щоб зарезервувати подію."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lịch của bạn chứa các sự kiện, bài tập và nhắc nhở. Nhấp để thêm nhắc nhở, shift-nhấp để tạo bài tập hoặc kéo để chặn một sự kiện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的日历包含事件、任务和提醒。点击添加提醒，Shift 点击添加任务，或拖动以预留事件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的日曆包含事件、代辦事項和提醒。按一下以新增提醒、Shift+按一下以新增代辦事項，或拖曳以安排事件。"
          }
        }
      }
    },
