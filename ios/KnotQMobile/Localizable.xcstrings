    "mobile.account_delete.schedule_notice" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا يجدول حسابك المزامق وبيانات السحابة للحذف بعد فترة انتظار 14 يوماً. مساحة عملك المحلية تبقى على هذا الجهاز. سجل الدخول مرة أخرى خلال 14 يوم لإلغاء الحذف."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto naplánuje smazání vašeho účtu synchronizace a cloudových dat po 14denní lhůtě. Váš místní pracovní prostor zůstane na tomto zařízení. Pokud se chcete vrátit do 14 dnů, přihlaste se znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette planlægger din synkroniseringskonto og clouddata til sletning efter en 14-dages frister. Dit lokale arbejdsområde forbliver på denne enhed. Log ind igen inden for 14 dage for at annullere sletningen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies plant Ihr Sync-Konto und Cloud-Daten zur Löschung nach einer 14-Tage-Kulanzfrist ein. Ihr lokaler Arbeitsbereich bleibt auf diesem Gerät. Melden Sie sich innerhalb von 14 Tagen erneut an, um die Löschung zu stornieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό προγραμματίζει τον λογαριασμό συγχρονισμού σας και τα δεδομένα στο cloud για διαγραφή μετά από μια περίοδο χάριτος 14 ημερών. Ο χώρος εργασίας σας παραμένει σε αυτήν τη συσκευή. Συνδεθείτε ξανά εντός 14 ημερών για να ακυρώσετε τη διαγραφή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This schedules your sync account and cloud data for deletion after a 14-day grace period. Your local workspace stays on this device. Sign in again within 14 days to cancel the deletion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto programa tu cuenta de sincronización y datos en la nube para eliminación después de un período de gracia de 14 días. Tu espacio de trabajo local permanece en este dispositivo. Inicia sesión nuevamente dentro de 14 días para cancelar la eliminación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä aikatauluttaa synkronointitilisi ja pilvipalvelun tietosi poistamista 14 päivän katkolle. Paikallinen työtila jää tälle laitteelle. Kirjaudu sisään uudelleen 14 päivän sisällä poistojen peruuttamiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela planifie votre compte de synchronisation et vos données cloud pour suppression après une période de grâce de 14 jours. Votre espace de travail local reste sur cet appareil. Connectez-vous à nouveau dans les 14 jours pour annuler la suppression."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זה מתזמן את חשבון Sync שלך ונתוני ענן למחיקה לאחר תקופת חסד של 14 ימים. מרחב העבודה המקומי שלך נשאר בהתקן זה. התחבר שוב תוך 14 ימים כדי לבטל את המחיקה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह आपके सिंक खाते और क्लाउड डेटा को 14-दिन की अनुग्रह अवधि के बाद हटाने के लिए शेड्यूल करता है। आपकी स्थानीय वर्कस्पेस इस डिवाइस पर रहती है। हटाना रद्द करने के लिए 14 दिनों के भीतर फिर से साइन इन करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez az ütemezés a szinkronizálási fiók és a felhőadatok törlésére 14 napos türelmi idő után. A helyi munkaterület ezen az eszközön marad. Jelentkezzen be újra 14 napon belül a törlés visszavonásához."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini menjadwalkan akun sinkronisasi dan data cloud Anda untuk dihapus setelah periode masa berlaku 14 hari. Ruang kerja lokal Anda tetap di perangkat ini. Masuk kembali dalam 14 hari untuk membatalkan penghapusan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo programma il tuo account di sincronizzazione e i dati cloud per l'eliminazione dopo un periodo di grazia di 14 giorni. L'area di lavoro locale rimane su questo dispositivo. Accedi di nuovo entro 14 giorni per annullare l'eliminazione."
          }
