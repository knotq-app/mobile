    "web.home.sync.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ مجاني ويعمل بالكامل بدون اتصال — لا حساب مطلوب. أضف مزامنة KnotQ للحفاظ على مساحة عملك والإخطارات في خطوة عبر سطح المكتب والجوال."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ je bezplatný a funguje zcela offline — není vyžadován účet. Přidejte synchronizaci KnotQ, aby váš pracovní prostor a oznámení zůstaly v souladu mezi počítačem a mobilním zařízením."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ er gratis og fungerer helt offline — ingen konto nødvendig. Tilføj KnotQ Sync for at holde dit arbejdsområde og meddelelser i takt på hele skrivebord og mobil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ ist kostenlos und funktioniert vollständig offline — kein Konto erforderlich. Fügen Sie KnotQ Sync hinzu, um Ihren Workspace und Benachrichtigungen über Desktop und Mobilgeräte hinweg in Schritt zu halten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το KnotQ είναι δωρεάν και λειτουργεί πλήρως χωρίς σύνδεση — δεν απαιτείται λογαριασμός. Προσθέστε KnotQ Sync για να κρατήσετε τον χώρο εργασίας σας και τις ειδοποιήσεις σας ενημερωμένες σε επιτραπέζιο υπολογιστή και κινητό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ is free and works fully offline — no account needed. Add KnotQ Sync to keep your workspace and notifications in step across desktop and mobile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ es gratuito y funciona completamente sin conexión — sin cuenta necesaria. Agrega KnotQ Sync para mantener tu espacio de trabajo y notificaciones sincronizados en desktop y móvil."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ on ilmainen ja toimii täysin offline-tilassa — ei tiliä tarvita. Lisää KnotQ Sync pitääksesi työtilasi ja ilmoituksesi vaiheissa pöytäkoneen ja matkapuhelimen välillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ est gratuit et fonctionne entièrement hors ligne — aucun compte requis. Ajoutez KnotQ Sync pour garder votre espace de travail et vos notifications en phase sur le bureau et mobile."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ חינמי ועובד במלואו ללא חיבור — אין חשבון נדרש. הוסף KnotQ Sync כדי שמור את מרחב העבודה וההתריעות שלך בתאימות על פני שולחן עבודה וסלולר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ मुफ्त है और पूरी तरह से ऑफलाइन काम करता है — कोई खाता आवश्यक नहीं है। अपने वर्कस्पेस और सूचनाओं को डेस्कटॉप और मोबाइल में कदम में रखने के लिए KnotQ सिंक जोड़ें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A KnotQ ingyenes és teljesen offline működik — nincs szükség fiókra. Adjon hozzá KnotQ Sync-et az Ön munkahelyét és értesítéseit szinkronban tartani az asztali és mobil között."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ gratis dan berfungsi sepenuhnya offline — tidak perlu akun. Tambahkan KnotQ Sync untuk membuat ruang kerja dan notifikasi Anda tetap sinkron di seluruh desktop dan seluler."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ è gratuito e funziona completamente offline — non è necessario alcun account. Aggiungi KnotQ Sync per mantenere il tuo workspace e le notifiche in step su desktop e mobile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQは無料で、完全にオフラインで機能します — アカウントは必要ありません。KnotQ Syncを追加して、デスクトップとモバイル間でワークスペースと通知を同期状態に保ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ는 무료이며 완전히 오프라인에서 작동합니다 — 계정이 필요 없습니다. KnotQ Sync를 추가하여 데스크톱과 모바일 전체에서 워크스페이스와 알림을 동기 상태로 유지하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ gratis dan bekerja sepenuhnya secara offline — tidak perlu akun. Tambahkan Sinkronisasi KnotQ untuk menjaga ruang kerja dan pemberitahuan Anda tetap selaras di desktop dan seluler."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ er gratis og fungerer helt offline – ingen konto nødvendig. Legg til KnotQ Sync for å holde arbeitsflaten og varslingene dine i takt på tvers av stasjonær og mobil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ is gratis en werkt volledig offline — geen account nodig. Voeg KnotQ Sync toe om je werkruimte en meldingen gesynchroniseerd te houden op desktop en mobiel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ jest bezpłatny i w pełni działa w trybie offline — konto nie jest wymagane. Dodaj KnotQ Sync, aby utrzymać Twój obszar roboczy i powiadomienia w kroku na pulpicie i urządzeniach przenośnych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ é gratuito e funciona completamente offline — sem necessidade de conta. Adicione KnotQ Sync para manter seu workspace e notificações em sincronização entre desktop e dispositivo móvel."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O KnotQ é gratuito e funciona totalmente offline — nenhuma conta necessária. Adicione o KnotQ Sync para manter a sua área de trabalho e notificações em passo entre desktop e mobile."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ este gratuit și funcționează complet offline — nicio cont necesară. Adăugați KnotQ Sync pentru a menține spațiul dvs. de lucru și notificările în pasul pe desktop și mobile."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ бесплатна и полностью работает в автономном режиме — учётная запись не требуется. Добавьте KnotQ Sync, чтобы синхронизировать рабочее пространство и уведомления между настольным компьютером и мобильным устройством."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ je bezplatný a funguje úplne offline — žiadne konto nie je potrebné. Pridajte KnotQ Sync, aby ste si udržali pracovný priestor a upozornenia v krokoch naprieč počítačom a mobilom."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ är gratis och fungerar helt offline — inget konto behövs. Lägg till KnotQ Sync för att hålla ditt arbetsutrymme och meddelanden i steg på skrivbord och mobil."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ ฟรีและทำงานออฟไลน์อย่างเต็มรูปแบบ — ไม่ต้องมีบัญชี เพิ่ม KnotQ Sync เพื่อเก็บพื้นที่ทำงานและการแจ้งเตือนของคุณให้ทันสมัยบนเดสก์ท็อปและอุปกรณ์เคลื่อนที่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ ücretsiz ve tamamen çevrimdışı çalışır — hesap gerekmez. Çalışma alanınızı ve bildirimleri masaüstü ve mobil arasında adımda tutmak için KnotQ Sync ekleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ безплатно й повністю працює в автономному режимі — обліковий запис не потрібен. Додайте синхронізацію KnotQ, щоб тримати ваш робочий простір та нагадування синхронізованими на настільному та мобільному пристроях."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ là miễn phí và hoạt động hoàn toàn ngoại tuyến — không cần tài khoản. Thêm KnotQ Sync để giữ không gian làm việc và thông báo của bạn được đồng bộ trên máy tính để bàn và thiết bị di động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ 是免费的，可以完全离线工作 — 无需账户。添加 KnotQ Sync 以在桌面和移动设备上保持工作区和通知同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ 是免費的，完全離線運作 — 不需要帳戶。新增 KnotQ Sync 以在桌機和行動裝置上保持您的工作區和通知同步。"
          }
        }
