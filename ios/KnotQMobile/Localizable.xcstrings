    "web.home.meta_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ مساحة عمل تخطيط محلية أولاً حيث تصبح الملاحظات المنظمة مهام وآجال نهائية وتذكيرات وأحداث تقويم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ je místně první desktopový plánovací pracovní prostor, kde se strukturované poznámky stávají úkoly, termíny, připomenutí a událostmi kalendáře."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ er et lokalt-først skrivebordsplanarbejdsområde, hvor strukturerede noter bliver opgaver, deadlines, påmindelser og kalenderhændelser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ ist ein lokal-first Desktop Planungs-Workspace, bei dem strukturierte Notizen zu Aufgaben, Fristen, Erinnerungen und Kalenderereignissen werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το KnotQ είναι ένας τοπικός χώρος εργασίας σχεδιασμού επιτραπέζιου υπολογιστή όπου δομημένες σημειώσεις γίνονται εργασίες, προθεσμίες, υπενθυμίσεις και γεγονότα ημερολογίου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ is a local-first desktop planning workspace where structured notes become tasks, deadlines, reminders, and calendar events."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ es un espacio de trabajo de planificación local-first donde las notas estructuradas se convierten en tareas, fechas límite, recordatorios y eventos de calendario."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ on paikallisen ensimmäisen pöytäkoneen suunnittelutyötila, jossa strukturoidut muistiinpanot tulevat tehtäviksi, määräpäiviksi, muistutuksiksi ja kalenterin tapahtumiksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ est un espace de travail de planification de bureau d'abord local où les notes structurées deviennent des tâches, des délais, des rappels et des événements de calendrier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ היא מרחב עבודה תכנון מקומי קדם שלו מסמכים מובנים הופכים משימות, דדליינים, תזכורות ופריטי לוח שנה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ एक स्थानीय-प्रथम डेस्कटॉप योजना वर्कस्पेस है जहां संरचित नोट्स कार्य, समय सीमा, रिमाइंडर, और कैलेंडर इवेंट बन जाते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A KnotQ egy helyi-elsõ asztali tervezési munkahely, ahol strukturált jegyzetekbõl feladatok, határidõk, emlékeztetõk és naptári események válnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ adalah ruang kerja perencanaan desktop lokal-pertama di mana catatan terstruktur menjadi tugas, tenggat waktu, pengingat, dan acara kalender."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ è uno spazio di lavoro di pianificazione local-first dove le note strutturate diventano compiti, scadenze, promemoria e eventi del calendario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQはローカルファースト デスクトップ計画ワークスペースで、構造化されたメモはタスク、期限、リマインダー、カレンダーイベントになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ는 구조화된 노트가 작업, 기한, 알림 및 캘린더 이벤트로 변환되는 로컬 우선 데스크톱 계획 워크스페이스입니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ adalah ruang kerja perencanaan desktop lokal-pertama di mana catatan terstruktur menjadi tugas, tenggat waktu, pengingat, dan acara kalender."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ er en lokalt-først-skrivebordsplanleggingsarbeitsflate der strukturerte notater blir oppgaver, frister, påminnelser og kalenderhendelser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ is een desktop-planningswerkruimte die eerst lokaal werkt, waar gestructureerde notities taken, deadlines, herinneringen en agendagebeurtenissen worden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ to lokalnie-pierwszy obszar roboczy planowania pulpitu, w którym strukturyzowane notatki stają się zadaniami, terminami, przypomnieniami i zdarzeniami kalendarza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ é um workspace de planejamento local primeiro onde notas estruturadas se tornam tarefas, prazos, lembretes e eventos de calendário."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O KnotQ é uma área de trabalho de planejamento de desktop local-first onde notas estruturadas se tornam tarefas, prazos, lembretes e eventos de calendário."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ este un spațiu de lucru de planificare desktop local-first, unde notele structurate devin sarcini, termene limită, mementouri și evenimente de calendar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ — это локально-первое рабочее пространство для планирования, где структурированные заметки становятся задачами, сроками, напоминаниями и событиями календаря."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ je pracovný priestor plánovania s miestnym prioritou, kde sa štruktúrované poznámky stávajú úlohami, termínmi, pripomienkami a položkami kalendára."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ är ett lokalt först skrivbordsplaneringsarbetsutrymme där strukturerade anteckningar blir uppgifter, deadlines, påminnelser och kalenderhändelser."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ เป็นพื้นที่ทำงานการวางแผนที่เป็นเครื่องหมายแรกท้องถิ่นซึ่งหมายเหตุที่มีโครงสร้างกลายเป็นงาน เส้นตาย การเตือน และเหตุการณ์ปฏิทิน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ, yapılandırılmış notların görevler, son tarihler, hatırlatıcılar ve takvim etkinlikleri haline geldiği yerel-ilk bir masaüstü planlama çalışma alanıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ — це локальний робочий простір планування, де структуровані нотатки стають завданнями, крайніми термінами, нагадуваннями та подіями календаря."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ là một không gian làm việc lên kế hoạch cục bộ-trước tiên nơi các ghi chú có cấu trúc trở thành tác vụ, hạn chót, nhắc nhở và sự kiện lịch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ 是一个本地优先的桌面规划工作区，其中结构化笔记变成任务、截止日期、提醒和日历事件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ 是一個本機優先的桌面規劃工作區，其中結構化筆記變成任務、截止日期、提醒和日曆事件。"
          }
        }
      }
    },
