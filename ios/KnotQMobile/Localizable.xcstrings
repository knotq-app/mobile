    "mobile.sync.verify_email_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقق من بريدك الإلكتروني للاشتراك — تحقق من صندوق الوارد الخاص بك للحصول على الرابط."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ověřte svůj e-mail pro přihlášení — zkontrolujte svou poštovní schránku na odkaz."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekræft din e-mail for at abonnere — tjek din indbakke for linket."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überprüfen Sie Ihre E-Mail, um sich anzumelden – prüfen Sie Ihren Posteingang auf den Link."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιβεβαιώστε το email σας για να εγγραφείτε — ελέγξτε το εισερχόμενό σας για τον σύνδεσμο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verify your email to subscribe — check your inbox for the link."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica tu correo electrónico para suscribirse — busca el enlace en tu bandeja de entrada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vahvista sähköpostisi tilauksen ottamiseksi — tarkista sähköpostista linkki."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez votre e-mail pour vous abonner — consultez votre boîte de réception pour le lien."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אמת את הדוא״ל שלך כדי להירשם — בדוק את תיבת הדואר שלך עבור הקישור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सदस्यता लेने के लिए अपना ईमेल सत्यापित करें — लिंक के लिए अपना इनबॉक्स जांचें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ellenőrizd az email-ed a feliratkozáshoz — keress a beérkezett üzenetek között egy linket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifikasi email Anda untuk berlangganan — periksa kotak masuk Anda untuk tautannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica il tuo indirizzo email per abbonarti — controlla la tua inbox per il link."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購読するメールを確認してください — 受信トレイからリンクを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구독하려면 이메일을 확인하세요. 받은편지함에서 링크를 확인하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sahkan e-mel anda untuk melanggan — periksa peti masuk anda untuk pautan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekreft e-posten din for å abonnere — se etter lenken i innboksen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifieer je e-mailadres om je in te schrijven — controleer je inbox voor de koppeling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zweryfikuj swoją pocztę e-mail, aby subskrybować — sprawdź skrzynkę odbiorczą w poszukiwaniu linku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique seu email para se inscrever — procure o link em sua caixa de entrada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique o seu correio eletrónico para subscrever — procure a ligação na sua caixa de entrada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verificați-vă e-mailul pentru a vă abona — verificați cutia de intrare pentru link."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подтвердите ваш адрес электронной почты, чтобы подписаться — проверьте входящие письма на предмет ссылки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overte si svoj e-mail, aby ste sa mohli prihlásiť — v priečinku Doručená pošta nájdete odkaz."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifiera din e-postadress för att prenumerera — sök efter länken i din inkorg."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยืนยันอีเมลของคุณเพื่อสมัครสมาชิก — ตรวจสอบกล่องจดหมายของคุณเพื่อหาลิงก์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abone olmak için e-postanızı doğrulayın — gelen kutunuzda bağlantıyı kontrol edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
