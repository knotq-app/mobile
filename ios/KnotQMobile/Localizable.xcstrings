    "mobile.archive.move_folder_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم نقل «{name}» ومخططاتها خارج الشريط الجانبي. يمكنك استعادتها لاحقاً من الأرشيف."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„{name}“ a jeho schémata budou přesunuta mimo bočný panel. Později je můžete obnovit z archivu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"{name}\" og dens skemaer fjernes fra sidebjælken. Du kan gendanne dem senere fra arkivet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"{name}\" und dessen Schemata werden aus der Seitenleiste entfernt. Sie können sie später aus dem Archiv wiederherstellen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«{name}» και τα σχήματά του θα μετακινηθούν έξω από την πλευρική γραμμή. Μπορείτε να τα επαναφέρετε αργότερα από το αρχείο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"{name}\" and its schemes will be moved out of the sidebar. You can restore them later from Archive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"{name}\" y sus esquemas se moverán fuera de la barra lateral. Puedes restaurarlos más tarde desde el archivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"{name}\" ja sen mallit siirretään pois sivupalkista. Voit palauttaa ne myöhemmin arkistosta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« {name} » et ses schémas seront déplacés hors de la barre latérale. Vous pouvez les restaurer plus tard à partir de l'archive."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„{name}“ וסכימות שלה יוזעו מהסרגל הצדדי. אתה יכול להחזיר אותם מאוחר יותר מארכיון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"{name}\" और इसकी योजनाएं साइडबार से बाहर ले जाई जाएंगी। आप उन्हें बाद में आर्काइव से पुनः स्थापित कर सकते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) „{name}“ és a sémái eltávolításra kerülnek az oldalsávból. Később visszaállíthatja őket az Archívumból."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{name} dan skemanya akan dipindahkan keluar dari bilah sisi. Anda dapat memulihkannya nanti dari Arsip."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"{name}\" e i suoi schemi verranno spostati fuori dalla barra laterale. Potrai ripristinarli in seguito da Archivio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「{name}」とそのスキームがサイドバーから削除されます。後でアーカイブから復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"{name}\" 및 계획이 사이드바에서 제거됩니다. 나중에 보관함에서 복원할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"{name}\" dan skemanya akan dipindahkan dari bilah sisi. Anda dapat memulihkannya nanti dari Arsip."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«{name}» og oppsettet vil bli flyttet ut av sidelinjen. Du kan gjenopprette dem senere fra arkivet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"{name}\" en de bijbehorende schema's zullen uit de zijbalk worden verplaatst. Je kunt ze later uit het archief herstellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„{name}” i jego schematy będą usunięte z paska bocznego. Możesz je później przywrócić z archiwum."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"{name}\" e seus schemes serão removidos da barra lateral. Você pode restaurá-los depois do Arquivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«{name}» e os seus esquemas serão movidos da barra lateral. Pode restaurá-los depois do Arquivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„{name}” și schemele sale vor fi mutate din bară laterală. Puteți le restaura mai târziu din Arhivă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«{name}» и её схемы будут удалены из боковой панели. Вы сможете восстановить их позже из архива."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„{name}“ a jej schémy budú presunuté z bočného panelu. Neskôr ich môžete obnoviť z archívu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"{name}\" och dess scheman kommer att flyttas ut från sidofältet. Du kan återställa dem senare från arkivet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"{name}\" และแผนของมันจะถูกย้ายออกจากแถบข้าง คุณสามารถกู้คืนจากที่เก็บถาวรได้ในภายหลัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"{name}\" ve şemaları kenar çubuğundan çıkarılacak. Daha sonra Arşivden geri yükleyebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«{name}» та її схеми будуть видалені з бічної панелі. Ви можете їх пізніше відновити з архіву."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"{name}\" và các sơ đồ của nó sẽ bị loại bỏ khỏi thanh bên. Bạn có thể khôi phục chúng sau từ Lưu trữ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「{name}」及其方案将从侧边栏中移出。您可以稍后从归档中还原它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「{name}」及其方案將從側邊欄中移出。您稍後可以從封存中還原它們。"
          }
        }
      }
    },
