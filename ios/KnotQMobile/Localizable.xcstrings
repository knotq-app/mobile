    "account.confirm.cancel_subscription_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى المزامقة متاحة حتى نهاية فترة الفواتير الحالية، وتبقى مساحة عملك على هذا الجهاز."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizace zůstane dostupná až do konce aktuálního období zúčtování a váš pracovní prostor zůstane na tomto zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronisering forbliver tilgængelig, indtil den aktuelle faktureringsperiode slutter, og dit arbejdsområde forbliver på denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisierung bleibt bis zum Ende des aktuellen Abrechnungszeitraums verfügbar, und Ihr Arbeitsbereich bleibt auf diesem Gerät."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η συγχρονισμός παραμένει διαθέσιμη έως το τέλος της τρέχουσας περιόδου χρέωσης και ο χώρος εργασίας σας παραμένει σε αυτήν τη συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync stays available until the current billing period ends, and your workspace stays on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync seguirá disponible hasta que termine el período de facturación actual, y tu espacio de trabajo permanecerá en este dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronointi pysyy käytettävissä nykyisen laskutuskauden loppuun asti, ja työtila jää tälle laitteelle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation reste disponible jusqu'à la fin de la période de facturation actuelle, et votre espace de travail reste sur cet appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync יישאר זמין עד סוף תקופת החיוב הנוכחית, ומרחב העבודה שלך יישאר בהתקן זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिंक वर्तमान बिलिंग अवधि के अंत तक उपलब्ध रहता है, और आपकी वर्कस्पेस इस डिवाइस पर रहती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szinkronizálás az aktuális számlázási időszak végéig elérhető marad, és a munkaterület ezen az eszközön marad."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinkronisasi tetap tersedia hingga periode penagihan saat ini berakhir, dan ruang kerja Anda tetap di perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronizzazione rimane disponibile fino alla fine del periodo di fatturazione corrente, e l'area di lavoro rimane su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の請求期間が終了するまでSyncは利用可能で、ワークスペースはこのデバイスに残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 결제 기간이 끝날 때까지 동기화가 유지되며, 작업 공간은 이 기기에 남아 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinkronisasi tetap tersedia hingga periode penagihan saat ini berakhir, dan ruang kerja Anda tetap di perangkat ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synk forblir tilgjengelig til gjeldende faktureringperiode avsluttes, og arbeidsrommet ditt forblir på denne enheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync blijft beschikbaar tot het einde van de huidige factureringsperiode, en je werkruimte blijft op dit apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizacja będzie dostępna do końca bieżącego okresu rozliczeniowego, a Twój obszar roboczy pozostanie na tym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização permanece disponível até o final do período de cobrança atual, e seu workspace permanece neste dispositivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sync mantém-se disponível até ao final do período de faturação atual, e a sua área de trabalho fica neste dispositivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizarea rămâne disponibilă până la sfârșitul perioadei de facturare actuale, iar spațiul de lucru rămâne pe acest dispozitiv."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизация остаётся доступна до конца текущего периода оплаты, а ваше рабочее пространство остаётся на этом устройстве."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizácia zostane dostupná až do konca aktuálneho fakturačného cyklu a váš pracovný priestor zostane na tomto zariadení."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronisering förblir tillgänglig tills den aktuella faktureringsperioden avslutas, och din arbetsyta förblir på enheten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การซิงค์จะยังคงพร้อมใช้งานจนกว่าจะสิ้นสุดระยะเวลาการเรียกเก็บเงินปัจจุบัน และพื้นที่ทำงานของคุณจะยังคงอยู่บนอุปกรณ์นี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senkronizasyon mevcut faturalandırma döneminin sonuna kadar kullanılabilir kalır ve çalışma alanınız bu cihazda kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронізація залишатиметься доступною до кінця поточного розрахункового періоду, а ваш робочий простір залишиться на цьому пристрої."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đồng bộ vẫn khả dụng cho đến khi kỳ thanh toán hiện tại kết thúc, và workspace của bạn vẫn ở trên thiết bị này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步将在当前计费周期结束前保持可用,您的工作区保留在此设备上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步會保持可用至目前帳單週期結束，您的工作區將保留在此裝置上。"
          }
        }
      }
    },
