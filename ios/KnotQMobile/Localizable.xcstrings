    "web.home.features.scheduling.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف بداية أو نهاية أو كليهما إلى سطر وسيهبط على تقويمك — كحدث أو مهمة أو تذكير."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte začátek, konec nebo obojí k řádku a skončí v kalendáři — jako událost, úkol nebo připomenutí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj en start, en slut, eller begge dele til en linje, og det lander på din kalender — som en begivenhed, opgave eller påmindelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie ein Start-, ein End- oder beides zu einer Zeile hinzu und es landet in Ihrem Kalender — als Ereignis, Aufgabe oder Erinnerung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε μια αρχή, ένα τέλος ή και τα δύο σε μια γραμμή και προσγειώνεται στο ημερολόγιό σας — ως γεγονός, ανάθεση ή υπενθύμιση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a start, an end, or both to a line and it lands on your calendar — as an event, assignment, or reminder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega un inicio, un fin, o ambos a una línea y aterriza en tu calendario — como un evento, asignación o recordatorio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää alkaminen, loppu tai molemmat riviin ja se laskeutuu kalenteriisi — tapahtuma, tehtävä tai muistutus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un début, une fin ou les deux à une ligne et elle atterrit sur votre calendrier — en tant qu'événement, tâche ou rappel."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוסף התחלה, סיום או שניהם לשורה והוא נוחת בלוח השנה שלך — כאירוע, הקצאה או תזכורת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक पंक्ति में शुरुआत, अंत, या दोनों जोड़ें और यह आपके कैलेंडर पर आता है — एक इवेंट, असाइनमेंट, या रिमाइंडर के रूप में।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjon hozzá egy kezdést, egy végét vagy mindkettõt egy sorhoz, és a naptárban kerül — eseményt, feladatot vagy emlékeztetõt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan awal, akhir, atau keduanya ke baris dan itu mendarat di kalender Anda — sebagai acara, penugasan, atau pengingat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi un inizio, una fine o entrambi a una riga e atterrerà nel tuo calendario — come evento, compito o promemoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行に開始、終了、またはその両方を追加すると、カレンダーに記録されます — イベント、課題、またはリマインダーとして。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "줄에 시작, 종료 또는 둘 다를 추가하면 캘린더에 이벤트, 할당 또는 알림으로 표시됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan awal, akhir, atau keduanya ke baris dan mendarat di kalender Anda — sebagai acara, penugasan, atau pengingat."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til en start, en slutt eller begge deler til en linje og den lander på kalenderen din – som en begivenhet, oppgave eller påminnelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg een start, einde of beide toe aan een regel en deze verschijnt op je agenda — als evenement, taak of herinnering."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj początek, koniec lub oba do linii, a wyląduje w Twoim kalendarzu — jako zdarzenie, przypisanie lub przypomnienie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione um início, um fim ou ambos a uma linha e ele vai para seu calendário — como um evento, atribuição ou lembrete."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione um início, um fim, ou ambos a uma linha e ela pousa no seu calendário — como um evento, atribuição ou lembrete."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adăugați un început, un sfârşit, sau amândouă pe o linie și ajunge în calendar — ca un eveniment, sarcină sau memento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте начало, конец или оба в строку, и она попадёт в ваш календарь — как событие, задание или напоминание."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridajte začiatok, koniec alebo oboje na riadok a pristane na vašom kalendári — ako udalosť, úloha alebo pripomienka."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till en start, ett slut eller båda på en rad och den landar på din kalender — som en händelse, uppdrag eller påminnelse."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มเริ่มต้น จุดสิ้นสุด หรือทั้งสองอย่างลงในบรรทัดและมันจะลงจอดบนปฏิทินของคุณ — เป็นเหตุการณ์ งาน หรือการเตือน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir satıra başlangıç, bitiş veya her ikisini ekleyin ve takvimde — etkinlik, ödev veya hatırlatıcı olarak — yer alır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додайте старт, кінець або обидва в рядок, і він приземлиться у вашому календарі — як подія, завдання або нагадування."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm phần bắt đầu, phần kết thúc hoặc cả hai vào một dòng và nó sẽ hạ cánh trên lịch của bạn — dưới dạng sự kiện, bài tập hoặc nhắc nhở."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在一行中添加开始、结束或两者，它就会显示在您的日历上 — 作为事件、分配或提醒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將開始、結束或兩者新增到行，它就會出現在您的日曆上 — 作為事件、指派或提醒。"
          }
        }
      }
    },
