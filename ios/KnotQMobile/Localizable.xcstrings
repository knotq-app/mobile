    "mobile.sync.cancelled_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى المزامنة نشطة حتى نهاية فترة فواتيرك. أعد التمكين للاحتفاظ بها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizace zůstane aktivní do konce vašeho fakturačního období. Znovu ji povolte, aby zůstala."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronisering forbliver aktiv indtil din faktureringsperiode slutter. Genaktiver for at beholde den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisierung bleibt bis zum Ende Ihres Abrechnungszeitraums aktiv. Aktivieren Sie sie erneut, um sie zu behalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο συγχρονισμός παραμένει ενεργός έως το τέλος της περιόδου χρέωσής σας. Επανενεργοποιήστε για να τον διατηρήσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync stays active until your billing period ends. Re-enable to keep it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización permanece activa hasta que termine tu período de facturación. Reactivala para mantenerla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronointi säilyy aktiivisena kunnes laskutuskausi päättyy. Ota uudelleen käyttöön säilyttääksesi sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation reste active jusqu'à la fin de votre période de facturation. Réactivez-la pour la conserver."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סנכרון נשאר פעיל עד סוף תקופת החיוב שלך. הפעל מחדש כדי לשמור על זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिंक आपकी बिलिंग अवधि समाप्त होने तक सक्रिय रहता है। इसे रखने के लिए फिर से सक्षम करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szinkronizálás aktív marad a számlázási időszak végéig. Engedélyezd újra az megtartásához."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinkronisasi tetap aktif hingga periode penagihan Anda berakhir. Aktifkan kembali untuk menjaganya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronizzazione rimane attiva fino alla fine del periodo di fatturazione. Riabilita per mantenerla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期は請求期間が終わるまでアクティブなままです。有効にして保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동기화는 청구 기간이 끝날 때까지 활성화됩니다. 다시 활성화하여 유지하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segerakan tetap aktif sehingga tempoh pengebilan anda berakhir. Dayakan semula untuk mempertahankannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronisering forblir aktiv til faktureringsperioden avsluttes. Re-aktiver for å beholde det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisatie blijft actief tot het einde van je factureringsperiode. Schakel dit in om het te behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizacja pozostaje aktywna do końca okresu rozliczeniowego. Ponownie włącz, aby ją zachować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização permanece ativa até o final do seu período de faturamento. Reative para mantê-la."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização permanece ativa até ao final do seu período de faturação. Reative para mantê-la."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizarea rămâne activă până la sfârșitul perioadei de facturare. Reactivați pentru a o menține."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизация остается активной до конца вашего периода выставления счетов. Повторно включите, чтобы сохранить ее."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizácia zostáva aktívna až do konca vášho zúčtovacieho obdobia. Ak ju chcete ponechať, znova ju povolte."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronisering förblir aktiv tills din faktureringsperiod slutar. Återaktivera för att behålla den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การซิงค์จะยังคงใช้งานจนกว่าระยะเวลาการเรียกเก็บเงินของคุณจะสิ้นสุด เปิดใช้งานอีกครั้งเพื่อเก็บไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senkronizasyon, fatura döneminin sonuna kadar etkin kalır. Devam etmesini sağlamak için yeniden etkinleştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронізація залишається активною до завершення вашого періоду виставлення рахунків. Повторно ввімкніть, щоб зберегти її."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đồng bộ vẫn hoạt động cho đến khi kỳ thanh toán của bạn kết thúc. Bật lại để giữ nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步保持活跃直到计费周期结束。重新启用以保持它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步會保持有效，直到您的計費期間結束。重新啟用以保持它。"
          }
        }
      }
    },
