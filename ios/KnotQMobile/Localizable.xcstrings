    "mobile.delete_account.store_subscription_warning" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حذف حسابك **لا** يلغي اشتراكك في {store}. {store} سيستمر في محاسبتك حتى تلغيه هناك. ألغِه أولاً، ثم احذف."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smazání vašeho účtu **neruší** vaše předplatné {store}. {store} vás bude nadále zpoplatňovat, dokud jej tam nezrušíte. Nejdřív jej zrušte a pak smažte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sletning af din konto annullerer **ikke** dit {store} abonnement. {store} vil fortsætte med at fakturere dig, indtil du annullerer det der. Annuller det først, derefter slet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Löschen Ihres Kontos bricht NICHT Ihr {store}-Abonnement ab. {store} berechnet Ihnen weiterhin, bis Sie es dort kündigen. Kündigen Sie es zuerst, dann löschen Sie."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η διαγραφή του λογαριασμού σας **δεν** ακυρώνει τη συνδρομή σας στο {store}. Το {store} συνεχίζει να σας χρεώνει μέχρι να το ακυρώσετε εκεί. Ακυρώστε το πρώτα, στη συνέχεια διαγράψτε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting your account does **not** cancel your {store} subscription. {store} keeps billing you until you cancel it there. Cancel it first, then delete."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar tu cuenta **no** cancela tu suscripción de {store}. {store} seguirá cobrándote hasta que lo hagas allá. Cancélalo primero, luego elimina."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilin poistaminen **ei** peruuta {store} tilausta. {store} jatkaa laskutusta, kunnes peruutat sen siellä. Peruuta se ensin, sitten poista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer votre compte ne **l'annule pas** votre abonnement {store}. {store} continue de vous facturer jusqu'à ce que vous l'annuliez là-bas. Annulez-le d'abord, puis supprimez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מחיקת החשבון שלך עושה **לא** בטל את המנוי {store} שלך. {store} ממשיך לגבות אותך עד שתבטל זאת שם. בטל זאת תחילה, ואז מחק."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके खाते को हटाना आपकी {store} सदस्यता को **नहीं** रद्द करता। {store} आपको तब तक चार्ज करता रहता है जब तक आप वहां इसे रद्द नहीं करते। पहले इसे रद्द करें, फिर हटाएं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fiók törlése **nem** szünteti meg a(z) {store} előfizetést. A(z) {store} továbbra is számlázza Önt, amíg ott le nem mondja. Először mondja le, majd törölje."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus akun Anda **tidak** membatalkan langganan {store} Anda. {store} terus mengenakan biaya kepada Anda hingga Anda membatalkannya di sana. Batalkan terlebih dahulu, kemudian hapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'eliminazione dell'account **non** annulla l'abbonamento a {store}. {store} continua a addebitarti fino a quando non lo annulli lì. Annullalo prima, poi elimina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウント削除は**{store}サブスクリプション**をキャンセルしません。{store}はキャンセルするまで課金を続けます。最初にキャンセルしてから削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정을 삭제해도 **{store} 구독이 취소되지 않습니다**. {store}는 이곳에서 취소할 때까지 계속 청구합니다. 먼저 취소한 후 삭제하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus akun Anda **tidak** membatalkan langganan {store} Anda. {store} terus menagih Anda hingga Anda membatalkannya di sana. Batalkan terlebih dahulu, lalu hapus."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sletting av kontoen din avbryter **ikke** abonnementet ditt på {store}. {store} fortsetter å belaste deg til du avbryter det der. Avbryt det først, deretter slett."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het verwijderen van je account **niet** je {store}-abonnement annuleren. {store} blijft je factureren tot je het daar opzegt. Zeg het daar eerst op en verwijder het vervolgens."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięcie Twojego konta **nie** anuluje subskrypcji {store}. {store} będzie Cię rozliczać, dopóki nie anulujesz tam. Anuluj najpierw, a następnie usuń."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluir sua conta **não** cancela sua assinatura de {store}. {store} continuará cobrando você até você cancelar lá. Cancele primeiro e depois exclua."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar a sua conta **não** cancela a sua subscrição do {store}. {store} continua a cobrar-lhe até a cancelar lá. Cancele primeiro, depois elimine."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ștergerea contului **nu** anulează abonamentul {store}. {store} continuă să vă perceapă până când o anulați acolo. Anulați-o mai întâi, apoi ștergeţi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаление вашего аккаунта **не** отменяет вашу подписку {store}. {store} продолжит списывать средства, пока вы не отмените подписку там. Сначала отмените, затем удалите."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vymazanie vášho účtu **NEZRUŠUJE** vaše predplatné {store}. {store} vás bude ďalej fakturovať, kým ho tam nezrušíte. Najprv ho zrušte, potom vymažte."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du raderar ditt konto RADERAS **inte** din {store}-prenumeration. {store} debiterar dig tills du avsluter den där. Avsluta den först, sedan radera."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การลบบัญชีของคุณจะ **ไม่** ยกเลิกการสมัครสมาชิก {store} ของคุณ {store} จะเรียกเก็บเงินจากคุณต่อไปจนกว่าคุณจะยกเลิกที่นั่น ยกเลิกก่อน จากนั้นลบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesabınızı silmek {store} aboneliğini **iptal etmez**. {store} onu iptal edene kadar faturalandırmaya devam eder. Önce iptal edin, ardından silin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видалення вашого облікового запису **не** скасовує вашу підписку {store}. {store} продовжуватиме вас стягувати, доки ви не скасуєте її там. Спочатку скасуйте її, потім видаліть."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa tài khoản của bạn **không** hủy đăng ký {store} của bạn. {store} tiếp tục tính phí cho bạn cho đến khi bạn hủy nó ở đó. Hủy nó trước, sau đó xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除您的账户 **不会** 取消您的 {store} 订阅。{store} 将继续向您收费,直到您在那里取消。先取消,然后删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除您的帳戶**不會**取消您的 {store} 訂閱。{store} 會持續向您收費，直到您在那裡取消為止。先取消，再刪除。"
          }
        }
      }
    },
