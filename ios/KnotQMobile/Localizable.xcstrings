    "web.checkout.verify_gate_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أكّد رابط التحقق الذي أرسلناه إلى بريدك الإلكتروني للحساب. يبقى الدفع مقفلاً حتى يتم التحقق من عنوانك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potvrďte ověřovací odkaz, který jsme poslali na e-mail vašeho účtu. Nákup zůstane uzamčen, dokud vaše adresa není ověřena."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekræft bekræftelseslinket, vi sendte til din kontos e-mail. Checkout forbliver låst til din adresse er bekræftet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestätigen Sie den Überprüfungs-Link, den wir an Ihre Konto-E-Mail gesendet haben. Checkout bleibt gesperrt, bis Ihre Adresse überprüft ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιβεβαιώστε τον σύνδεσμο επιβεβαίωσης που στείλαμε στο email του λογαριασμού σας. Η αγορά παραμένει κλειδωμένη έως ότου η διεύθυνση σας επιβεβαιωθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirm the verification link we sent to your account email. Checkout stays locked until your address is verified."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirma el enlace de verificación que enviamos a tu email de cuenta. La compra permanece bloqueada hasta que se verifique tu dirección."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vahvista vahvistusenlinkki, jonka lähetimme tilin sähköpostiin. Kassa pysyy lukituna kunnes osoitteesi on vahvistettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirmez le lien de vérification que nous avons envoyé à votre adresse e-mail de compte. L'achat reste verrouillé jusqu'à ce que votre adresse soit vérifiée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אשר את קישור האימות ששלחנו לדוא״ל החשבון שלך. תשלום נשאר נעול עד לאימות הכתובת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हमें आपके खाते के ईमेल को भेजे गए सत्यापन लिंक की पुष्टि करें। आपके पते के सत्यापित होने तक चेकआउट बंद रहता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erősítse meg az ellenőrzési linket, amelyet a fiók e-mail-jére küldtünk. A pénztár zárolva marad az e-mail-cím ellenőrzéséig."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfirmasi tautan verifikasi yang kami kirim ke email akun Anda. Pembayaran tetap terkunci sampai alamat Anda terverifikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conferma il link di verifica che abbiamo inviato al tuo indirizzo email dell'account. Il pagamento rimane bloccato fino a quando il tuo indirizzo non è verificato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントメールに送信した確認リンクを確認してください。メールアドレスが確認されるまでチェックアウトはロックされたままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정 이메일로 보낸 확인 링크를 확인하세요. 주소가 확인될 때까지 결제가 잠깁니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sahkan pautan pengesahan yang kami hantar ke e-mel akaun anda. Checkout tetap terkunci hingga alamat anda disahkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekreft bekreftelselenken vi sendte til kontoe-posten din. Kjøpsprosessen forblir låst til adressen din er bekreftet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevestig de verificatielink die wij naar je accounte-mail hebben verzonden. Checkout blijft vergrendeld totdat je adres is geverifieerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potwierdź link weryfikacyjny, który wysłaliśmy na e-mail Twojego konta. Kasa zostaje zablokowana do czasu zweryfikowania adresu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirme o link de verificação que enviamos para o email da sua conta. O checkout permanece bloqueado até seu endereço ser verificado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirme a ligação de verificação que enviámos para o seu email de conta. O pagamento permanece bloqueado até o seu endereço estar verificado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirmați linkul de verificare pe care l-am trimis la e-mailul contului. Plata rămâne blocată până la verificarea adresei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подтвердите ссылку проверки, которую мы отправили на адрес электронной почты вашей учётной записи. Оплата остаётся заблокированной, пока ваш адрес не будет подтвержден."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potvrďte overovací odkaz, ktorý sme poslali na vašu e-mailovú adresu účtu. Nákup zostáva uzamknutý, kým sa vaša adresa neoverí."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekräfta verifieringslänken som vi skickade till din kontoe-post. Kassan förblir låst tills din adress är verifierad."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยืนยันลิงก์การยืนยันที่เราส่งไปยังอีเมลบัญชีของคุณ Checkout จะล็อกไว้จนกว่าที่อยู่ของคุณจะได้รับการยืนยัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesap e-postanıza gönderdiğimiz doğrulama bağlantısını doğrulayın. Adresiniz doğrulanana kadar ödeme işlemi kilitli kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підтвердьте посилання для перевірки, яке ми надіслали на адресу електронної пошти вашого облікового запису. Оплата залишається заблокованою, поки ваша адреса не буде перевірена."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xác nhận liên kết xác minh chúng tôi gửi tới email tài khoản của bạn. Thanh toán vẫn bị khóa cho đến khi địa chỉ của bạn được xác minh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确认我们发送到您账户电子邮件的验证链接。在您的地址被验证之前，结账将保持锁定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認我們傳送到您帳戶電子郵件的驗證連結。結帳保持鎖定，直到您的地址經過驗證。"
          }
        }
      }
    },
