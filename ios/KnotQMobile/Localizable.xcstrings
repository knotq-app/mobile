    "web.delete_account.grace_period_p1_a" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحذف ليس فوريًا. عند طلب الحذف، يتم جدولة حسابك للإزالة الدائمة بعد"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smazání není okamžité. Když si vyžádáte smazání, váš účet bude naplánován na trvalé odstranění po"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sletning sker ikke øjeblikkeligt. Når du anmoder om sletning, er din konto planlagt til permanent fjernelse efter"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Löschung ist nicht sofort. Wenn Sie die Löschung beantragen, wird Ihr Konto nach einer"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η διαγραφή δεν είναι άμεση. Όταν ζητάτε διαγραφή, ο λογαριασμός σας προγραμματίζεται για μόνιμη κατάργηση μετά από"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletion is not immediate. When you request deletion, your account is scheduled for permanent removal after a"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La eliminación no es inmediata. Cuando solicites eliminación, tu cuenta se programa para eliminación permanente después de"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistaminen ei ole välitöntä. Kun pyydät poistamista, tilisi on aikataulutettu poistettavaksi pysyvästi"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression n'est pas immédiate. Lorsque vous demandez une suppression, votre compte est prévu pour une suppression permanente après une"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המחיקה אינה מיידית. כאשר תבקש מחיקה, החשבון שלך מתוזמן להסרה קבועה לאחר"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हटाना तत्काल नहीं है। जब आप हटाने का अनुरोध करते हैं, तो आपका खाता एक के बाद स्थायी हटाने के लिए निर्धारित होता है"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A törlés nem azonnali. Törlés kérelmezésekor az Ön fiókja egy után a végleges eltávolításra van ütemezve"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penghapusan tidak langsung. Ketika Anda meminta penghapusan, akun Anda dijadwalkan untuk dihapus secara permanen setelah"
          }
        },
        "it" : {
          "stringUnit" : {
