    "web.delete_account.contact_fallback_a" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كنت لم تعد تستطيع تسجيل الدخول، أو تفضل أن نتولى الأمر، فأرسل بريد إلكتروني إلى"
