    "web.guide.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ تطبيق إنتاجية مجاني يدمج الملاحظات مع التقويم للتنظيم بشكل عام. مساحات العمل محلية أولاً وتملكها أنت، مع مزامنة حساب اختيارية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ je bezplatná aplikace pro zvýšení produktivity, která integruje poznámky s kalendářem pro obecné účely organizace. Pracovní prostory jsou místně první a patří vám, s volitelnou synchronizací účtu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ er en gratis produktivitetsapp, der integrerer noter med en kalender til generel organisering. Arbejdsområder er lokalt først og ejet af dig, med valgfri kontossynkronisering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ ist eine kostenlose Produktivitäts-App, die Notizen mit einem Kalender für die allgemeine Nutzungsorganisation integriert. Workspaces sind lokal-first und gehören Ihnen, mit optionaler Kontosynchronisierung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το KnotQ είναι μια δωρεάν εφαρμογή παραγωγικότητας που ενσωματώνει σημειώσεις με ένα ημερολόγιο για οργάνωση γενικού σκοπού. Οι χώροι εργασίας είναι τοπικοί πρώτοι και ιδιοκτησίας σας, με προαιρετικό συγχρονισμό λογαριασμού."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ is a free productivity app that integrates notes with a calendar for general purpose organization. Workspaces are local-first and owned by you, with optional account sync."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ es una aplicación de productividad gratuita que integra notas con un calendario para la organización de propósito general. Los espacios de trabajo son locales por defecto y son de tu propiedad, con sincronización de cuenta opcional."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ on ilmainen tuottavuussovellus, joka yhdistää muistiinpanot kalenteriin yleiskäyttöiseen organisointiin. Työtilat ovat paikallisia ensimmäisenä ja omistettuja sinulla, valinnaisen tilinnsynkronoinnin kanssa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ est une application de productivité gratuite qui intègre des notes avec un calendrier pour l'organisation d'usage général. Les espaces de travail sont d'abord locaux et vous en êtes propriétaire, avec synchronisation facultative du compte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ היא אפליקציית פרודוקטיביות חינמית המשלבת הערות עם לוח שנה לארגון כללי. מרחבי עבודה הם מקומיים קדם ובבעלותך, עם סנכרון חשבון אופציונלי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ एक मुफ्त उत्पादकता ऐप है जो सामान्य उद्देश्य संगठन के लिए नोट्स को कैलेंडर के साथ एकीकृत करता है। वर्कस्पेस स्थानीय-प्रथम हैं और आपके द्वारा स्वामित्व में हैं, वैकल्पिक खाता सिंक के साथ।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A KnotQ egy ingyenes termelékenységi alkalmazás, amely jegyzeteket integrál egy naptárral az általános szervezéshez. A munkaterületek helyi-elsők és az Ön tulajdona, opcionális fiókok szinkronizálásával."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ adalah aplikasi produktivitas gratis yang mengintegrasikan catatan dengan kalender untuk organisasi tujuan umum. Ruang kerja adalah lokal-dulu dan dimiliki oleh Anda, dengan sinkronisasi akun opsional."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ è un'app di produttività gratuita che integra le note con un calendario per l'organizzazione generale. I workspace sono local-first e di tua proprietà, con sincronizzazione facoltativa dell'account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQは、メモとカレンダーを統合した無料の生産性アプリで、一般的な目的の組織化に使用されます。ワークスペースはローカルファーストで、あなたが所有しており、オプションのアカウント同期があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ는 일반적인 조직을 위해 노트와 캘린더를 통합하는 무료 생산성 앱입니다. 워크스페이스는 로컬 우선이며 사용자가 소유하며 선택적 계정 동기화가 가능합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ adalah aplikasi produktivitas gratis yang mengintegrasikan catatan dengan kalender untuk organisasi tujuan umum. Ruang kerja adalah lokal-pertama dan dimiliki oleh Anda, dengan sinkronisasi akun opsional."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ er en gratis produktivitetsapp som integrerer notater med en kalender for generell organisering. Arbeitsflater er lokale først og eiet av deg, med valgfri kontosynkronisering."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ is een gratis productiviteitsapp die notities met een agenda integreert voor algemene organisatie. Werkruimten zijn eerst lokaal en eigendom van jou, met optionele accountsynchronisatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ to bezpłatna aplikacja produktywności, która integruje notatki z kalendarzem do ogólnego organizowania. Obszary robocze są zunifikowane lokalnie i należą do Ciebie, z opcjonalną synchronizacją konta."
