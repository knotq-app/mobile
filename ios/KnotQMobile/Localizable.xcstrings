        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ é um aplicativo de produtividade gratuito que integra notas com um calendário para organização geral. Workspaces são locais primeiro e são de sua propriedade, com sincronização de conta opcional."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O KnotQ é uma aplicação de produtividade gratuita que integra notas com um calendário para organização de uso geral. As áreas de trabalho são locais em primeiro lugar e propriedade sua, com sincronização de conta opcional."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ este o aplicație de productivitate gratuită care integrează notele cu un calendar pentru organizare cu scop general. Spațiile de lucru sunt locale în primul rând și deținute de dvs., cu sincronizare contului opțională."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ — это бесплатное приложение для повышения производительности, которое объединяет заметки с календарём для общей организации. Рабочие пространства локальны и принадлежат вам, с опциональной синхронизацией учётной записи."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ je bezplatná aplikácia na zvýšenie produktivity, ktorá integruje poznámky s kalendárom na všeobecnú organizáciu. Pracovné priestory sú miestne a vlastnené vami, s voliteľnou synchronizáciou konta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ är en gratis produktivitetsapp som integrerar anteckningar med en kalender för allmän organisering. Arbetsutrymmen är lokala och ägs av dig, med valfri kontosynkronisering."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ เป็นแอปผลิตภาพที่ฟรีซึ่งรวมหมายเหตุเข้ากับปฏิทินสำหรับการจัดระเบียบวัตถุประสงค์ทั่วไป พื้นที่ทำงานจะเป็นเครื่องหมายแรกท้องถิ่นและเป็นของคุณ โดยมีการซิงค์บัญชีทางเลือก"
