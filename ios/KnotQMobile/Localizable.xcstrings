    "onboarding.step.welcome.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ هو تطبيق واحد للأحداث والتذكيرات والمهام والملاحظات العامة. يهدف إلى أن يكون بسيطاً وعملياً."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ je jedinou aplikací pro kalendář, připomenutí, úkoly a obecné poznámky. Cílem je být jednoduchý a přitom funkční."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ er en enkelt app til kalenderbegivenheder, påmindelser, opgaver og generelle noter. Det sigter mod at være simpelt, men funktionelt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ ist eine einzige App für Kalenderereignisse, Benachrichtigungen, Aufgaben und allgemeine Notizen. Sie soll einfach aber funktional sein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το KnotQ είναι μια μόνη εφαρμογή για συμβάντα ημερολογίου, υπενθυμίσεις, εργασίες και γενικές σημειώσεις. Στόχος του είναι να είναι απλό αλλά λειτουργικό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ is a single app for calendar events, reminders, assignments, and general notes. It aims to be simple yet functional."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ es una sola aplicación para eventos de calendario, recordatorios, tareas y notas generales. Tiene como objetivo ser simple pero funcional."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ on yksi sovellus kalenteritapahtumille, muistutuksille, tehtäville ja yleisille muistiinpanoille. Se pyrkii olemaan yksinkertainen mutta toiminnallinen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ est une application unique pour les événements de calendrier, les rappels, les affectations et les notes générales. Elle vise à être simple mais fonctionnelle."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ היא אפליקציה יחידה עבור אירועי לוח שנה, תזכורות, יעדים והערות כלליות. היא מטרתה להיות פשוטה אך תפקודית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ कैलेंडर घटनाओं, अनुस्मारकों, कार्यों, और सामान्य नोट्स के लिए एक एकल ऐप है। यह सरल लेकिन कार्यात्मक होने का लक्ष्य रखता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A KnotQ egyetlen alkalmazás a naptáreseményekhez, emlékeztetőkhöz, hozzárendelésekhez és általános jegyzetekhez. Célja az egyszerűség és a funkcionalitás."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ adalah satu aplikasi untuk acara kalender, pengingat, tugas, dan catatan umum. Tujuannya adalah sederhana namun fungsional."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ è un'unica app per eventi del calendario, promemoria, incarichi e note generali. Mira a essere semplice ma funzionale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ はカレンダーイベント、リマインダー、アサイン、一般メモのための単一アプリです。シンプルながら機能的なことを目指しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ는 캘린더 이벤트, 리마인더, 할당 및 일반 메모를 위한 단일 앱입니다. 단순하면서도 기능적이기를 목표로 합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ adalah aplikasi tunggal untuk acara kalendar, peringatan, tugasan, dan nota umum. Ia bertujuan untuk menjadi mudah namun berfungsi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ er en enkel app for kalenderbegivenheter, remindere, oppgaver og generelle notater. Den har som mål å være enkel men funksjonell."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ is één app voor agendagebeurttenissen, herinneringen, taken en algemene aantekeningen. Het streeft ernaar eenvoudig maar functioneel te zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ to pojedyncza aplikacja dla zdarzeń kalendarza, przypomnień, zadań i ogólnych notatek. Ma być prosta, ale funkcjonalna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ é um único aplicativo para eventos de calendário, lembretes, tarefas e anotações gerais. Tem como objetivo ser simples mas funcional."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ é uma única aplicação para eventos de calendário, lembretes, tarefas e notas gerais. Tem como objetivo ser simples mas funcional."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ este o aplicație unică pentru evenimente de calendar, reamintiri, atribuții și note generale. Scopul ei este să fie simplă, dar funcțională."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ — это единое приложение для событий календаря, напоминаний, заданий и общих заметок. Он стремится быть простым, но функциональным."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ je jednotná aplikácia pre podujatia kalendára, pripomenutia, úlohy a všeobecné poznámky. Má byť jednoduchá a funkčná."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ är en enda app för kalenderevent, påminnelser, uppdrag och allmänna anteckningar. Det syftar till att vara enkelt men funktionellt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ เป็นแอปเดียวสำหรับเหตุการณ์ปฏิทิน การแจ้งเตือน งานมอบหมาย และบันทึกทั่วไป มีเป้าหมายให้เรียบง่ายแต่ใช้งานได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ, takvim etkinlikleri, anımsatıcılar, görevler ve genel notlar için tek bir uygulamadır. Basit ama işlevsel olmayı hedefler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ — це один додаток для подій календара, нагадування, завдань і загальних нотаток. Його метою є бути простим, але функціональним."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ là một ứng dụng duy nhất cho các sự kiện lịch, nhắc nhở, bài tập và ghi chú chung. Nó nhằm đơn giản nhưng chức năng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ 是一个日历事件、提醒、任务和常规笔记的单一应用。它旨在简单而实用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnotQ 是一個單一應用程式，可用於日曆事件、提醒、代辦事項和常規筆記。它旨在簡潔但功能豐富。"
          }
        }
      }
    },
