    "web.home.download.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مجاني على سطح المكتب والجوال — حافظ على مساحة عملك متطابقة مع المزامنة الاختيارية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdarma na počítači a mobilním zařízení — udržujte svůj pracovní prostor v souladu s volitelnou synchronizací."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis på skrivebord og mobil — hold dit arbejdsområde i takt med valgfri synkronisering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kostenlos auf Desktop und Mobilgerät — halten Sie Ihren Workspace mit optionaler Synchronisierung in Schritt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δωρεάν σε επιτραπέζιο υπολογιστή και κινητό — κρατήστε τον χώρο εργασίας σας ενημερωμένο με προαιρετικό συγχρονισμό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free on desktop and mobile — keep your workspace in step with optional sync."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis en desktop y móvil — mantén tu espacio de trabajo sincronizado con sincronización opcional."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmainen pöytäkoneessa ja mobiilissa — pidä työtilasi vaiheissa valinnaisen synkronoinnin kanssa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratuit sur le bureau et mobile — gardez votre espace de travail en phase avec la synchronisation optionnelle."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חינמי על שולחן עבודה וסלולר — שמור את מרחב העבודה שלך בתאימות עם סנכרון אופציונלי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डेस्कटॉप और मोबाइल पर मुफ्त — अपने वर्कस्पेस को वैकल्पिक सिंक के साथ कदम में रखें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingyenes asztali és mobil gépen — tartsa szinkronban az Ön munkahelyét az opcionális szinkronizálással."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis di desktop dan seluler — jaga ruang kerja Anda tetap sinkron dengan sinkronisasi opsional."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratuito su desktop e mobile — mantieni il tuo workspace in step con la sincronizzazione facoltativa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デスクトップとモバイルで無料 — オプションの同期でワークスペースを同期状態に保ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데스크톱 및 모바일에서 무료 — 선택적 동기화로 워크스페이스를 동기 상태로 유지합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis di desktop dan seluler — simpan ruang kerja Anda selaras dengan sinkronisasi opsional."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis på stasjonær og mobil – hold arbeitsflaten din i takt med valgfri synkronisering."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis op desktop en mobiel — houd je werkruimte gesynchroniseerd met optionele synchronisatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezpłatnie na pulpicie i urządzeniach przenośnych — utrzymuj swój obszar roboczy w kroku dzięki opcjonalnej synchronizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratuito em desktop e dispositivo móvel — mantenha seu workspace em sincronização com sincronização opcional."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratuito em desktop e mobile — mantenha a sua área de trabalho em passo com sincronização opcional."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratuit pe desktop și mobile — mențineți-vă spațiul de lucru în pasul cu sincronizare opțională."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бесплатно на компьютере и мобильном устройстве — синхронизируйте рабочее пространство при необходимости."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezplatne na počítačoch a mobilných zariadeniach — držte si pracovný priestor aktuálny s voliteľnou synchronizáciou."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis på skrivbord och mobil — behåll ditt arbetsutrymme i steg med valfri synkronisering."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฟรีบนเดสก์ท็อปและอุปกรณ์เคลื่อนที่ — เก็บพื้นที่ทำงานของคุณให้ทันสมัยด้วยการซิงค์แบบทางเลือก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masaüstü ve mobilde ücretsiz — çalışma alanınızı isteğe bağlı senkronizasyon ile adımda tutun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Безплатно на настільних та мобільних пристроях — тримайте ваш робочий простір синхронізованим з необов'язковою синхронізацією."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miễn phí trên máy tính để bàn và thiết bị di động — giữ không gian làm việc của bạn được đồng bộ với tính năng đồng bộ tùy chọn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在桌面和移动设备上免费 — 通过可选同步使您的工作区保持同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在桌機和行動裝置上免費提供 — 通過可選的同步保持您的工作區同步。"
          }
        }
      }
    },
